/-- `|U|`-weighted local bound: `∫ |f 1_U|^r = ∑_{W ∈ ℱ'} ∫_W |f|^r ≤ C_up τ |U|`, where
`U = ⋃_{W ∈ ℱ'} W`. -/
theorem lintegral_rpow_indicator_union_le (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) {f : Rd d → B} {r : ℝ} (hr : 0 < r)
    {τ : ℝ≥0∞} (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ) :
    ∫⁻ x, ‖(⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f x‖ₑ ^ r ≤
      ENNReal.ofReal (upC d) * τ * volume (⋃ a ∈ F, (qcube a : Set (Rd d))) := by
  have hdisj : (F : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint fun a => (qcube a : Set (Rd d)) :=
    fun a ha b hb hab => hI.disjoint a (hFI a ha) b (hFI b hb) hab
  have hind : (fun x => ‖(⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f x‖ₑ ^ r) =
      (⋃ a ∈ F, (qcube a : Set (Rd d))).indicator fun x => ‖f x‖ₑ ^ r := by
    funext x
    by_cases hx : x ∈ ⋃ a ∈ F, (qcube a : Set (Rd d))
    · simp [indicator_of_mem hx]
    · simp [indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hr]
  rw [hind, lintegral_indicator (measurableSet_biUnion_qcube F),
    lintegral_biUnion_finset hdisj (fun a _ => Cube.measurableSet _),
    measure_biUnion_finset hdisj (fun a _ => Cube.measurableSet _), Finset.mul_sum]
  refine Finset.sum_le_sum fun a ha => ?_
  have h2 : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  have h := avgNorm_rpow_le_of_whitney hI hr hτ (hFI a ha) (qcube a) subset_rfl
    (by rw [qcube_side]; linarith)
  rw [avgNorm, ← ENNReal.rpow_mul, one_div_mul_cancel hr.ne', ENNReal.rpow_one] at h
  calc ∫⁻ x in (qcube a : Set (Rd d)), ‖f x‖ₑ ^ r
      = volume (qcube a : Set (Rd d)) * ((volume (qcube a : Set (Rd d)))⁻¹ *
          ∫⁻ x in (qcube a : Set (Rd d)), ‖f x‖ₑ ^ r) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel (Cube.volume_ne_zero _) (Cube.volume_ne_top _),
          one_mul]
    _ ≤ volume (qcube a : Set (Rd d)) * (ENNReal.ofReal (upC d) * τ) := by gcongr
    _ = _ := mul_comm _ _

