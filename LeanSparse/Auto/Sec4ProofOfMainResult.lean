/-! ### Facts about the operators `T_j` and their partial sums -/

section OperatorFacts

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}

/-- Partial sums over a finite set of scales. -/
noncomputable def psumOn (T : ℤ → Op d 𝕜 B₁ B₂) (J : Finset ℤ) (f : SimpleCpt d 𝕜 B₁) :
    Rd d → B₂ :=
  ∑ j ∈ J, T j f

theorem psumOn_aestronglyMeasurable (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (J : Finset ℤ)
    (f : SimpleCpt d 𝕜 B₁) : AEStronglyMeasurable (psumOn T J f) volume :=
  Finset.aestronglyMeasurable_sum J fun j _ => hT.aestronglyMeasurable j f

theorem eLpNorm_op_lt_top (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 0 < q)
    (j : ℤ) (f : SimpleCpt d 𝕜 B₁) : eLpNorm (T j f) (.ofReal q) volume < ∞ := by
  refine lt_of_le_of_lt (eLpNorm_op_le_of_singleScale hp hq (hT.aestronglyMeasurable j)
    (hT.singleScale j) f) ?_
  exact ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    (ENNReal.rpow_ne_top_of_ne_zero (scaleVol_ne_zero j) (scaleVol_ne_top j)).lt_top)
    (SimpleCpt.eLpNorm_lt_top f hp)

/-- The `L^p → L^q` bound for partial sums from the single scale bounds. -/
noncomputable def psumConst (d : ℕ) (p q A₀ : ℝ) (J : Finset ℤ) : ℝ≥0∞ :=
  ∑ j ∈ J, ENNReal.ofReal A₀ * scaleVol d j ^ (1 / q - 1 / p)

theorem psumConst_ne_top (p q A₀ : ℝ) (J : Finset ℤ) : psumConst d p q A₀ J ≠ ∞ :=
  ENNReal.sum_ne_top.2 fun j _ => ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.rpow_ne_top_of_ne_zero (scaleVol_ne_zero j) (scaleVol_ne_top j))

theorem eLpNorm_psumOn_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 ≤ q)
    (J : Finset ℤ) (f : SimpleCpt d 𝕜 B₁) :
    eLpNorm (psumOn T J f) (.ofReal q) volume ≤
      psumConst d p q A₀ J * eLpNorm f (.ofReal p) volume := by
  unfold psumOn psumConst
  rw [Finset.sum_mul]
  refine (eLpNorm_sum_le (by simp; linarith)).trans (Finset.sum_le_sum fun j _ => ?_)
  exact eLpNorm_op_le_of_singleScale hp (by linarith) (hT.aestronglyMeasurable j)
    (hT.singleScale j) f

theorem eLpNorm_psumOn_lt_top (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p)
    (hq : 1 ≤ q) (J : Finset ℤ) (f : SimpleCpt d 𝕜 B₁) :
    eLpNorm (psumOn T J f) (.ofReal q) volume < ∞ :=
  lt_of_le_of_lt (eLpNorm_psumOn_le hT hp hq J f)
    (ENNReal.mul_lt_top (psumConst_ne_top p q A₀ J).lt_top (SimpleCpt.eLpNorm_lt_top f hp))

/-- `T_j f = 0` a.e. outside `3Q` if `supp f ⊆ Q` and `2^j ≤ ℓ(Q)`. -/
theorem ae_op_eq_zero_outside_triple' (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) {j : ℤ}
    (Q : Cube d) (hQ : (2 : ℝ) ^ j ≤ Q.side) (f : SimpleCpt d 𝕜 B₁)
    (hf : Function.support ⇑f ⊆ Q) :
    ∀ᵐ y ∂volume, y ∉ (Q.triple : Set (Rd d)) → T j f y = 0 := by
  rcases (Function.support ⇑f).eq_empty_or_nonempty with he | hne
  · rw [SimpleCpt.eq_zero_of_support_empty f he, map_zero]
    exact Filter.Eventually.of_forall fun _ _ => rfl
  filter_upwards [ae_op_eq_zero_of_support (hT.support j) f, Q.triple_ae_eq_closedTriple] with y hy
    hyC hy3
  apply hy
  refine lt_of_le_of_lt hQ (Q.side_lt_infDist hf hne fun hyc => hy3 ?_)
  have : (y ∈ (Q.triple : Set (Rd d))) = (y ∈ Q.closedTriple) := hyC
  rw [this]
  exact hyc

/-- Partial sums of scales `≤ log₂ ℓ(Q)` applied to `f` supported in `Q` vanish a.e. outside
`3Q`. -/
theorem ae_psumOn_eq_zero_outside_triple (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc)
    {J : Finset ℤ} (Q : Cube d) (hQ : ∀ j ∈ J, (2 : ℝ) ^ j ≤ Q.side) (f : SimpleCpt d 𝕜 B₁)
    (hf : Function.support ⇑f ⊆ Q) :
    ∀ᵐ y ∂volume, y ∉ (Q.triple : Set (Rd d)) → psumOn T J f y = 0 := by
  have h : ∀ᵐ y ∂volume, ∀ j ∈ J, y ∉ (Q.triple : Set (Rd d)) → T j f y = 0 := by
    rw [Filter.eventually_all_finset]
    exact fun j hj => ae_op_eq_zero_outside_triple' hT Q (hQ j hj) f hf
  filter_upwards [h] with y hy hy3
  simp only [psumOn, Finset.sum_apply]
  exact Finset.sum_eq_zero fun j hj => hy j hj hy3

/-- Pairings of `T_j f` with functions supported far from `supp f` vanish. -/
theorem pairing_op_eq_zero_of_far (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (j : ℤ)
    {f : SimpleCpt d 𝕜 B₁} {g : Rd d → StrongDual 𝕜 B₂} {S S' : Set (Rd d)}
    (hf : Function.support ⇑f ⊆ S) (hg : Function.support g ⊆ S')
    (hfar : ∀ x ∈ S', (2 : ℝ) ^ j < Metric.infDist x S) : pairing (T j f) g = 0 := by
  rcases (Function.support ⇑f).eq_empty_or_nonempty with he | hne
  · rw [SimpleCpt.eq_zero_of_support_empty f he, map_zero]
    simp [pairing]
  unfold pairing
  rw [← integral_zero (Rd d) 𝕜]
  refine integral_congr_ae ?_
  filter_upwards [ae_op_eq_zero_of_support (hT.support j) f] with x hx
  by_cases hxS' : x ∈ S'
  · have h1 : Metric.infDist x S ≤ Metric.infDist x (Function.support ⇑f) :=
      Metric.infDist_le_infDist_of_subset hf hne
    rw [hx (lt_of_lt_of_le (hfar x hxS') h1), map_zero]
  · have : g x = 0 := Function.notMem_support.1 fun h => hxS' (hg h)
    rw [this]
    rfl

theorem psum_eq_psumOn (T : ℤ → Op d 𝕜 B₁ B₂) (N₁ N₂ : ℤ) (f : SimpleCpt d 𝕜 B₁) :
    psum T N₁ N₂ f = psumOn T (Finset.Icc N₁ N₂) f := rfl

theorem Icc_filter_le_eq (N₁ N₂ L : ℤ) :
    (Finset.Icc N₁ N₂).filter (· ≤ L) = Finset.Icc N₁ (min N₂ L) := by
  ext j
  simp only [Finset.mem_filter, Finset.mem_Icc, le_min_iff]
  tauto

end OperatorFacts

/-! ### §4.4: the terms controlled by the weak type and restricted strong type bounds:
(good-fct), (IIest), `III₁`, `III₂` -/

section TermsA

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}

/-- **(good-fct)**: `|⟨S g₁, f₂⟩| ≤ A(q) ‖g₁‖_{q,1} ‖f₂‖_{q'}`. -/
theorem good_term_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hq : 1 < q) {N₁ N₂ : ℤ}
    (hN : N₁ ≤ N₂) (g : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    ‖pairing (psum T N₁ N₂ g) f₂‖ₑ ≤
      ENNReal.ofReal Aq * lorentzOneNorm g q * eLpNorm f₂ (.ofReal q.conjExponent) volume := by
  refine (enorm_pairing_le (Finset.aestronglyMeasurable_sum _ fun j _ =>
    hT.aestronglyMeasurable j g) (SimpleCpt.aestronglyMeasurable f₂) hq).trans ?_
  gcongr
  exact hT.restrictedStrongType N₁ N₂ hN g

/-- **(IIest)**, one Whitney cube: if `|u| ≤ m 1_W` with `ℓ(W) = 2^L`, then
`|⟨S_W u, f₂⟩| ≤ A(q) ‖u‖_{q,1} ‖f₂ 1_{3W}‖_{q'}` for `S_W = ∑_{j ∈ [N₁, N₂], j ≤ L} T_j`. -/
theorem II_term_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hq : 1 < q) {N₁ N₂ : ℤ}
    (a : ℤ × (Fin d → ℤ)) (u : SimpleCpt d 𝕜 B₁)
    (hu : Function.support ⇑u ⊆ (qcube a : Set (Rd d)))
    (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    ‖pairing (psumOn T ((Finset.Icc N₁ N₂).filter (· ≤ a.1)) u) f₂‖ₑ ≤
      ENNReal.ofReal Aq * lorentzOneNorm u q *
        eLpNorm (((qcube a).triple : Set (Rd d)).indicator f₂) (.ofReal q.conjExponent) volume := by
  set J := (Finset.Icc N₁ N₂).filter (· ≤ a.1) with hJ
  have hsupp := ae_psumOn_eq_zero_outside_triple hT (J := J) (qcube a) (fun j hj => by
    rw [qcube_side]
    exact zpow_le_zpow_right₀ (by norm_num) (Finset.mem_filter.1 hj).2) u hu
  rw [pairing_eq_pairing_indicator hsupp]
  refine (enorm_pairing_le (psumOn_aestronglyMeasurable hT J u)
    ((SimpleCpt.aestronglyMeasurable f₂).indicator (Cube.measurableSet _)) hq).trans ?_
  gcongr
  rcases le_or_gt N₁ (min N₂ a.1) with h | h
  · rw [hJ, Icc_filter_le_eq]
    exact hT.restrictedStrongType N₁ (min N₂ a.1) h u
  · have : J = ∅ := by rw [hJ, Icc_filter_le_eq]; exact Finset.Icc_eq_empty_of_lt h
    rw [this]
    simp [psumOn]

/-- **`III₁`**: if `|g| ≤ m 1_E` then `|⟨S b, g⟩| ≤ m p' A(p) ‖b‖_p |E|^{1-1/p}`. -/
theorem III1_term_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) {N₁ N₂ : ℤ}
    (hN : N₁ ≤ N₂) (b : SimpleCpt d 𝕜 B₁) {g : Rd d → StrongDual 𝕜 B₂} {E : Set (Rd d)}
    (hE : MeasurableSet E) (hEfin : volume E ≠ ∞) {m : ℝ}
    (hg : ∀ x, ‖g x‖ ≤ E.indicator (fun _ => m) x) :
    ‖pairing (psum T N₁ N₂ b) g‖ₑ ≤ ENNReal.ofReal m * (ENNReal.ofReal (p / (p - 1)) *
      (ENNReal.ofReal Ap * eLpNorm b (.ofReal p) volume) * volume E ^ (1 - 1 / p)) := by
  refine (enorm_pairing_le_weakNorm (Finset.aestronglyMeasurable_sum _ fun j _ =>
    hT.aestronglyMeasurable j b) hE hEfin hg hp).trans ?_
  gcongr
  exact hT.weakType N₁ N₂ hN b

/-- **`III₂`**, one Whitney cube: if `|g| ≤ m` and `b` is supported in `W`, then
`|⟨S_W b, g⟩| ≤ m p' A(p) ‖b‖_p |3W|^{1-1/p}`. -/
theorem III2_term_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) {N₁ N₂ : ℤ}
    (a : ℤ × (Fin d → ℤ)) (b : SimpleCpt d 𝕜 B₁)
    (hb : Function.support ⇑b ⊆ (qcube a : Set (Rd d))) {g : Rd d → StrongDual 𝕜 B₂}
    (_hgm : AEStronglyMeasurable g volume) {m : ℝ} (_hm : 0 ≤ m) (hg : ∀ x, ‖g x‖ ≤ m) :
    ‖pairing (psumOn T ((Finset.Icc N₁ N₂).filter (· ≤ a.1)) b) g‖ₑ ≤
      ENNReal.ofReal m * (ENNReal.ofReal (p / (p - 1)) *
        (ENNReal.ofReal Ap * eLpNorm b (.ofReal p) volume) *
          volume ((qcube a).triple : Set (Rd d)) ^ (1 - 1 / p)) := by
  set J := (Finset.Icc N₁ N₂).filter (· ≤ a.1) with hJ
  have hsupp := ae_psumOn_eq_zero_outside_triple hT (J := J) (qcube a) (fun j hj => by
    rw [qcube_side]
    exact zpow_le_zpow_right₀ (by norm_num) (Finset.mem_filter.1 hj).2) b hb
  rw [pairing_eq_pairing_indicator hsupp]
  have hg' : ∀ x, ‖((qcube a).triple : Set (Rd d)).indicator g x‖ ≤
      ((qcube a).triple : Set (Rd d)).indicator (fun _ => m) x := by
    intro x
    by_cases hx : x ∈ ((qcube a).triple : Set (Rd d))
    · rw [indicator_of_mem hx, indicator_of_mem hx]; exact hg x
    · rw [indicator_of_notMem hx, indicator_of_notMem hx, norm_zero]
  refine (enorm_pairing_le_weakNorm (psumOn_aestronglyMeasurable hT J b)
    (Cube.measurableSet _) (Cube.volume_ne_top _) hg' hp).trans ?_
  gcongr
  rcases le_or_gt N₁ (min N₂ a.1) with h | h
  · rw [hJ, Icc_filter_le_eq]
    exact hT.weakType N₁ (min N₂ a.1) h b
  · have : J = ∅ := by rw [hJ, Icc_filter_le_eq]; exact Finset.Icc_eq_empty_of_lt h
    rw [this]
    simp only [psumOn, Finset.sum_empty]
    have : weakNorm (0 : Rd d → B₂) p = 0 := by
      simp only [weakNorm, Pi.zero_apply, norm_zero]
      refine ENNReal.iSup_eq_zero.2 fun t => ?_
      have : {x : Rd d | (t : ℝ) < 0} = ∅ := by
        ext x; simp only [mem_ofPred_eq, mem_empty_iff_false, iff_false, not_lt]
        exact t.2
      rw [this, measure_empty, ENNReal.zero_rpow_of_pos (by positivity), mul_zero]
    rw [this]
    exact zero_le

end TermsA

/-! ### §4.4: (restriction on j) -/

section Restriction

variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- **(restriction on j)**: if `L(W) < j ≤ L(W')` and some point of `W'` lies within `2^j` of
`W`, then `L(W') = j = L(W) + 1`. (With `δ = √d + 1`, `a = 5` this improves the source's
`L(W') ≤ L(W) + 2`.) -/
theorem restriction_on_j (hI : IsWhitneyIndex Ω I) {a a' : ℤ × (Fin d → ℤ)} (ha : a ∈ I)
    (ha' : a' ∈ I) {j : ℤ} (hj1 : a.1 < j) (hj2 : j ≤ a'.1)
    (hnear : ∃ x ∈ (qcube a' : Set (Rd d)), Metric.infDist x (qcube a) ≤ (2 : ℝ) ^ j) :
    a'.1 = j ∧ a.1 + 1 = j := by
  obtain ⟨x, hxa', hx⟩ := hnear
  have hδ := one_le_wδ (d := d)
  have h2L : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  obtain ⟨y, hy, hxy⟩ := (Metric.infDist_lt_iff (qcube a).nonempty).1
    (show Metric.infDist x (qcube a) < (2 : ℝ) ^ j + wδ d * (2 : ℝ) ^ a.1 by
      have : 0 < wδ d * (2 : ℝ) ^ a.1 := by positivity
      linarith)
  obtain ⟨y₀, hy₀, z₀, hz₀, hyz₀⟩ := hI.dist_lt a ha
  have hyy₀ := dist_le_of_mem_qcube hy hy₀
  have hlow := hI.dist_ge a' ha' x hxa' z₀ hz₀
  have htri : dist x z₀ ≤ dist x y + dist y y₀ + dist y₀ z₀ := by
    have := dist_triangle x y z₀
    have := dist_triangle y y₀ z₀
    linarith
  have hjL' : (2 : ℝ) ^ j ≤ (2 : ℝ) ^ a'.1 := zpow_le_zpow_right₀ (by norm_num) hj2
  have hkey : 4 * (2 : ℝ) ^ a'.1 < 14 * (2 : ℝ) ^ a.1 := by
    have h1 : 5 * (wδ d * (2 : ℝ) ^ a'.1) < (2 : ℝ) ^ j + 14 * (wδ d * (2 : ℝ) ^ a.1) := by
      linarith [hlow, htri, hxy, hyy₀, hyz₀]
    have h2 : (2 : ℝ) ^ j ≤ wδ d * (2 : ℝ) ^ a'.1 :=
      le_trans hjL' (le_mul_of_one_le_left (by positivity) hδ)
    have h3 : 4 * (wδ d * (2 : ℝ) ^ a'.1) < 14 * (wδ d * (2 : ℝ) ^ a.1) := by linarith
    have hδ0 := wδ_pos (d := d)
    nlinarith
  have hle : a'.1 ≤ a.1 + 1 := by
    by_contra h
    push Not at h
    have : (2 : ℝ) ^ (a.1 + 2) ≤ (2 : ℝ) ^ a'.1 := zpow_le_zpow_right₀ (by norm_num) (by omega)
    rw [zpow_add₀ (by norm_num)] at this
    norm_num at this
    linarith
  omega

end Restriction

/-! ### §4.4: the term `III₃` -/

section TermIII3

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

omit [NormedSpace 𝕜 B₁] [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂] in
/-- Bookkeeping for `III₃`: the triple sum over `(j, W', W)` collapses to `j = L(W')`. -/
theorem triple_sum_le {ι : Type*} (J : Finset ℤ) (F : Finset ι) (L : ι → ℤ)
    (t : ℤ → ι → ι → ℝ≥0∞) (u : ι → ι → ℝ≥0∞)
    (ht : ∀ j ∈ J, ∀ a' ∈ F, ∀ a ∈ F, t j a' a ≤ if j = L a' then u a' a else 0) :
    ∑ j ∈ J, ∑ a' ∈ F, ∑ a ∈ F, t j a' a ≤ ∑ a' ∈ F, ∑ a ∈ F, u a' a := by
  classical
  calc ∑ j ∈ J, ∑ a' ∈ F, ∑ a ∈ F, t j a' a
      ≤ ∑ j ∈ J, ∑ a' ∈ F, ∑ a ∈ F, (if j = L a' then u a' a else 0) :=
        Finset.sum_le_sum fun j hj => Finset.sum_le_sum fun a' ha' =>
          Finset.sum_le_sum fun a ha => ht j hj a' ha' a ha
    _ = ∑ a' ∈ F, ∑ a ∈ F, ∑ j ∈ J, (if j = L a' then u a' a else 0) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun a' _ => ?_
        rw [Finset.sum_comm]
    _ ≤ ∑ a' ∈ F, ∑ a ∈ F, u a' a := by
        refine Finset.sum_le_sum fun a' _ => Finset.sum_le_sum fun a _ => ?_
        rw [Finset.sum_ite_eq']
        split_ifs <;> simp

omit [CompleteSpace B₁] in
/-- Single-cube bound `‖b_W‖_r ≤ 2 (C_up τ)^{1/r} |W|^{1/r}`. -/
theorem eLpNorm_czB_le (hI : IsWhitneyIndex Ω I) {a : ℤ × (Fin d → ℤ)} (ha : a ∈ I)
    (f : SimpleCpt d 𝕜 B₁) {r : ℝ} (hr : 1 ≤ r) {τ : ℝ≥0∞}
    (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ) :
    eLpNorm (czB f a) (.ofReal r) volume ≤
      2 * ((ENNReal.ofReal (upC d) * τ) ^ (1 / r) * volume (qcube a : Set (Rd d)) ^ (1 / r)) := by
  have h1 := eLpNorm_sum_czB_le hI (F := {a}) (by simpa using ha) f hr
  have h2 := eLpNorm_indicator_union_le hI (F := {a}) (by simpa using ha) f (by linarith) hτ
  simp only [Finset.sum_singleton, Finset.mem_singleton, iUnion_iUnion_eq_left] at h1 h2
  exact h1.trans (by gcongr)

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [NormedAddCommGroup B₂]
  [NormedSpace 𝕜 B₂] [CompleteSpace B₂] in
theorem scaleVol_succ (j : ℤ) : scaleVol d j = 2 ^ d * scaleVol d (j - 1) := by
  unfold scaleVol
  rw [show (2 : ℝ) ^ j = 2 * 2 ^ (j - 1) by
      rw [mul_comm, ← zpow_add_one₀ (two_ne_zero' ℝ), sub_add_cancel],
    mul_pow, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num)]
  simp

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [NormedAddCommGroup B₂]
  [NormedSpace 𝕜 B₂] [CompleteSpace B₂] in
/-- The volume arithmetic in `III₃`: `2^{-jd(1/p-1/q)} |W|^{1/p} |W'|^{1/q'} ≤ 2^d |W|` for
`|W| = 2^{(j-1)d}`, `|W'| = 2^{jd}`. -/
theorem scaleVol_III3_le {p q : ℝ} (hp : 1 ≤ p) (hq : 1 < q) (j : ℤ) :
    scaleVol d j ^ (1 / q - 1 / p) * scaleVol d (j - 1) ^ (1 / p) *
      scaleVol d j ^ (1 / q.conjExponent) ≤ 2 ^ d * scaleVol d (j - 1) := by
  have hpq := Real.HolderConjugate.conjExponent hq
  have hsum : 1 / q - 1 / p + 1 / q.conjExponent = 1 - 1 / p := by
    have := hpq.inv_add_inv_eq_one
    simp only [one_div] at this ⊢
    linarith
  have h1 : 0 ≤ 1 - 1 / p := by
    have : 1 / p ≤ 1 := by rw [div_le_one (by linarith)]; exact hp
    linarith
  calc scaleVol d j ^ (1 / q - 1 / p) * scaleVol d (j - 1) ^ (1 / p) *
        scaleVol d j ^ (1 / q.conjExponent)
      = scaleVol d j ^ (1 - 1 / p) * scaleVol d (j - 1) ^ (1 / p) := by
        rw [← hsum, ENNReal.rpow_add _ _ (scaleVol_ne_zero j) (scaleVol_ne_top j)]
        ring
    _ = (2 ^ d) ^ (1 - 1 / p) * scaleVol d (j - 1) := by
        rw [scaleVol_succ j, ENNReal.mul_rpow_of_nonneg _ _ h1, mul_assoc,
          ← ENNReal.rpow_add _ _ (scaleVol_ne_zero _) (scaleVol_ne_top _),
          show 1 - 1 / p + 1 / p = 1 by ring, ENNReal.rpow_one]
    _ ≤ 2 ^ d * scaleVol d (j - 1) := by
        gcongr
        calc ((2 : ℝ≥0∞) ^ d) ^ (1 - 1 / p) ≤ ((2 : ℝ≥0∞) ^ d) ^ (1 : ℝ) :=
              ENNReal.rpow_le_rpow_of_exponent_le (one_le_pow₀ (by norm_num))
                (by have h0 : 0 < p := by linarith
                    have : 0 < 1 / p := one_div_pos.2 h0
                    linarith)
          _ = 2 ^ d := ENNReal.rpow_one _

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- **`III₃`** (BRS, estimate after (restriction on j)): the sum over `j ∈ J`, `W, W' ∈ ℱ` with
`L(W) < j ≤ L(W')` of `|⟨T_j b_{1,W}, b_{2,W'}⟩|` is at most
`4 · 2^d (8δ)^d A∘ K₁ K₂ ∑_{W' ∈ ℱ} |W'|`. -/
theorem III3_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I)
    (J : Finset ℤ) (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂))
    {τ₁ τ₂ : ℝ≥0∞} (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ∑ j ∈ J, ∑ a' ∈ F, ∑ a ∈ F, (if a.1 < j ∧ j ≤ a'.1 then
        ‖pairing (T j (czB f₁ a)) (czB f₂ a')‖ₑ else 0) ≤
      4 * 2 ^ d * ENNReal.ofReal ((8 * wδ d) ^ d) * ENNReal.ofReal A₀ *
        (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) *
            ∑ a' ∈ F, volume (qcube a' : Set (Rd d)) := by
  classical
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  have hδ := one_le_wδ (d := d)
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) with hK₁
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) with hK₂
  set C₀ := 4 * ENNReal.ofReal A₀ * K₁ * K₂ * 2 ^ d with hC₀
  -- the centre point of `W'` and the neighbourhood condition
  let xc : ℤ × (Fin d → ℤ) → Rd d := fun a' => WithLp.toLp 2 (qcube a').corner
  let near : ℤ × (Fin d → ℤ) → ℤ × (Fin d → ℤ) → Prop := fun a' a =>
    a.1 + 1 = a'.1 ∧ (qcube a : Set (Rd d)) ⊆ Metric.ball (xc a') (4 * wδ d * (2 : ℝ) ^ a'.1)
  let u : ℤ × (Fin d → ℤ) → ℤ × (Fin d → ℤ) → ℝ≥0∞ := fun a' a =>
    if near a' a then C₀ * volume (qcube a : Set (Rd d)) else 0
  have hstep : ∀ j ∈ J, ∀ a' ∈ F, ∀ a ∈ F, (if a.1 < j ∧ j ≤ a'.1 then
      ‖pairing (T j (czB f₁ a)) (czB f₂ a')‖ₑ else 0) ≤ if j = a'.1 then u a' a else 0 := by
    intro j _ a' ha' a ha
    by_cases hc : a.1 < j ∧ j ≤ a'.1
    · rw [ite_eq_left hc]
      by_cases hfar : ∀ x ∈ (qcube a' : Set (Rd d)), (2 : ℝ) ^ j < Metric.infDist x (qcube a)
      · rw [pairing_op_eq_zero_of_far hT j (S := qcube a) (S' := qcube a')
          (by rw [show ⇑(czB f₁ a) = _ from funext (czB_apply f₁ a)];
              exact Set.support_indicator_subset)
          (by rw [show ⇑(czB f₂ a') = _ from funext (czB_apply f₂ a')];
              exact Set.support_indicator_subset) hfar, enorm_zero]
        exact zero_le
      push Not at hfar
      obtain ⟨hL', hL⟩ := restriction_on_j hI (hFI a ha) (hFI a' ha') hc.1 hc.2 hfar
      obtain ⟨x, hx, hxd⟩ := hfar
      rw [ite_eq_left hL'.symm]
      -- the neighbourhood condition holds
      have hnear : near a' a := by
        refine ⟨by omega, fun w hw => ?_⟩
        obtain ⟨y, hy, hxy⟩ := (Metric.infDist_lt_iff (qcube a).nonempty).1
          (show Metric.infDist x (qcube a) < (2 : ℝ) ^ j + wδ d * (2 : ℝ) ^ a.1 by
            have : 0 < wδ d * (2 : ℝ) ^ a.1 := by have := wδ_pos (d := d); positivity
            linarith)
        have h1 := dist_le_of_mem_qcube hw hy
        have h2 := dist_le_of_mem_qcube hx (qcube a').corner_mem
        change dist w (xc a') < 4 * wδ d * (2 : ℝ) ^ a'.1
        have hj : (2 : ℝ) ^ a.1 * 2 = (2 : ℝ) ^ a'.1 := by
          rw [← zpow_add_one₀ (two_ne_zero' ℝ), hL, hL']
        have h2a : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
        have hj' : (2 : ℝ) ^ j = (2 : ℝ) ^ a'.1 := by rw [hL']
        have h3 := dist_triangle w y x
        have h4 := dist_triangle w x (xc a')
        have h5 : dist y x = dist x y := dist_comm y x
        have h6 : (2 : ℝ) ^ a'.1 ≤ wδ d * (2 : ℝ) ^ a'.1 :=
          le_mul_of_one_le_left (by positivity) hδ
        have h7 : wδ d * (2 : ℝ) ^ a.1 * 2 = wδ d * (2 : ℝ) ^ a'.1 := by rw [mul_assoc, hj]
        have h8 : 0 < wδ d * (2 : ℝ) ^ a'.1 := by have := wδ_pos (d := d); positivity
        linarith
      change _ ≤ (if near a' a then C₀ * volume (qcube a : Set (Rd d)) else 0)
      rw [ite_eq_left hnear]
      -- the size of the term
      have hb₁ := eLpNorm_czB_le hI (hFI a ha) f₁ hp.le hτ₁
      have hb₂ := eLpNorm_czB_le hI (hFI a' ha') f₂ hpq'.symm.lt.le hτ₂
      have hTb := eLpNorm_op_le_of_singleScale (by linarith) (by linarith)
        (hT.aestronglyMeasurable j) (hT.singleScale j) (czB f₁ a)
      have hvol : volume (qcube a : Set (Rd d)) = scaleVol d (j - 1) :=
        Cube.volume_eq_scaleVol _ (by rw [qcube_side]; congr 1; omega)
      have hvol' : volume (qcube a' : Set (Rd d)) = scaleVol d j :=
        Cube.volume_eq_scaleVol _ (by rw [qcube_side, hL'])
      rw [hvol] at hb₁ ⊢
      rw [hvol'] at hb₂
      calc ‖pairing (T j (czB f₁ a)) (czB f₂ a')‖ₑ
          ≤ eLpNorm (T j (czB f₁ a)) (.ofReal q) volume *
              eLpNorm (czB f₂ a') (.ofReal q.conjExponent) volume :=
            enorm_pairing_le (hT.aestronglyMeasurable j _) (SimpleCpt.aestronglyMeasurable _) hq
        _ ≤ (ENNReal.ofReal A₀ * scaleVol d j ^ (1 / q - 1 / p) *
              (2 * (K₁ * scaleVol d (j - 1) ^ (1 / p)))) *
            (2 * (K₂ * scaleVol d j ^ (1 / q.conjExponent))) := by
            gcongr
            exact hTb.trans (by gcongr)
        _ = 4 * ENNReal.ofReal A₀ * K₁ * K₂ * (scaleVol d j ^ (1 / q - 1 / p) *
              scaleVol d (j - 1) ^ (1 / p) * scaleVol d j ^ (1 / q.conjExponent)) := by ring
        _ ≤ 4 * ENNReal.ofReal A₀ * K₁ * K₂ * (2 ^ d * scaleVol d (j - 1)) :=
            mul_le_mul_right (scaleVol_III3_le hp.le hq j) _
        _ = C₀ * scaleVol d (j - 1) := by rw [hC₀]; ring
    · rw [ite_eq_right hc]
      exact zero_le
  refine (triple_sum_le J F (fun a' => a'.1) _ u hstep).trans ?_
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun a' ha' => ?_
  -- the cubes near `W'` are disjoint and lie in a ball of volume `(8δ)^d |W'|`
  have hdisj : ((F.filter (near a')) : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint
      fun a => (qcube a : Set (Rd d)) := fun a ha b hb hab =>
    hI.disjoint a (hFI a (Finset.mem_filter.1 ha).1) b (hFI b (Finset.mem_filter.1 hb).1) hab
  calc ∑ a ∈ F, u a' a = C₀ * ∑ a ∈ F.filter (near a'), volume (qcube a : Set (Rd d)) := by
        rw [Finset.mul_sum, Finset.sum_filter]
    _ = C₀ * volume (⋃ a ∈ F.filter (near a'), (qcube a : Set (Rd d))) := by
        rw [measure_biUnion_finset hdisj (fun a _ => Cube.measurableSet _)]
    _ ≤ C₀ * volume (Metric.ball (xc a') (4 * wδ d * (2 : ℝ) ^ a'.1)) := by
        gcongr
        exact iUnion₂_subset fun a ha => (Finset.mem_filter.1 ha).2.2
    _ ≤ C₀ * ENNReal.ofReal ((2 * (4 * wδ d * (2 : ℝ) ^ a'.1)) ^ d) := by
        gcongr
        exact volume_ball_le _ (by have := wδ_pos (d := d); positivity)
    _ = _ := by
        rw [Cube.volume_eq, qcube_side, hC₀, show 2 * (4 * wδ d * (2 : ℝ) ^ a'.1) =
          (8 * wδ d) * (2 : ℝ) ^ a'.1 by ring, mul_pow, ENNReal.ofReal_mul (by
            have := wδ_pos (d := d); positivity)]
        ring

end TermIII3

/-! ### §4.4: tools for `III₄`: the bilinear forms, bounded overlap, a volume inequality -/

section IVTools

attribute [local instance] Classical.propDecidable

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}

theorem pairing_smul_left (F : Rd d → B₂) (c : 𝕜) (g : Rd d → StrongDual 𝕜 B₂) :
    pairing (c • F) g = c * pairing F g := by
  unfold pairing
  rw [← integral_const_mul]
  congr 1
  funext x
  simp

/-- The bilinear form `(u, v) ↦ ⟨T_j u, v⟩` on `𝒮_{B₁} × 𝒮_{B₂*}`. -/
noncomputable def pairingOp (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p)
    (hq : 1 < q) (j : ℤ) :
    SimpleCpt d 𝕜 B₁ →ₗ[𝕜] SimpleCpt d 𝕜 (StrongDual 𝕜 B₂) →ₗ[𝕜] 𝕜 :=
  LinearMap.mk₂ 𝕜 (fun u v => pairing (T j u) v)
    (fun u₁ u₂ v => by
      rw [map_add, pairing_add_left (hT.aestronglyMeasurable j u₁) (hT.aestronglyMeasurable j u₂)
        hq (eLpNorm_op_lt_top hT hp (by linarith) j u₁)
        (eLpNorm_op_lt_top hT hp (by linarith) j u₂)])
    (fun c u v => by
      rw [map_smul, pairing_smul_left, smul_eq_mul])
    (fun u v₁ v₂ => pairing_add (hT.aestronglyMeasurable j u) hq
      (eLpNorm_op_lt_top hT hp (by linarith) j u) v₁ v₂)
    (fun c u v => by
      rw [pairing_smul, smul_eq_mul])

theorem pairingOp_apply (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (j : ℤ) (u : SimpleCpt d 𝕜 B₁) (v : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairingOp hT hp hq j u v = pairing (T j u) v := rfl

/-- Bounded overlap: a point lies in at most `3^d` of the triples of the level `j` cubes. -/
theorem card_filter_mem_triple_le (j : ℤ) (S : Finset (Fin d → ℤ)) (x : Rd d) :
    (S.filter fun t => x ∈ (((protoGrid d).cube j t).triple : Set (Rd d))).card ≤ 3 ^ d := by
  classical
  set G := protoGrid d
  set E : Finset (Fin d → ℤ) := Fintype.piFinset fun _ => ({-1, 0, 1} : Finset ℤ)
  have hE : E.card = 3 ^ d := by simp [E, Fintype.card_piFinset]
  rw [← hE]
  refine Finset.card_le_card_of_injOn (fun t => t - G.idx j x) (fun t ht => ?_)
    (fun t _ t' _ h => by simpa using h)
  have hx := (Finset.mem_filter.1 ht).2
  simp only [E, Finset.mem_coe, Fintype.mem_piFinset, Finset.mem_insert,
    Finset.mem_singleton, Pi.sub_apply]
  intro i
  have hs := G.side_pos j
  have hxi := hx i
  have hidx := G.mem_cube_idx j x i
  simp only [Cube.triple, GridData.cube] at hxi hidx
  set t' := G.idx j x i
  have h1 : (t' : ℝ) < t i + 2 := by
    have : G.side j * (t' + G.o j i) < G.side j * (t i + G.o j i) + 2 * G.side j := by
      linarith [hidx.1, hxi.2]
    nlinarith
  have h2 : (t i : ℝ) - 2 < t' := by
    have : G.side j * (t i + G.o j i) - G.side j < G.side j * (t' + G.o j i) + G.side j := by
      linarith [hidx.2, hxi.1]
    nlinarith
  have h1' : t' < t i + 2 := by exact_mod_cast h1
  have h2' : t i - 2 < t' := by exact_mod_cast h2
  omega

/-- `∑_R |U ∩ 3R| ≤ 3^d |U|` over distinct level `j` cubes `R`. -/
theorem sum_volume_inter_triple_le (j : ℤ) (S : Finset (Fin d → ℤ)) {U : Set (Rd d)}
    (_hU : MeasurableSet U) :
    ∑ t ∈ S, volume (U ∩ ((protoGrid d).cube j t).triple) ≤ 3 ^ d * volume U := by
  classical
  have h : ∀ t ∈ S, volume (U ∩ ((protoGrid d).cube j t).triple) =
      ∫⁻ x in U, (((protoGrid d).cube j t).triple : Set (Rd d)).indicator 1 x := by
    intro t _
    rw [lintegral_indicator_one (Cube.measurableSet _),
      Measure.restrict_apply (Cube.measurableSet _), inter_comm]
  rw [Finset.sum_congr rfl h, ← lintegral_finsetSum _ fun t _ =>
    (measurable_one.indicator (Cube.measurableSet _))]
  calc ∫⁻ x in U, ∑ t ∈ S, (((protoGrid d).cube j t).triple : Set (Rd d)).indicator 1 x
      ≤ ∫⁻ _x in U, (3 ^ d : ℝ≥0∞) := by
        refine lintegral_mono fun x => ?_
        calc ∑ t ∈ S, (((protoGrid d).cube j t).triple : Set (Rd d)).indicator 1 x
            = ((S.filter fun t => x ∈ (((protoGrid d).cube j t).triple : Set (Rd d))).card :
                ℝ≥0∞) := by
              rw [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_filter]
              refine Finset.sum_congr rfl fun t _ => ?_
              by_cases hx : x ∈ (((protoGrid d).cube j t).triple : Set (Rd d))
              · simp [hx]
              · simp [hx]
          _ ≤ 3 ^ d := by exact_mod_cast card_filter_mem_triple_le j S x
    _ = 3 ^ d * volume U := by rw [setLIntegral_const]

/-- The volume inequality used in `IV₁, IV₂, IV₃`: for `α ≤ σ`, `β ≤ 3^d σ`,
`σ^{1/q-1/p} α^{1/p} β^{1/q'} ≤ (1 + 3^d)(α + β)`. -/
theorem scaleVol_holder_le {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q) (hq : 1 < q) {σ α β : ℝ≥0∞}
    (hσ0 : σ ≠ 0) (hσtop : σ ≠ ∞) (hα : α ≤ σ) (hβ : β ≤ 3 ^ d * σ) :
    σ ^ (1 / q - 1 / p) * α ^ (1 / p) * β ^ (1 / q.conjExponent) ≤ (1 + 3 ^ d) * (α + β) := by
  have hpq' := Real.HolderConjugate.conjExponent hq
  have hp0 : 0 < p := by linarith
  have hq'0 := hpq'.symm.pos
  have he : 0 ≤ 1 / p - 1 / q := by
    rw [sub_nonneg]; exact one_div_le_one_div_of_le hp0 hpq
  have he1 : 1 / p - 1 / q ≤ 1 := by
    have : 0 < 1 / q := by positivity
    have : 1 / p ≤ 1 := by rw [div_le_one hp0]; exact hp
    linarith
  set γ := α + β with hγ
  rcases eq_or_ne γ 0 with h0 | h0
  · have hα0 : α = 0 := by rw [hγ] at h0; exact (add_eq_zero.1 h0).1
    rw [hα0, ENNReal.zero_rpow_of_pos (by positivity)]
    simp
  have hγtop : γ ≠ ∞ := ENNReal.add_ne_top.2 ⟨ne_top_of_le_ne_top hσtop hα,
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (by simp) hσtop) hβ⟩
  have hsum : 1 / p + 1 / q.conjExponent = 1 + (1 / p - 1 / q) := by
    have := hpq'.inv_add_inv_eq_one
    simp only [one_div] at this ⊢
    linarith
  calc σ ^ (1 / q - 1 / p) * α ^ (1 / p) * β ^ (1 / q.conjExponent)
      ≤ σ ^ (1 / q - 1 / p) * γ ^ (1 / p) * γ ^ (1 / q.conjExponent) := by
        gcongr
        · exact le_self_add
        · exact le_add_self
    _ = σ ^ (1 / q - 1 / p) * (γ * γ ^ (1 / p - 1 / q)) := by
        rw [mul_assoc, ← ENNReal.rpow_add _ _ h0 hγtop, hsum,
          ENNReal.rpow_add _ _ h0 hγtop, ENNReal.rpow_one]
    _ ≤ σ ^ (1 / q - 1 / p) * (γ * ((1 + 3 ^ d) * σ) ^ (1 / p - 1 / q)) := by
        gcongr
        calc γ ≤ σ + 3 ^ d * σ := add_le_add hα hβ
          _ = (1 + 3 ^ d) * σ := by ring
    _ = γ * (1 + 3 ^ d) ^ (1 / p - 1 / q) * (σ ^ (1 / q - 1 / p) * σ ^ (1 / p - 1 / q)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ he]
        ring
    _ = γ * (1 + 3 ^ d) ^ (1 / p - 1 / q) := by
        rw [← ENNReal.rpow_add _ _ hσ0 hσtop, show 1 / q - 1 / p + (1 / p - 1 / q) = 0 by ring,
          ENNReal.rpow_zero, mul_one]
    _ ≤ γ * (1 + 3 ^ d) ^ (1 : ℝ) :=
        mul_le_mul_right (ENNReal.rpow_le_rpow_of_exponent_le le_self_add he1) _
    _ = (1 + 3 ^ d) * γ := by rw [ENNReal.rpow_one, mul_comm]

end IVTools

/-! ### §4.4: finite-sum bookkeeping for `III₄ = IV₁ + IV₂ + IV₃` -/

section IVBookkeeping

/-- The splitting of pairs of levels `(L, L')` in (eq:IVi def): both `≥ c` (`𝒱_{j,1}`, with
`c = j - ℓ`), or `L < c` and `L ≤ L'` (`𝒱_{j,2}`), or `L' < c` and `L' < L` (`𝒱_{j,3}`). -/
theorem triangular_sum {ι κ M : Type*} [AddCommMonoid M] (A : Finset ι) (A' : Finset κ)
    (L : ι → ℤ) (L' : κ → ℤ) (c : ℤ) (f : ι → κ → M) :
    ∑ i ∈ A, ∑ i' ∈ A', f i i' =
      ∑ i ∈ A.filter (fun i => c ≤ L i), ∑ i' ∈ A'.filter (fun i' => c ≤ L' i'), f i i' +
      ∑ i ∈ A.filter (fun i => L i < c), ∑ i' ∈ A'.filter (fun i' => L i ≤ L' i'), f i i' +
      ∑ i' ∈ A'.filter (fun i' => L' i' < c), ∑ i ∈ A.filter (fun i => L' i' < L i), f i i' := by
  classical
  rw [Finset.sum_comm' (t' := A)
    (s' := fun i => A'.filter (fun i' => L' i' < c ∧ L' i' < L i)) (f := fun i' i => f i i')
    (by intro i' i; simp only [Finset.mem_filter]; tauto)]
  rw [← Finset.sum_filter_add_sum_filter_not A (fun i => c ≤ L i) (fun i => ∑ i' ∈ A', f i i'),
    ← Finset.sum_filter_add_sum_filter_not A (fun i => c ≤ L i)
      (fun i => ∑ i' ∈ A'.filter (fun i' => L' i' < c ∧ L' i' < L i), f i i')]
  have e1 : A.filter (fun i => L i < c) = A.filter (fun i => ¬ c ≤ L i) := by
    congr 1; funext i; simp
  rw [e1]
  have hA : ∀ i ∈ A.filter (fun i => c ≤ L i), ∑ i' ∈ A', f i i' =
      ∑ i' ∈ A'.filter (fun i' => c ≤ L' i'), f i i' +
        ∑ i' ∈ A'.filter (fun i' => L' i' < c ∧ L' i' < L i), f i i' := by
    intro i hi
    have hci := (Finset.mem_filter.1 hi).2
    rw [← Finset.sum_filter_add_sum_filter_not A' (fun i' => c ≤ L' i')]
    congr 1
    congr 1
    ext i'
    simp only [Finset.mem_filter, not_le]
    constructor
    · rintro ⟨h, h'⟩; exact ⟨h, h', by omega⟩
    · rintro ⟨h, h', _⟩; exact ⟨h, h'⟩
  have hB : ∀ i ∈ A.filter (fun i => ¬ c ≤ L i), ∑ i' ∈ A', f i i' =
      ∑ i' ∈ A'.filter (fun i' => L i ≤ L' i'), f i i' +
        ∑ i' ∈ A'.filter (fun i' => L' i' < c ∧ L' i' < L i), f i i' := by
    intro i hi
    have hci := (Finset.mem_filter.1 hi).2
    rw [← Finset.sum_filter_add_sum_filter_not A' (fun i' => L i ≤ L' i')]
    congr 1
    congr 1
    ext i'
    simp only [Finset.mem_filter, not_le]
    constructor
    · rintro ⟨h, h'⟩; exact ⟨h, by omega, h'⟩
    · rintro ⟨h, _, h'⟩; exact ⟨h, h'⟩
  rw [Finset.sum_congr rfl hA, Finset.sum_congr rfl hB, Finset.sum_add_distrib,
    Finset.sum_add_distrib]
  abel

/-- Regrouping a sum over items of level `< c` by the depth `s = j - L ∈ S`. -/
theorem sum_filter_eq_sum_depth {ι M : Type*} [AddCommMonoid M] (A : Finset ι) (L : ι → ℤ)
    (j : ℤ) (P : ι → Prop) [DecidablePred P] (S : Finset ℕ)
    (hS : ∀ i ∈ A, P i → (j - L i).toNat ∈ S ∧ L i ≤ j) (g : ι → M) :
    ∑ i ∈ A.filter P, g i = ∑ s ∈ S, ∑ i ∈ A.filter (fun i => P i ∧ L i = j - s), g i := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (g := fun i => (j - L i).toNat)
    (t := S) (fun i hi => (hS i (Finset.mem_filter.1 hi).1 (Finset.mem_filter.1 hi).2).1)]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [Finset.filter_filter]
  congr 1
  ext i
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hi, hP, hs⟩
    have := (hS i hi hP).2
    refine ⟨hi, hP, ?_⟩
    omega
  · rintro ⟨hi, hP, hs⟩
    refine ⟨hi, hP, ?_⟩
    omega

/-- Counting: if every item is counted for at most `m` indices `j`, then
`∑_j ∑_{i : P j i} v i ≤ m ∑_i v i`. -/
theorem sum_sum_filter_le_mul {ι : Type*} (J : Finset ℤ) (A : Finset ι) (P : ℤ → ι → Prop)
    [∀ j, DecidablePred (P j)] (v : ι → ℝ≥0∞) (m : ℕ)
    (hm : ∀ i ∈ A, (J.filter fun j => P j i).card ≤ m) :
    ∑ j ∈ J, ∑ i ∈ A.filter (P j), v i ≤ m * ∑ i ∈ A, v i := by
  classical
  simp only [Finset.sum_filter]
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun i hi => ?_
  calc ∑ j ∈ J, (if P j i then v i else 0) = ((J.filter fun j => P j i).card : ℝ≥0∞) * v i := by
        rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    _ ≤ m * v i := by
        gcongr
        exact_mod_cast hm i hi

theorem card_filter_Ioc_le (J : Finset ℤ) (L : ℤ) (m : ℕ) :
    (J.filter fun j => L < j ∧ j ≤ L + m).card ≤ m := by
  classical
  calc (J.filter fun j => L < j ∧ j ≤ L + m).card ≤ (Finset.Ioc L (L + m)).card :=
        Finset.card_le_card fun j hj => by
          simp only [Finset.mem_filter] at hj
          simpa using hj.2
    _ = m := by simp

theorem card_filter_eq_le (J : Finset ℤ) (L : ℤ) (s : ℕ) :
    (J.filter fun j => L = j - s).card ≤ 1 := by
  classical
  refine Finset.card_le_one.2 fun j hj j' hj' => ?_
  simp only [Finset.mem_filter] at hj hj'
  omega

end IVBookkeeping

/-! ### §4.4: localization of `III₄` to the cubes `R ∈ ℜ_j` -/

section IVLocal

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- The index of the level `j` cube `R ∈ ℜ_j` containing the lattice cube `a`. -/
@[irreducible] noncomputable def tR (j : ℤ) (a : ℤ × (Fin d → ℤ)) : Fin d → ℤ :=
  (protoGrid d).idx j (WithLp.toLp 2 (qcube a).corner)

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem qcube_subset_tR {j : ℤ} {a : ℤ × (Fin d → ℤ)} (ha : a.1 ≤ j) :
    (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube j (tR j a) := by
  unfold tR
  exact ((protoGrid d).isDyadicSubcube_of_mem ha (qcube a).corner_mem).subset

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
/-- A lattice cube of level `≤ j` lies in `3R` or is disjoint from it, for `R` of level `j`. -/
theorem qcube_subset_or_disjoint_triple {j : ℤ} {a : ℤ × (Fin d → ℤ)} (ha : a.1 ≤ j)
    (t : Fin d → ℤ) :
    (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple ∨
      Disjoint (qcube a : Set (Rd d)) ((protoGrid d).cube j t).triple := by
  by_cases h : ((qcube a : Set (Rd d)) ∩ ((protoGrid d).cube j t).triple).Nonempty
  · left
    obtain ⟨x, hxa, hx3⟩ := h
    exact ((protoGrid d).isDyadicSubcube_of_mem ha hxa).subset.trans (cube_idx_subset_triple hx3)
  · right
    exact Set.disjoint_iff_inter_eq_empty.2 (Set.not_nonempty_iff_eq_empty.1 h)

omit [NormedSpace 𝕜 B₁] [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] in
theorem support_czB_subset {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜' B] [CompleteSpace B]
    (f : SimpleCpt d 𝕜' B) (a : ℤ × (Fin d → ℤ)) :
    Function.support ⇑(czB f a) ⊆ (qcube a : Set (Rd d)) := by
  rw [show ⇑(czB f a) = _ from funext (czB_apply f a)]
  exact Set.support_indicator_subset

/-- `L^r` bound for sums of bad pieces: `‖∑_{W ∈ ℱ'} b_W‖_r ≤ 2 (C_up τ)^{1/r} (∑ |W|)^{1/r}`. -/
theorem eLpNorm_sum_czB_le' {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜' B] [CompleteSpace B]
    (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I)
    (f : SimpleCpt d 𝕜' B) {r : ℝ} (hr : 1 ≤ r) {τ : ℝ≥0∞}
    (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ) :
    eLpNorm (⇑(∑ a ∈ F, czB f a)) (.ofReal r) volume ≤
      2 * ((ENNReal.ofReal (upC d) * τ) ^ (1 / r) *
        (∑ a ∈ F, volume (qcube a : Set (Rd d))) ^ (1 / r)) := by
  have hdisj : (F : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint fun a => (qcube a : Set (Rd d)) :=
    fun a ha b hb hab => hI.disjoint a (hFI a ha) b (hFI b hb) hab
  refine (eLpNorm_sum_czB_le hI hFI f hr).trans ?_
  gcongr
  refine (eLpNorm_indicator_union_le hI hFI f (by linarith) hτ).trans (le_of_eq ?_)
  rw [measure_biUnion_finset hdisj (fun a _ => Cube.measurableSet _)]

/-- `L^r` bound for sums of the pieces `f_W`. -/
theorem eLpNorm_sum_czF_le' {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜' B] [CompleteSpace B]
    (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I)
    (f : SimpleCpt d 𝕜' B) {r : ℝ} (hr : 1 ≤ r) {τ : ℝ≥0∞}
    (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ) :
    eLpNorm (⇑(∑ a ∈ F, czF f a)) (.ofReal r) volume ≤
      (ENNReal.ofReal (upC d) * τ) ^ (1 / r) *
        (∑ a ∈ F, volume (qcube a : Set (Rd d))) ^ (1 / r) := by
  have hdisj : (F : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint fun a => (qcube a : Set (Rd d)) :=
    fun a ha b hb hab => hI.disjoint a (hFI a ha) b (hFI b hb) hab
  have heq : ⇑(∑ a ∈ F, czF f a) = (⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f := by
    funext x
    rw [SimpleCpt.coe_sum', Finset.sum_apply]
    simp only [czF_apply]
    by_cases hxF : ∃ a ∈ F, x ∈ (qcube a : Set (Rd d))
    · obtain ⟨a, ha, hxa⟩ := hxF
      rw [sum_indicator_eq_of_mem hI hFI _ ha hxa, indicator_of_mem (mem_iUnion₂.2 ⟨a, ha, hxa⟩)]
    · push Not at hxF
      rw [sum_indicator_eq_zero _ hxF, indicator_of_notMem (fun h => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 h; exact hxF a ha hxa)]
  rw [heq]
  refine (eLpNorm_indicator_union_le hI hFI f (by linarith) hτ).trans (le_of_eq ?_)
  rw [measure_biUnion_finset hdisj (fun a _ => Cube.measurableSet _)]

/-- Two lattice indices of the same level are *neighbours* if they differ by at most `1` in
each coordinate (so that the cube of `u` lies in the triple of the cube of `t`). -/
def isNbr (u t : Fin d → ℤ) : Prop := ∀ i, |u i - t i| ≤ 1

instance (u t : Fin d → ℤ) : Decidable (isNbr u t) := by unfold isNbr; infer_instance

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem isNbr_idx_of_mem_triple {j : ℤ} {t : Fin d → ℤ} {x : Rd d}
    (hx : x ∈ (((protoGrid d).cube j t).triple : Set (Rd d))) :
    isNbr ((protoGrid d).idx j x) t := by
  set G := protoGrid d
  intro i
  have hs := G.side_pos j
  have hxi := hx i
  have hidx := G.mem_cube_idx j x i
  simp only [Cube.triple, GridData.cube] at hxi hidx
  set t' := G.idx j x i
  have h1 : (t' : ℝ) < t i + 2 := by
    have : G.side j * (t' + G.o j i) < G.side j * (t i + G.o j i) + 2 * G.side j := by
      linarith [hidx.1, hxi.2]
    nlinarith
  have h2 : (t i : ℝ) - 2 < t' := by
    have : G.side j * (t i + G.o j i) - G.side j < G.side j * (t' + G.o j i) + G.side j := by
      linarith [hidx.2, hxi.1]
    nlinarith
  have h1' : t' < t i + 2 := by exact_mod_cast h1
  have h2' : t i - 2 < t' := by exact_mod_cast h2
  rw [abs_le]
  constructor <;> omega

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem cube_subset_triple_of_isNbr {j : ℤ} {u t : Fin d → ℤ} (h : isNbr u t) :
    ((protoGrid d).cube j u : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple := by
  set G := protoGrid d
  intro y hy i
  have hs := G.side_pos j
  have hyi := hy i
  have hi := abs_le.1 (h i)
  simp only [Cube.triple, GridData.cube] at hyi ⊢
  have h1 : ((u i : ℤ) : ℝ) ≤ t i + 1 := by exact_mod_cast (by linarith [hi.2] : u i ≤ t i + 1)
  have h2 : ((t i : ℤ) : ℝ) - 1 ≤ u i := by exact_mod_cast (by linarith [hi.1] : t i - 1 ≤ u i)
  constructor <;> nlinarith [hyi.1, hyi.2]

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem qcube_subset_triple_of_isNbr {j : ℤ} {a : ℤ × (Fin d → ℤ)} (ha : a.1 ≤ j)
    {t : Fin d → ℤ} (h : isNbr (tR j a) t) :
    (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple :=
  (qcube_subset_tR ha).trans (cube_subset_triple_of_isNbr h)

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem disjoint_triple_of_not_isNbr {j : ℤ} {a : ℤ × (Fin d → ℤ)} (ha : a.1 ≤ j)
    {t : Fin d → ℤ} (h : ¬ isNbr (tR j a) t) :
    Disjoint (qcube a : Set (Rd d)) ((protoGrid d).cube j t).triple := by
  rw [Set.disjoint_left]
  intro x hxa hx3
  apply h
  have hx := qcube_subset_tR ha hxa
  rw [(protoGrid d).mem_cube_iff] at hx
  rw [hx]
  exact isNbr_idx_of_mem_triple hx3

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem card_filter_isNbr_le (S : Finset (Fin d → ℤ)) (u : Fin d → ℤ) :
    (S.filter fun t => isNbr u t).card ≤ 3 ^ d := by
  set E : Finset (Fin d → ℤ) := Fintype.piFinset fun _ => ({-1, 0, 1} : Finset ℤ)
  have hE : E.card = 3 ^ d := by simp [E, Fintype.card_piFinset]
  rw [← hE]
  refine Finset.card_le_card_of_injOn (fun t => t - u) (fun t ht => ?_)
    (fun t _ t' _ h => by simpa using h)
  have hn := (Finset.mem_filter.1 ht).2
  simp only [E, Finset.mem_coe, Fintype.mem_piFinset, Finset.mem_insert,
    Finset.mem_singleton, Pi.sub_apply]
  intro i
  have := abs_le.1 (hn i)
  omega

omit [CompleteSpace B₂] in
/-- **Localization** of `⟨T_j b₁^{<j}, b₂^{<j}⟩` to the cubes `R ∈ ℜ_j`: the pieces of `b₁` in
`R` pair only with the pieces of `b₂` in neighbouring cubes, i.e. in `3R`. -/
theorem pairing_localize (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (F : Finset (ℤ × (Fin d → ℤ))) (j : ℤ) (f₁ : SimpleCpt d 𝕜 B₁)
    (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a') =
      ∑ t ∈ (F.filter (fun a => a.1 < j)).image (tR j),
        pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j ∧ tR j a = t), czB f₁ a)
          (∑ a' ∈ F.filter (fun a' => a'.1 < j ∧ isNbr (tR j a') t), czB f₂ a') := by
  set RT := (F.filter (fun a => a.1 < j)).image (tR j)
  have hY1 : ∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a =
      ∑ t ∈ RT, ∑ a ∈ F.filter (fun a => a.1 < j ∧ tR j a = t), czB f₁ a := by
    rw [← Finset.sum_fiberwise_of_maps_to (g := tR j) (t := RT) (fun a ha =>
      Finset.mem_image_of_mem _ ha)]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [Finset.filter_filter]
  rw [hY1, LinearMap.map_sum₂]
  refine Finset.sum_congr rfl fun t _ => ?_
  set X₁ := ∑ a ∈ F.filter (fun a => a.1 < j ∧ tR j a = t), czB f₁ a
  set R := (protoGrid d).cube j t
  rw [← Finset.sum_filter_add_sum_filter_not (F.filter (fun a' => a'.1 < j))
    (fun a' => isNbr (tR j a') t), map_add, Finset.filter_filter]
  have hX₁ : Function.support ⇑X₁ ⊆ R := by
    intro x hx
    rw [Function.mem_support, SimpleCpt.coe_sum', Finset.sum_apply] at hx
    obtain ⟨a, ha, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
    have ha' := Finset.mem_filter.1 ha
    have hxa := support_czB_subset (B := B₁) f₁ a hne
    have := qcube_subset_tR (j := j) ha'.2.1.le hxa
    rw [ha'.2.2] at this
    exact this
  have hzero : pairingOp hT hp hq j X₁ (∑ a' ∈ (F.filter (fun a' => a'.1 < j)).filter
      (fun a' => ¬ isNbr (tR j a') t), czB f₂ a') = 0 := by
    rw [pairingOp_apply]
    have hsupp := ae_op_eq_zero_outside_triple' hT R (by
      rw [GridData.cube_side, protoGrid_side]) X₁ hX₁
    rw [pairing_eq_pairing_indicator hsupp]
    unfold pairing
    rw [← integral_zero (Rd d) 𝕜]
    congr 1
    funext x
    by_cases hx3 : x ∈ (R.triple : Set (Rd d))
    · rw [indicator_of_mem hx3, SimpleCpt.coe_sum', Finset.sum_apply,
        Finset.sum_eq_zero fun a' ha' => ?_]
      · simp
      · have ha'' := Finset.mem_filter.1 ha'
        have hlev := (Finset.mem_filter.1 ha''.1).2
        exact Function.notMem_support.1 fun hs => Set.disjoint_left.1
          (disjoint_triple_of_not_isNbr hlev.le ha''.2)
          (support_czB_subset (B := StrongDual 𝕜 B₂) f₂ a' hs) hx3
    · rw [indicator_of_notMem hx3]
      simp
  rw [hzero, add_zero]

/-- The sum of the bad pieces of one level `L` is `(I - 𝔼_L) ∑ f_W`. -/
theorem sum_czB_eq_sub_condExp {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜' B] [CompleteSpace B]
    (A : Finset (ℤ × (Fin d → ℤ))) (L : ℤ) (hA : ∀ a ∈ A, a.1 = L) (f : SimpleCpt d 𝕜' B) :
    ∑ a ∈ A, czB f a = ∑ a ∈ A, czF f a - condExp (protoGrid d) L (∑ a ∈ A, czF f a) := by
  rw [map_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun a ha => ?_
  rw [czB, hA a ha]

/-- The volume of a union of Whitney cubes inside a set `S`. -/
theorem sum_volume_le_of_subset (hI : IsWhitneyIndex Ω I) {A : Finset (ℤ × (Fin d → ℤ))}
    (hAI : ∀ a ∈ A, a ∈ I) {S : Set (Rd d)} (hAS : ∀ a ∈ A, (qcube a : Set (Rd d)) ⊆ S) :
    ∑ a ∈ A, volume (qcube a : Set (Rd d)) ≤ volume S := by
  have hdisj : (A : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint fun a => (qcube a : Set (Rd d)) :=
    fun a ha b hb hab => hI.disjoint a (hAI a ha) b (hAI b hb) hab
  rw [← measure_biUnion_finset hdisj (fun a _ => Cube.measurableSet _)]
  exact measure_mono (iUnion₂_subset hAS)

end IVLocal

/-! ### §4.4: the basic pair bounds for `IV₁, IV₂, IV₃` -/

section IVPairBounds

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

omit [CompleteSpace B₂] in
/-- **The pair bound for `IV₁`** (single scale): for pieces `b₁` in `R` and `b₂` in `3R`,
`|⟨T_j ∑ b_{1,W}, ∑ b_{2,W'}⟩| ≤ 4 A∘ K₁ K₂ (1 + 3^d)(∑|W| + ∑|W'|)`. -/
theorem pair_bound_single (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p)
    (hpq : p ≤ q) (hI : IsWhitneyIndex Ω I) (j : ℤ) (t : Fin d → ℤ)
    {A A' : Finset (ℤ × (Fin d → ℤ))} (hAI : ∀ a ∈ A, a ∈ I) (hA'I : ∀ a ∈ A', a ∈ I)
    (hAR : ∀ a ∈ A, (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube j t)
    (hA'R : ∀ a ∈ A', (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ ≤
      4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
          (∑ a ∈ A, volume (qcube a : Set (Rd d)) + ∑ a' ∈ A', volume (qcube a' : Set (Rd d))) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p)
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent)
  set α := ∑ a ∈ A, volume (qcube a : Set (Rd d))
  set β := ∑ a' ∈ A', volume (qcube a' : Set (Rd d))
  have hσR : volume ((protoGrid d).cube j t : Set (Rd d)) = scaleVol d j :=
    Cube.volume_eq_scaleVol _ (by rw [GridData.cube_side, protoGrid_side])
  have hα : α ≤ scaleVol d j := hσR ▸ sum_volume_le_of_subset hI hAI hAR
  have hβ : β ≤ 3 ^ d * scaleVol d j := by
    rw [← hσR, ← Cube.volume_triple]; exact sum_volume_le_of_subset hI hA'I hA'R
  have hU := eLpNorm_sum_czB_le' hI hAI f₁ hp.le hτ₁
  have hV := eLpNorm_sum_czB_le' hI hA'I f₂ hpq'.symm.lt.le hτ₂
  have hTU := eLpNorm_op_le_of_singleScale (by linarith) (by linarith) (hT.aestronglyMeasurable j)
    (hT.singleScale j) (∑ a ∈ A, czB f₁ a)
  calc ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ
      ≤ eLpNorm (T j (∑ a ∈ A, czB f₁ a)) (.ofReal q) volume *
          eLpNorm ⇑(∑ a' ∈ A', czB f₂ a') (.ofReal q.conjExponent) volume :=
        enorm_pairing_le (hT.aestronglyMeasurable j _) (SimpleCpt.aestronglyMeasurable _) hq
    _ ≤ (ENNReal.ofReal A₀ * scaleVol d j ^ (1 / q - 1 / p) * (2 * (K₁ * α ^ (1 / p)))) *
          (2 * (K₂ * β ^ (1 / q.conjExponent))) := by
        gcongr
        exact hTU.trans (by gcongr)
    _ = 4 * ENNReal.ofReal A₀ * K₁ * K₂ *
          (scaleVol d j ^ (1 / q - 1 / p) * α ^ (1 / p) * β ^ (1 / q.conjExponent)) := by ring
    _ ≤ 4 * ENNReal.ofReal A₀ * K₁ * K₂ * ((1 + 3 ^ d) * (α + β)) :=
        mul_le_mul_right (scaleVol_holder_le hp.le hpq hq (scaleVol_ne_zero j)
          (scaleVol_ne_top j) hα hβ) _
    _ = _ := by ring

omit [CompleteSpace B₂] in
/-- **The pair bound for `IV₂`** (regularity of `T_j`): for pieces `b₁` of level `j - s` in `R`
and `b₂` in `3R`, `|⟨T_j ∑ b_{1,W}, ∑ b_{2,W'}⟩| ≤ 2 κ_s K₁ K₂ (1 + 3^d)(∑|W| + ∑|W'|)` with
`κ_s = K(d,ε)(B + A∘) 2^{-εs}`. -/
theorem pair_bound_reg (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p)
    (hpq : p ≤ q) (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc) (hI : IsWhitneyIndex Ω I)
    (j : ℤ) (t : Fin d → ℤ) (s : ℕ)
    {A A' : Finset (ℤ × (Fin d → ℤ))} (hAI : ∀ a ∈ A, a ∈ I) (hA'I : ∀ a ∈ A', a ∈ I)
    (hAs : ∀ a ∈ A, a.1 = j - s)
    (hAR : ∀ a ∈ A, (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube j t)
    (hA'R : ∀ a ∈ A', (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ ≤
      2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
        (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
          (∑ a ∈ A, volume (qcube a : Set (Rd d)) + ∑ a' ∈ A', volume (qcube a' : Set (Rd d))) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p)
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent)
  set κ := ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s))
  set α := ∑ a ∈ A, volume (qcube a : Set (Rd d))
  set β := ∑ a' ∈ A', volume (qcube a' : Set (Rd d))
  have hσR : volume ((protoGrid d).cube j t : Set (Rd d)) = scaleVol d j :=
    Cube.volume_eq_scaleVol _ (by rw [GridData.cube_side, protoGrid_side])
  have hα : α ≤ scaleVol d j := hσR ▸ sum_volume_le_of_subset hI hAI hAR
  have hβ : β ≤ 3 ^ d * scaleVol d j := by
    rw [← hσR, ← Cube.volume_triple]; exact sum_volume_le_of_subset hI hA'I hA'R
  have hu := eLpNorm_sum_czF_le' hI hAI f₁ hp.le hτ₁
  have hV := eLpNorm_sum_czB_le' hI hA'I f₂ hpq'.symm.lt.le hτ₂
  have hTU := tjrega hp.le hq.le hε hA₀ hB (hT.aestronglyMeasurable j) (hT.singleScale j)
    (hT.regularity j) s (∑ a ∈ A, czF f₁ a)
  rw [← sum_czB_eq_sub_condExp A (j - s) hAs] at hTU
  calc ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ
      ≤ eLpNorm (T j (∑ a ∈ A, czB f₁ a)) (.ofReal q) volume *
          eLpNorm ⇑(∑ a' ∈ A', czB f₂ a') (.ofReal q.conjExponent) volume :=
        enorm_pairing_le (hT.aestronglyMeasurable j _) (SimpleCpt.aestronglyMeasurable _) hq
    _ ≤ (κ * scaleVol d j ^ (1 / q - 1 / p) * (K₁ * α ^ (1 / p))) *
          (2 * (K₂ * β ^ (1 / q.conjExponent))) := by
        gcongr
        exact hTU.trans (by gcongr)
    _ = 2 * κ * K₁ * K₂ *
          (scaleVol d j ^ (1 / q - 1 / p) * α ^ (1 / p) * β ^ (1 / q.conjExponent)) := by ring
    _ ≤ 2 * κ * K₁ * K₂ * ((1 + 3 ^ d) * (α + β)) :=
        mul_le_mul_right (scaleVol_holder_le hp.le hpq hq (scaleVol_ne_zero j)
          (scaleVol_ne_top j) hα hβ) _
    _ = _ := by ring

omit [CompleteSpace B₂] in
/-- **The pair bound for `IV₃`** (regularity of `T_j^*`): for pieces `b₁` in `R` and `b₂` of
level `j - s` in `3R`, `|⟨T_j ∑ b_{1,W}, ∑ b_{2,W'}⟩| ≤ 2 κ_s K₁ K₂ (1 + 3^d)(∑|W| + ∑|W'|)`. -/
theorem pair_bound_regdual (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p)
    (hpq : p ≤ q) (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc) (hI : IsWhitneyIndex Ω I)
    (j : ℤ) (t : Fin d → ℤ) (s : ℕ)
    {A A' : Finset (ℤ × (Fin d → ℤ))} (hAI : ∀ a ∈ A, a ∈ I) (hA'I : ∀ a ∈ A', a ∈ I)
    (hA's : ∀ a ∈ A', a.1 = j - s)
    (hAR : ∀ a ∈ A, (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube j t)
    (hA'R : ∀ a ∈ A', (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ ≤
      2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
        (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
          (∑ a ∈ A, volume (qcube a : Set (Rd d)) + ∑ a' ∈ A', volume (qcube a' : Set (Rd d))) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p)
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent)
  set κ := ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s))
  set α := ∑ a ∈ A, volume (qcube a : Set (Rd d))
  set β := ∑ a' ∈ A', volume (qcube a' : Set (Rd d))
  have hσR : volume ((protoGrid d).cube j t : Set (Rd d)) = scaleVol d j :=
    Cube.volume_eq_scaleVol _ (by rw [GridData.cube_side, protoGrid_side])
  have hα : α ≤ scaleVol d j := hσR ▸ sum_volume_le_of_subset hI hAI hAR
  have hβ : β ≤ 3 ^ d * scaleVol d j := by
    rw [← hσR, ← Cube.volume_triple]; exact sum_volume_le_of_subset hI hA'I hA'R
  have hU := eLpNorm_sum_czB_le' hI hAI f₁ hp.le hτ₁
  have hg := eLpNorm_sum_czF_le' hI hA'I f₂ hpq'.symm.lt.le hτ₂
  have hreg := tjregb hp.le hq hε hA₀ hB (hT.aestronglyMeasurable j) (hT.singleScale j)
    (hT.regularityDual j) (∑ a ∈ A, czB f₁ a) s (∑ a' ∈ A', czF f₂ a')
  rw [← sum_czB_eq_sub_condExp A' (j - s) hA's] at hreg
  calc ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ
      ≤ κ * (scaleVol d j ^ (1 / q - 1 / p) * (2 * (K₁ * α ^ (1 / p)))) *
          (K₂ * β ^ (1 / q.conjExponent)) := hreg.trans (by gcongr)
    _ = 2 * κ * K₁ * K₂ *
          (scaleVol d j ^ (1 / q - 1 / p) * α ^ (1 / p) * β ^ (1 / q.conjExponent)) := by ring
    _ ≤ 2 * κ * K₁ * K₂ * ((1 + 3 ^ d) * (α + β)) :=
        mul_le_mul_right (scaleVol_holder_le hp.le hpq hq (scaleVol_ne_zero j)
          (scaleVol_ne_top j) hα hβ) _
    _ = _ := by ring

end IVPairBounds

/-! ### §4.4: `III₄` on one cube `R ∈ ℜ_j`: the splitting (eq:IVi def) and the bounds -/

section IVCube

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- `∑_{W ∈ A, P(L(W))} |W|`. -/
noncomputable def lvol (A : Finset (ℤ × (Fin d → ℤ))) (P : ℤ → Prop) [DecidablePred P] :
    ℝ≥0∞ :=
  ∑ a ∈ A.filter (fun a => P a.1), volume (qcube a : Set (Rd d))

omit [CompleteSpace B₂] in
/-- **`III₄` on one cube**: `|⟨T_j ∑_{W ⊆ R} b_{1,W}, ∑_{W' ⊆ 3R} b_{2,W'}⟩|` is bounded by the
`IV₁` part (both levels `≥ j - ℓ`), the `IV₂` parts (level of `W` equal to `j - s`, `W'` finer
than `W`) and the `IV₃` parts (level of `W'` equal to `j - s`, `W` coarser). -/
theorem IV_cube_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc) (hI : IsWhitneyIndex Ω I) (j : ℤ)
    (t : Fin d → ℤ) (ℓ : ℕ) (S : Finset ℕ) {A A' : Finset (ℤ × (Fin d → ℤ))}
    (hAI : ∀ a ∈ A, a ∈ I) (hA'I : ∀ a ∈ A', a ∈ I)
    (hAR : ∀ a ∈ A, (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube j t)
    (hA'R : ∀ a ∈ A', (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube j t).triple)
    (hSA : ∀ a ∈ A, a.1 < j - ℓ → (j - a.1).toNat ∈ S ∧ a.1 ≤ j)
    (hSA' : ∀ a ∈ A', a.1 < j - ℓ → (j - a.1).toNat ∈ S ∧ a.1 ≤ j)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ‖pairing (T j (∑ a ∈ A, czB f₁ a)) ⇑(∑ a' ∈ A', czB f₂ a')‖ₑ ≤
      4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol A (fun L => j - ℓ ≤ L) + lvol A' (fun L => j - ℓ ≤ L)) +
      ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
          (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol A (fun L => L < j - ℓ ∧ L = j - s) + lvol A' (fun L => j - s ≤ L)) +
      ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
          (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol A (fun L => j - s < L) + lvol A' (fun L => L < j - ℓ ∧ L = j - s)) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  set β := pairingOp hT (by linarith) hq j
  set c : ℤ := j - ℓ
  have hβ : ∀ (X : SimpleCpt d 𝕜 B₁) (Y : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)),
      pairing (T j X) ⇑Y = β X Y := fun X Y => rfl
  -- expansion into pairs and the three groups
  have hexp : β (∑ a ∈ A, czB f₁ a) (∑ a' ∈ A', czB f₂ a') =
      ∑ a ∈ A, ∑ a' ∈ A', β (czB f₁ a) (czB f₂ a') := by
    rw [LinearMap.map_sum₂]
    exact Finset.sum_congr rfl fun a _ => map_sum _ _ _
  have hsplit := triangular_sum A A' (fun a => a.1) (fun a' => a'.1) c
    (fun a a' => β (czB f₁ a) (czB f₂ a'))
  -- group 1
  have hG1 : ∑ a ∈ A.filter (fun a => c ≤ a.1), ∑ a' ∈ A'.filter (fun a' => c ≤ a'.1),
      β (czB f₁ a) (czB f₂ a') = β (∑ a ∈ A.filter (fun a => c ≤ a.1), czB f₁ a)
        (∑ a' ∈ A'.filter (fun a' => c ≤ a'.1), czB f₂ a') := by
    rw [LinearMap.map_sum₂]
    exact Finset.sum_congr rfl fun a _ => (map_sum _ _ _).symm
  -- group 2, regrouped by depth
  have hG2 : ∑ a ∈ A.filter (fun a => a.1 < c), ∑ a' ∈ A'.filter (fun a' => a.1 ≤ a'.1),
      β (czB f₁ a) (czB f₂ a') = ∑ s ∈ S,
        β (∑ a ∈ A.filter (fun a => a.1 < c ∧ a.1 = j - s), czB f₁ a)
          (∑ a' ∈ A'.filter (fun a' => j - s ≤ a'.1), czB f₂ a') := by
    rw [sum_filter_eq_sum_depth A (fun a => a.1) j (fun a => a.1 < c) S
      (fun a ha h => hSA a ha h)]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [LinearMap.map_sum₂]
    refine Finset.sum_congr rfl fun a ha => ?_
    have hlev := (Finset.mem_filter.1 ha).2.2
    rw [map_sum]
    congr 1
    ext a'
    simp only [Finset.mem_filter, hlev]
  -- group 3, regrouped by depth
  have hG3 : ∑ a' ∈ A'.filter (fun a' => a'.1 < c), ∑ a ∈ A.filter (fun a => a'.1 < a.1),
      β (czB f₁ a) (czB f₂ a') = ∑ s ∈ S,
        β (∑ a ∈ A.filter (fun a => j - s < a.1), czB f₁ a)
          (∑ a' ∈ A'.filter (fun a' => a'.1 < c ∧ a'.1 = j - s), czB f₂ a') := by
    rw [sum_filter_eq_sum_depth A' (fun a => a.1) j (fun a => a.1 < c) S
      (fun a ha h => hSA' a ha h)]
    refine Finset.sum_congr rfl fun s _ => ?_
    calc ∑ a' ∈ A'.filter (fun a' => a'.1 < c ∧ a'.1 = j - s),
          ∑ a ∈ A.filter (fun a => a'.1 < a.1), β (czB f₁ a) (czB f₂ a')
        = ∑ a' ∈ A'.filter (fun a' => a'.1 < c ∧ a'.1 = j - s),
            β (∑ a ∈ A.filter (fun a => j - s < a.1), czB f₁ a) (czB f₂ a') := by
          refine Finset.sum_congr rfl fun a' ha' => ?_
          have hlev := (Finset.mem_filter.1 ha').2.2
          rw [LinearMap.map_sum₂]
          congr 1
          ext a
          simp only [Finset.mem_filter, hlev]
      _ = _ := (map_sum _ _ _).symm
  rw [hβ, hexp, hsplit, hG1, hG2, hG3]
  refine (enorm_add_le _ _).trans (add_le_add ((enorm_add_le _ _).trans (add_le_add ?_ ?_)) ?_)
  · -- `IV₁`
    exact pair_bound_single hT hp hpq hI j t (A := A.filter (fun a => c ≤ a.1))
      (A' := A'.filter (fun a' => c ≤ a'.1)) (fun a ha => hAI a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'I a (Finset.mem_filter.1 ha).1)
      (fun a ha => hAR a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'R a (Finset.mem_filter.1 ha).1) f₁ f₂ hτ₁ hτ₂
  · -- `IV₂`
    refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun s _ => ?_)
    exact pair_bound_reg hT hp hpq hε hA₀ hB hI j t s
      (A := A.filter (fun a => a.1 < c ∧ a.1 = j - s))
      (A' := A'.filter (fun a' => j - s ≤ a'.1))
      (fun a ha => hAI a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'I a (Finset.mem_filter.1 ha).1)
      (fun a ha => (Finset.mem_filter.1 ha).2.2)
      (fun a ha => hAR a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'R a (Finset.mem_filter.1 ha).1) f₁ f₂ hτ₁ hτ₂
  · -- `IV₃`
    refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun s _ => ?_)
    exact pair_bound_regdual hT hp hpq hε hA₀ hB hI j t s
      (A := A.filter (fun a => j - s < a.1))
      (A' := A'.filter (fun a' => a'.1 < c ∧ a'.1 = j - s))
      (fun a ha => hAI a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'I a (Finset.mem_filter.1 ha).1)
      (fun a ha => (Finset.mem_filter.1 ha).2.2)
      (fun a ha => hAR a (Finset.mem_filter.1 ha).1)
      (fun a ha => hA'R a (Finset.mem_filter.1 ha).1) f₁ f₂ hτ₁ hτ₂

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
/-- Summing the cube bounds over `R ∈ ℜ_j`: pure rearrangement. -/
theorem sum_bound_rearrange {τ : Type*} (RT : Finset τ) (S : Finset ℕ) (X : τ → ℝ≥0∞)
    (C₁ : ℝ≥0∞) (C₂ : ℕ → ℝ≥0∞) (a b : τ → ℝ≥0∞) (c e g h : τ → ℕ → ℝ≥0∞)
    (hX : ∀ t ∈ RT, X t ≤ C₁ * (a t + b t) + ∑ s ∈ S, C₂ s * (c t s + e t s) +
      ∑ s ∈ S, C₂ s * (g t s + h t s)) :
    ∑ t ∈ RT, X t ≤ C₁ * (∑ t ∈ RT, a t + ∑ t ∈ RT, b t) +
      ∑ s ∈ S, C₂ s * (∑ t ∈ RT, c t s + ∑ t ∈ RT, e t s) +
      ∑ s ∈ S, C₂ s * (∑ t ∈ RT, g t s + ∑ t ∈ RT, h t s) := by
  refine (Finset.sum_le_sum hX).trans (le_of_eq ?_)
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, mul_add]
  rw [Finset.sum_comm (s := RT) (t := S) (f := fun t s => C₂ s * c t s),
    Finset.sum_comm (s := RT) (t := S) (f := fun t s => C₂ s * e t s),
    Finset.sum_comm (s := RT) (t := S) (f := fun t s => C₂ s * g t s),
    Finset.sum_comm (s := RT) (t := S) (f := fun t s => C₂ s * h t s)]
  simp only [← Finset.mul_sum]

end IVCube

/-! ### §4.4: `III₄(j)` for one scale `j` -/

section IVScale

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- The `b₁` volumes over the cubes `R ∈ ℜ_j` add up exactly. -/
theorem sum_lvol_fiber (F : Finset (ℤ × (Fin d → ℤ))) (j : ℤ) (P : ℤ → Prop)
    [DecidablePred P] :
    ∑ t ∈ (F.filter (fun a => a.1 < j)).image (tR j),
        lvol (F.filter (fun a => a.1 < j ∧ tR j a = t)) P =
      lvol (F.filter (fun a => a.1 < j)) P := by
  unfold lvol
  rw [Finset.sum_image' (fun a => if P a.1 then volume (qcube a : Set (Rd d)) else 0)
    (fun c _ => ?_), ← Finset.sum_filter]
  rw [← Finset.sum_filter]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext a
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨⟨ha, hj, ht⟩, hP⟩
    exact ⟨⟨⟨ha, hj⟩, ht⟩, hP⟩
  · rintro ⟨⟨⟨ha, hj⟩, ht⟩, hP⟩
    exact ⟨⟨ha, hj, ht⟩, hP⟩

/-- The `b₂` volumes over the cubes `R ∈ ℜ_j` add up with multiplicity at most `3^d`. -/
theorem sum_lvol_nbr_le (F : Finset (ℤ × (Fin d → ℤ))) (j : ℤ) (P : ℤ → Prop)
    [DecidablePred P] :
    ∑ t ∈ (F.filter (fun a => a.1 < j)).image (tR j),
        lvol (F.filter (fun a => a.1 < j ∧ isNbr (tR j a) t)) P ≤
      3 ^ d * lvol (F.filter (fun a => a.1 < j)) P := by
  set RT := (F.filter (fun a => a.1 < j)).image (tR j)
  unfold lvol
  have h1 : ∀ t, ∑ a ∈ (F.filter (fun a => a.1 < j ∧ isNbr (tR j a) t)).filter
      (fun a => P a.1), volume (qcube a : Set (Rd d)) =
      ∑ a ∈ (F.filter (fun a => a.1 < j)).filter (fun a => P a.1),
        if isNbr (tR j a) t then volume (qcube a : Set (Rd d)) else 0 := by
    intro t
    rw [← Finset.sum_filter]
    congr 1
    ext a
    simp only [Finset.mem_filter]
    tauto
  simp_rw [h1]
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun a _ => ?_
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  gcongr
  exact_mod_cast card_filter_isNbr_le RT (tR j a)

omit [CompleteSpace B₂] in
/-- **`III₄(j)`** for one scale: the sum over `R ∈ ℜ_j` of the cube bounds, with the volumes
collected over all Whitney cubes of level `< j`. -/
theorem III4_scale_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc) (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (j : ℤ) (ℓ : ℕ) (S : Finset ℕ)
    (hS : ∀ a ∈ F, a.1 < j - ℓ → (j - a.1).toNat ∈ S)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ‖pairingOp hT (by linarith) (lt_of_lt_of_le hp hpq) j
        (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a')‖ₑ ≤
      4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L) +
              3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L)) +
      ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
          (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol (F.filter (fun a => a.1 < j)) (fun L => L < j - ℓ ∧ L = j - s) +
              3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => j - s ≤ L)) +
      ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
          (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            (lvol (F.filter (fun a => a.1 < j)) (fun L => j - s < L) +
              3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => L < j - ℓ ∧ L = j - s)) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  rw [pairing_localize hT (by linarith) hq F j f₁ f₂]
  set RT := (F.filter (fun a => a.1 < j)).image (tR j)
  refine (enorm_sum_le _ _).trans ?_
  refine (sum_bound_rearrange RT S _
    (4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
      (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d))
    (fun s : ℕ => 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
      (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
      (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d))
    (fun t => lvol (F.filter (fun a => a.1 < j ∧ tR j a = t)) (fun L => j - ℓ ≤ L))
    (fun t => lvol (F.filter (fun a => a.1 < j ∧ isNbr (tR j a) t)) (fun L => j - ℓ ≤ L))
    (fun t s => lvol (F.filter (fun a => a.1 < j ∧ tR j a = t))
      (fun L => L < j - ℓ ∧ L = j - s))
    (fun t s => lvol (F.filter (fun a => a.1 < j ∧ isNbr (tR j a) t)) (fun L => j - s ≤ L))
    (fun t s => lvol (F.filter (fun a => a.1 < j ∧ tR j a = t)) (fun L => j - s < L))
    (fun t s => lvol (F.filter (fun a => a.1 < j ∧ isNbr (tR j a) t))
      (fun L => L < j - ℓ ∧ L = j - s)) fun t _ => ?_).trans ?_
  · refine IV_cube_le hT hp hpq hε hA₀ hB hI j t ℓ S
      (fun a ha => hFI a (Finset.mem_filter.1 ha).1)
      (fun a ha => hFI a (Finset.mem_filter.1 ha).1)
      (fun a ha => by
        have h := (Finset.mem_filter.1 ha).2
        have := qcube_subset_tR (j := j) h.1.le
        rw [h.2] at this
        exact this)
      (fun a ha => qcube_subset_triple_of_isNbr (Finset.mem_filter.1 ha).2.1.le
        (Finset.mem_filter.1 ha).2.2)
      (fun a ha h => ⟨hS a (Finset.mem_filter.1 ha).1 h, (Finset.mem_filter.1 ha).2.1.le⟩)
      (fun a ha h => ⟨hS a (Finset.mem_filter.1 ha).1 h, (Finset.mem_filter.1 ha).2.1.le⟩)
      f₁ f₂ hτ₁ hτ₂
  · gcongr
    · exact le_of_eq (sum_lvol_fiber F j _)
    · exact sum_lvol_nbr_le F j _
    · exact le_of_eq (sum_lvol_fiber F j _)
    · exact sum_lvol_nbr_le F j _
    · exact le_of_eq (sum_lvol_fiber F j _)
    · exact sum_lvol_nbr_le F j _

/-- Counting for the `j`-sums: `∑_j lvol(ℱ_{<j}, P_j) ≤ m ∑_{W ∈ ℱ} |W|` if each level is
counted for at most `m` scales `j`. -/
theorem sum_lvol_le_mul (F : Finset (ℤ × (Fin d → ℤ))) (J : Finset ℤ) (P : ℤ → ℤ → Prop)
    [∀ j, DecidablePred (P j)] (m : ℕ)
    (hm : ∀ L : ℤ, (J.filter fun j => L < j ∧ P j L).card ≤ m) :
    ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (P j) ≤
      m * ∑ a ∈ F, volume (qcube a : Set (Rd d)) := by
  unfold lvol
  simp_rw [Finset.filter_filter]
  exact sum_sum_filter_le_mul J F (fun j a => a.1 < j ∧ P j a.1) _ m fun a _ => hm a.1

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
/-- Rearranging the sum over `j` of the scale bounds. -/
theorem sum_scale_rearrange (J : Finset ℤ) (S : Finset ℕ) (C₁ : ℝ≥0∞) (C₂ : ℕ → ℝ≥0∞)
    (x : ℤ → ℝ≥0∞) (y z u w : ℤ → ℕ → ℝ≥0∞) :
    ∑ j ∈ J, (C₁ * (x j + 3 ^ d * x j) + ∑ s ∈ S, C₂ s * (y j s + 3 ^ d * z j s) +
        ∑ s ∈ S, C₂ s * (u j s + 3 ^ d * w j s)) =
      C₁ * ((1 + 3 ^ d) * ∑ j ∈ J, x j) + ∑ s ∈ S, C₂ s * (∑ j ∈ J, y j s +
        3 ^ d * ∑ j ∈ J, z j s + (∑ j ∈ J, u j s + 3 ^ d * ∑ j ∈ J, w j s)) := by
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  have h1 : ∑ j ∈ J, C₁ * (x j + 3 ^ d * x j) = C₁ * ((1 + 3 ^ d) * ∑ j ∈ J, x j) := by
    rw [show C₁ * ((1 + 3 ^ d) * ∑ j ∈ J, x j) = ∑ j ∈ J, C₁ * ((1 + 3 ^ d) * x j) by
      rw [Finset.mul_sum, Finset.mul_sum]]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  have h2 : ∀ v₁ v₂ : ℤ → ℕ → ℝ≥0∞, ∑ j ∈ J, ∑ s ∈ S, C₂ s * (v₁ j s + 3 ^ d * v₂ j s) =
      ∑ s ∈ S, C₂ s * (∑ j ∈ J, v₁ j s + 3 ^ d * ∑ j ∈ J, v₂ j s) := by
    intro v₁ v₂
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum]
  rw [h1, h2 y z, h2 u w, add_assoc, ← Finset.sum_add_distrib]
  congr 1
  refine Finset.sum_congr rfl fun s _ => ?_
  ring

omit [CompleteSpace B₂] in
/-- **`III₄`** summed over the scales `j ∈ J`. -/
theorem III4_total_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc) (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (J : Finset ℤ) (ℓ : ℕ)
    (S : Finset ℕ) (hS : ∀ j ∈ J, ∀ a ∈ F, a.1 < j - ℓ → (j - a.1).toNat ∈ S)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {τ₁ τ₂ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hτ₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ∑ j ∈ J, ‖pairingOp hT (by linarith) (lt_of_lt_of_le hp hpq) j
        (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a')‖ₑ ≤
      (4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) * (1 + 3 ^ d) * ℓ +
        ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
          (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d) *
            ((1 + 3 ^ d) * (1 + s))) * ∑ a ∈ F, volume (qcube a : Set (Rd d)) := by
  set V := ∑ a ∈ F, volume (qcube a : Set (Rd d))
  set C₁ := 4 * ENNReal.ofReal A₀ * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
    (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d)
  set C₂ : ℕ → ℝ≥0∞ := fun s => 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) *
    (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
    (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) * (1 + 3 ^ d)
  -- the counting estimates
  have c1 : ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L) ≤ ℓ * V :=
    sum_lvol_le_mul F J (fun j L => j - ℓ ≤ L) ℓ fun L => by
      refine le_trans (Finset.card_le_card fun j hj => ?_) (card_filter_Ioc_le J L ℓ)
      simp only [Finset.mem_filter] at hj ⊢
      exact ⟨hj.1, hj.2.1, by omega⟩
  have c2 : ∀ s : ℕ, ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j))
      (fun L => L < j - ℓ ∧ L = j - s) ≤ ((1 : ℕ) : ℝ≥0∞) * V := fun s =>
    sum_lvol_le_mul F J (fun j L => L < j - ℓ ∧ L = j - s) 1 fun L => by
      refine le_trans (Finset.card_le_card fun j hj => ?_) (card_filter_eq_le J L s)
      simp only [Finset.mem_filter] at hj ⊢
      exact ⟨hj.1, hj.2.2.2⟩
  have c3 : ∀ s : ℕ, ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - s ≤ L) ≤
      s * V := fun s =>
    sum_lvol_le_mul F J (fun j L => j - s ≤ L) s fun L => by
      refine le_trans (Finset.card_le_card fun j hj => ?_) (card_filter_Ioc_le J L s)
      simp only [Finset.mem_filter] at hj ⊢
      exact ⟨hj.1, hj.2.1, by omega⟩
  have c4 : ∀ s : ℕ, ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - s < L) ≤
      s * V := fun s =>
    sum_lvol_le_mul F J (fun j L => j - s < L) s fun L => by
      refine le_trans (Finset.card_le_card fun j hj => ?_) (card_filter_Ioc_le J L s)
      simp only [Finset.mem_filter] at hj ⊢
      exact ⟨hj.1, hj.2.1, by omega⟩
  calc ∑ j ∈ J, ‖pairingOp hT (by linarith) (lt_of_lt_of_le hp hpq) j
        (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a')‖ₑ
      ≤ ∑ j ∈ J, (C₁ * (lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L) +
            3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L)) +
          ∑ s ∈ S, C₂ s * (lvol (F.filter (fun a => a.1 < j)) (fun L => L < j - ℓ ∧ L = j - s) +
            3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => j - s ≤ L)) +
          ∑ s ∈ S, C₂ s * (lvol (F.filter (fun a => a.1 < j)) (fun L => j - s < L) +
            3 ^ d * lvol (F.filter (fun a => a.1 < j)) (fun L => L < j - ℓ ∧ L = j - s))) :=
        Finset.sum_le_sum fun j hj =>
          III4_scale_le hT hp hpq hε hA₀ hB hI hFI j ℓ S (hS j hj) f₁ f₂ hτ₁ hτ₂
    _ = C₁ * ((1 + 3 ^ d) * ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - ℓ ≤ L)) +
          ∑ s ∈ S, C₂ s * (∑ j ∈ J, lvol (F.filter (fun a => a.1 < j))
              (fun L => L < j - ℓ ∧ L = j - s) +
            3 ^ d * ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - s ≤ L) +
            (∑ j ∈ J, lvol (F.filter (fun a => a.1 < j)) (fun L => j - s < L) +
            3 ^ d * ∑ j ∈ J, lvol (F.filter (fun a => a.1 < j))
              (fun L => L < j - ℓ ∧ L = j - s))) :=
        sum_scale_rearrange J S C₁ C₂ _ _ _ _ _
    _ ≤ C₁ * ((1 + 3 ^ d) * (ℓ * V)) +
          ∑ s ∈ S, C₂ s * (((1 : ℕ) : ℝ≥0∞) * V + 3 ^ d * (s * V) +
            (s * V + 3 ^ d * (((1 : ℕ) : ℝ≥0∞) * V))) := by
        refine add_le_add (mul_le_mul_right (mul_le_mul_right c1 _) _)
          (Finset.sum_le_sum fun s _ => mul_le_mul_right ?_ _)
        exact add_le_add (add_le_add (c2 s) (mul_le_mul_right (c3 s) _))
          (add_le_add (c4 s) (mul_le_mul_right (c2 s) _))
    _ = _ := by
        symm
        rw [add_mul, Finset.sum_mul]
        congr 1
        · ring
        · refine Finset.sum_congr rfl fun s _ => ?_
          simp only [Nat.cast_one]
          ring

end IVScale

/-! ### §4.4: the choice of `ℓ` (elldef) and the resulting bounds -/

section EllChoice

/-- Telescoping bound for the tail `∑_{s=n}^{M-1} (1+s) r^s ≤ r^n ((1+n)/(1-r) + r/(1-r)^2)`. -/
theorem sum_Ico_succ_mul_geom_le {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (n M : ℕ) :
    ∑ s ∈ Finset.Ico n M, (1 + (s : ℝ)) * r ^ s ≤
      r ^ n * ((1 + n) / (1 - r) + r / (1 - r) ^ 2) := by
  have h1r : 0 < 1 - r := by linarith
  set A : ℕ → ℝ := fun s => r ^ s * ((1 + s) / (1 - r) + r / (1 - r) ^ 2) with hA
  have hstep : ∀ s : ℕ, A s - A (s + 1) = (1 + (s : ℝ)) * r ^ s := by
    intro s
    simp only [hA, pow_succ]
    push_cast
    field_simp
    ring
  have hA_nn : ∀ s, 0 ≤ A s := fun s => by simp only [hA]; positivity
  have htel : ∀ M, n ≤ M → ∑ s ∈ Finset.Ico n M, (1 + (s : ℝ)) * r ^ s = A n - A M := by
    intro M hM
    induction M, hM using Nat.le_induction with
    | base => simp
    | succ M hnM ih =>
      rw [Finset.sum_Ico_succ_top hnM, ih, ← hstep M]
      ring
  rcases le_or_gt n M with h | h
  · rw [htel M h]
    linarith [hA_nn M]
  · rw [Finset.Ico_eq_empty_of_le h.le, Finset.sum_empty]
    exact hA_nn n

/-- The integer `ℓ` of (elldef): `ℓ = ⌈2 log₂(2 + B/A∘) / ε⌉`. -/
noncomputable def ellOf (ε A₀ B : ℝ) : ℕ := ⌈2 * Real.logb 2 (2 + B / A₀) / ε⌉₊

theorem logb_two_le (x : ℝ) (hx : 1 ≤ x) : Real.logb 2 x ≤ 2 * x := by
  rw [Real.logb, div_le_iff₀ (Real.log_pos (by norm_num))]
  have h1 := Real.log_le_sub_one_of_pos (by linarith : (0 : ℝ) < x)
  have h2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have := Real.log_two_gt_d9
    linarith
  nlinarith

/-- **(elldef), first consequence**: `A∘ ℓ ≤ c_ℓ A∘ log(2 + B/A∘)`. -/
theorem ellOf_le {ε A₀ B : ℝ} (hε : 0 < ε) (hA₀ : 0 < A₀) (hB : 0 ≤ B) :
    (ellOf ε A₀ B : ℝ) ≤ (2 / (ε * Real.log 2) + 1 / Real.log 2) * Real.log (2 + B / A₀) := by
  set x := 2 + B / A₀ with hx
  have hx2 : 2 ≤ x := by rw [hx]; have := div_nonneg hB hA₀.le; linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogx : Real.log 2 ≤ Real.log x := Real.log_le_log (by norm_num) hx2
  have h1 : (ellOf ε A₀ B : ℝ) ≤ 2 * Real.logb 2 x / ε + 1 := by
    unfold ellOf
    exact (Nat.ceil_lt_add_one (by
      have : 0 ≤ Real.logb 2 x := Real.logb_nonneg (by norm_num) (by linarith)
      positivity)).le
  rw [Real.logb] at h1
  have h2 : 1 ≤ Real.log x / Real.log 2 := by rw [le_div_iff₀ hlog2]; linarith
  calc (ellOf ε A₀ B : ℝ) ≤ 2 * (Real.log x / Real.log 2) / ε + 1 := h1
    _ ≤ 2 * (Real.log x / Real.log 2) / ε + Real.log x / Real.log 2 := by linarith
    _ = (2 / (ε * Real.log 2) + 1 / Real.log 2) * Real.log x := by
        field_simp

/-- **(elldef), second consequence**: `(B + A∘) 2^{-εℓ} (ℓ + 2) ≤ (4/ε + 3) A∘`. -/
theorem ellOf_tail_le {ε A₀ B : ℝ} (hε : 0 < ε) (hA₀ : 0 < A₀) (hB : 0 ≤ B) :
    (B + A₀) * ((2 : ℝ) ^ (-ε)) ^ ellOf ε A₀ B * (ellOf ε A₀ B + 2) ≤ (4 / ε + 3) * A₀ := by
  set x := 2 + B / A₀ with hx
  set ℓ := ellOf ε A₀ B
  have hx2 : 2 ≤ x := by rw [hx]; have := div_nonneg hB hA₀.le; linarith
  have hx0 : 0 < x := by linarith
  have hBA : B + A₀ ≤ A₀ * x := by
    rw [hx, mul_add, mul_div_cancel₀ _ hA₀.ne']
    linarith
  have hℓ1 : 2 * Real.logb 2 x / ε ≤ ℓ := Nat.le_ceil _
  have hℓ2 : (ℓ : ℝ) ≤ 2 * Real.logb 2 x / ε + 1 := (Nat.ceil_lt_add_one (by
      have : 0 ≤ Real.logb 2 x := Real.logb_nonneg (by norm_num) (by linarith)
      positivity)).le
  -- `2^{-εℓ} ≤ x^{-2}`
  have hr : ((2 : ℝ) ^ (-ε)) ^ ℓ ≤ x⁻¹ ^ 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    have : (2 : ℝ) ^ (-(2 * Real.logb 2 x)) = x⁻¹ ^ 2 := by
      rw [Real.rpow_neg (by norm_num), show 2 * Real.logb 2 x = Real.logb 2 x * 2 by ring,
        Real.rpow_mul (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hx0,
        Real.rpow_two, inv_pow]
    rw [← this]
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have := (div_le_iff₀ hε).1 hℓ1
    nlinarith
  have hlogb := logb_two_le x (by linarith)
  have hℓx : (ℓ : ℝ) + 2 ≤ (4 / ε + 3) * x := by
    have h3 : 2 * Real.logb 2 x / ε ≤ 4 * x / ε := by
      apply div_le_div_of_nonneg_right _ hε.le; linarith
    have h4 : (4 : ℝ) * x / ε = 4 / ε * x := by ring
    nlinarith
  have hr0 : 0 ≤ ((2 : ℝ) ^ (-ε)) ^ ℓ := by positivity
  calc (B + A₀) * ((2 : ℝ) ^ (-ε)) ^ ℓ * (ℓ + 2)
      ≤ (A₀ * x) * x⁻¹ ^ 2 * ((4 / ε + 3) * x) := by
        gcongr
    _ = (4 / ε + 3) * A₀ := by
        field_simp

end EllChoice

/-! ### §4.4: the term bounds in terms of `X = |Q₀| ⟨f₁⟩_{Q₀,p} ⟨f₂⟩_{3Q₀,q'}` -/

section TermsX

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- `(C_up Λ a^r)^{1/r} = (C_up Λ)^{1/r} a`. -/
theorem K_eq {r Λ : ℝ} (hr : 0 < r) (hΛ : 0 ≤ Λ) (a : ℝ≥0∞) :
    (ENNReal.ofReal (upC d) * (ENNReal.ofReal Λ * a ^ r)) ^ (1 / r) =
      ENNReal.ofReal ((upC d * Λ) ^ (1 / r)) * a := by
  rw [← mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.ofReal_mul
    upC_pos.le, ENNReal.ofReal_rpow_of_nonneg (by have := upC_pos (d := d); positivity)
    (by positivity), ← ENNReal.rpow_mul, mul_one_div_cancel hr.ne', ENNReal.rpow_one]

theorem rpow_mul_rpow_of_conj {q : ℝ} (hq : 1 < q) (x : ℝ≥0∞) :
    x ^ (1 / q) * x ^ (1 / q.conjExponent) = x := by
  have hpq := Real.HolderConjugate.conjExponent hq
  rcases eq_or_ne x 0 with rfl | h0
  · rw [ENNReal.zero_rpow_of_pos (by have := hpq.pos; positivity), zero_mul]
  rcases eq_or_ne x ∞ with rfl | htop
  · rw [ENNReal.top_rpow_of_pos (by have := hpq.pos; positivity),
      ENNReal.top_rpow_of_pos (by have := hpq.symm.pos; positivity), ENNReal.top_mul_top]
  rw [← ENNReal.rpow_add _ _ h0 htop]
  have := hpq.inv_add_inv_eq_one
  simp only [one_div] at this ⊢
  rw [this, ENNReal.rpow_one]

theorem three_pow_rpow_le {r : ℝ} (_hr0 : 0 ≤ r) (hr1 : r ≤ 1) :
    ((3 : ℝ≥0∞) ^ d) ^ r ≤ 3 ^ d := by
  calc ((3 : ℝ≥0∞) ^ d) ^ r ≤ ((3 : ℝ≥0∞) ^ d) ^ (1 : ℝ) :=
        ENNReal.rpow_le_rpow_of_exponent_le (one_le_pow₀ (by norm_num)) hr1
    _ = 3 ^ d := ENNReal.rpow_one _

/-- `‖f₂‖_{q'} = |3Q₀|^{1/q'} ⟨f₂⟩_{3Q₀,q'} ≤ 3^d |Q₀|^{1/q'} ⟨f₂⟩_{3Q₀,q'}` for `f₂` supported in
`3Q₀`. -/
theorem eLpNorm_le_of_support_triple {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] (Q₀ : Cube d) (f : SimpleCpt d 𝕜' B)
    (hf : Function.support ⇑f ⊆ Q₀.triple) {r : ℝ} (hr : 1 ≤ r) :
    eLpNorm f (.ofReal r) volume ≤
      3 ^ d * (volume (Q₀ : Set (Rd d)) ^ (1 / r) * avgNorm f Q₀.triple r) := by
  have hind : ((Q₀.triple : Set (Rd d))).indicator ⇑f = ⇑f := by
    funext x
    by_cases hx : x ∈ (Q₀.triple : Set (Rd d))
    · rw [indicator_of_mem hx]
    · rw [indicator_of_notMem hx, Function.notMem_support.1 fun h => hx (hf h)]
  have h := eLpNorm_indicator_eq_avgNorm (SimpleCpt.aestronglyMeasurable f)
    Q₀.triple.measurableSet Q₀.triple.volume_ne_zero Q₀.triple.volume_ne_top (p := r)
    (by linarith)
  rw [hind, Q₀.volume_triple, ENNReal.mul_rpow_of_nonneg _ _ (by
    have : 0 < r := by linarith
    positivity)] at h
  rw [h, mul_assoc]
  gcongr
  exact three_pow_rpow_le (one_div_nonneg.2 (by linarith))
    (by rw [div_le_one (by linarith)]; exact hr)

/-- `‖f₁‖_p = |Q₀|^{1/p} ⟨f₁⟩_{Q₀,p}` for `f₁` supported in `Q₀`. -/
theorem eLpNorm_eq_of_support {𝕜' : Type*} [RCLike 𝕜'] {B : Type*} [NormedAddCommGroup B]
    [NormedSpace 𝕜' B] (Q₀ : Cube d) (f : SimpleCpt d 𝕜' B) (hf : Function.support ⇑f ⊆ Q₀)
    {r : ℝ} (hr : 0 < r) :
    eLpNorm f (.ofReal r) volume = volume (Q₀ : Set (Rd d)) ^ (1 / r) * avgNorm f Q₀ r := by
  have hind : ((Q₀ : Set (Rd d))).indicator ⇑f = ⇑f := by
    funext x
    by_cases hx : x ∈ (Q₀ : Set (Rd d))
    · rw [indicator_of_mem hx]
    · rw [indicator_of_notMem hx, Function.notMem_support.1 fun h => hx (hf h)]
  have h := eLpNorm_indicator_eq_avgNorm (SimpleCpt.aestronglyMeasurable f)
    Q₀.measurableSet Q₀.volume_ne_zero Q₀.volume_ne_top hr
  rwa [hind] at h

/-- The bound `|g| ≤ K` with `K = (C_up τ)^{1/r}` and `supp g ⊆ S`, in the form used by the
weak-type estimates. -/
theorem norm_czGood_le_indicator (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) {𝕜' : Type*} [RCLike 𝕜'] {B : Type*}
    [NormedAddCommGroup B] [NormedSpace 𝕜' B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜' B]
    [CompleteSpace B] {f : SimpleCpt d 𝕜' B} {r : ℝ} (hr : 1 ≤ r) {τ : ℝ≥0∞} (hτtop : τ ≠ ∞)
    (hτmax : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ)
    (hτpt : ∀ z ∉ Ω, ‖f z‖ₑ ^ r ≤ τ) {S : Set (Rd d)} (hfS : Function.support ⇑f ⊆ S)
    (hWS : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ S).Nonempty → (qcube a : Set (Rd d)) ⊆ S)
    (x : Rd d) :
    ‖czGood hΩ F f x‖ ≤ S.indicator
      (fun _ => ((ENNReal.ofReal (upC d) * τ) ^ (1 / r)).toReal) x := by
  have hMgtop : (ENNReal.ofReal (upC d) * τ) ^ (1 / r) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (one_div_nonneg.2 (by linarith))
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτtop)
  by_cases hxS : x ∈ S
  · rw [indicator_of_mem hxS, ← ENNReal.ofReal_le_iff_le_toReal hMgtop, ofReal_norm]
    exact enorm_czGood_le hI hΩ hFI f hr hτmax hτpt x
  · have : czGood hΩ F f x = 0 := Function.notMem_support.1 fun h =>
      hxS (support_czGood_subset hI hΩ hFI hfS hWS h)
    rw [indicator_of_notMem hxS, this, norm_zero]

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- **(good-fct)**: `|⟨S g₁, f₂⟩| ≤ A(q) q 3^d K₁ |Q₀|^{1/q} |Q₀|^{1/q'} ⟨f₂⟩_{3Q₀,q'}`. -/
theorem good_term_X (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    {N₁ N₂ : ℤ} (hN : N₁ ≤ N₂) (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (Q₀ : Cube d)
    {f₁ : SimpleCpt d 𝕜 B₁} (hf₁ : Function.support ⇑f₁ ⊆ Q₀)
    {f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)} (hf₂ : Function.support ⇑f₂ ⊆ Q₀.triple)
    (hWQ : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ Q₀).Nonempty → (qcube a : Set (Rd d)) ⊆ Q₀)
    {τ₁ : ℝ≥0∞} (hτ₁top : τ₁ ≠ ∞)
    (hmax₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hpt₁ : ∀ z ∉ Ω, ‖f₁ z‖ₑ ^ p ≤ τ₁) :
    ‖pairing (psum T N₁ N₂ (czGood hΩ F f₁)) f₂‖ₑ ≤
      ENNReal.ofReal Aq * ENNReal.ofReal q * 3 ^ d * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        volume (Q₀ : Set (Rd d)) * avgNorm f₂ Q₀.triple q.conjExponent := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  refine (good_term_le hT hq hN _ f₂).trans ?_
  have hL := lorentzOneNorm_czGood_le hI hΩ hFI hp.le hτ₁top hmax₁ hpt₁ hf₁ hWQ
    (by linarith : (0 : ℝ) < q)
  have hf₂n := eLpNorm_le_of_support_triple Q₀ f₂ hf₂ hpq'.symm.lt.le
  calc ENNReal.ofReal Aq * lorentzOneNorm (czGood hΩ F f₁) q *
        eLpNorm f₂ (.ofReal q.conjExponent) volume
      ≤ ENNReal.ofReal Aq * (ENNReal.ofReal q * ((ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          volume (Q₀ : Set (Rd d)) ^ (1 / q))) * (3 ^ d * (volume (Q₀ : Set (Rd d)) ^
            (1 / q.conjExponent) * avgNorm f₂ Q₀.triple q.conjExponent)) := by gcongr
    _ = ENNReal.ofReal Aq * ENNReal.ofReal q * 3 ^ d * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
          (volume (Q₀ : Set (Rd d)) ^ (1 / q) * volume (Q₀ : Set (Rd d)) ^
            (1 / q.conjExponent)) * avgNorm f₂ Q₀.triple q.conjExponent := by ring
    _ = _ := by rw [rpow_mul_rpow_of_conj hq]

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- **(IIest)**: `∑_W |⟨S_W ((⨍_W f₁) 1_W), f₂⟩| ≤ A(q) q 3^d K₁ K₂ ∑_W |W|`. -/
theorem II_term_X (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    {N₁ N₂ : ℤ} (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂))
    {τ₁ τ₂ : ℝ≥0∞} (hτ₁top : τ₁ ≠ ∞) (_hτ₂top : τ₂ ≠ ∞)
    (hmax₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hmax₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂) :
    ∑ a ∈ F, ‖pairing (psumOn T ((Finset.Icc N₁ N₂).filter (· ≤ a.1))
        (condExp (protoGrid d) a.1 (czF f₁ a))) f₂‖ₑ ≤
      ENNReal.ofReal Aq * ENNReal.ofReal q * 3 ^ d * (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) *
          ∑ a ∈ F, volume (qcube a : Set (Rd d)) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) with hK₁
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) with hK₂
  have hK₁top : K₁ ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (one_div_nonneg.2 (by linarith))
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτ₁top)
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun a ha => ?_
  have h2 : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  have hsupp : Function.support ⇑(condExp (protoGrid d) a.1 (czF f₁ a)) ⊆
      (qcube a : Set (Rd d)) := by
    intro x hx
    rw [Function.mem_support, condExp_czF_apply] at hx
    by_contra h
    exact hx (indicator_of_notMem h _)
  refine (II_term_le hT hq a _ hsupp f₂).trans ?_
  -- the Lorentz norm of `(⨍_W f₁) 1_W`
  have havg : ‖⨍ y in (qcube a : Set (Rd d)), f₁ y‖ₑ ≤ K₁ :=
    (enorm_setAverage_le_avgNorm (SimpleCpt.aestronglyMeasurable f₁)
      (Cube.volume_ne_zero _) (Cube.volume_ne_top _) hp.le).trans
      (avgNorm_le_of_whitney hI (by linarith) hmax₁ (hFI a ha) (qcube a) subset_rfl
        (by rw [qcube_side]; linarith))
  have hL : lorentzOneNorm (condExp (protoGrid d) a.1 (czF f₁ a)) q ≤
      ENNReal.ofReal q * (K₁ * volume (qcube a : Set (Rd d)) ^ (1 / q)) := by
    have hb : ∀ x, ‖(condExp (protoGrid d) a.1 (czF f₁ a)) x‖ ≤
        (qcube a : Set (Rd d)).indicator (fun _ => K₁.toReal) x := by
      intro x
      rw [condExp_czF_apply]
      by_cases hx : x ∈ (qcube a : Set (Rd d))
      · rw [indicator_of_mem hx, indicator_of_mem hx, ← ENNReal.ofReal_le_iff_le_toReal hK₁top,
          ofReal_norm]
        exact havg
      · rw [indicator_of_notMem hx, indicator_of_notMem hx, norm_zero]
    have := lorentzOneNorm_le_of_le_indicator hb (by linarith : (0 : ℝ) < q)
    rwa [ENNReal.ofReal_toReal hK₁top] at this
  -- the `L^{q'}` norm of `f₂ 1_{3W}`
  have hf₂W : eLpNorm (((qcube a).triple : Set (Rd d)).indicator f₂)
      (.ofReal q.conjExponent) volume ≤ 3 ^ d *
        (volume (qcube a : Set (Rd d)) ^ (1 / q.conjExponent) * K₂) := by
    rw [eLpNorm_indicator_eq_avgNorm (SimpleCpt.aestronglyMeasurable f₂)
      (Cube.measurableSet _) (Cube.volume_ne_zero _) (Cube.volume_ne_top _) hpq'.symm.pos,
      Cube.volume_triple, ENNReal.mul_rpow_of_nonneg _ _ (by have := hpq'.symm.pos; positivity),
      mul_assoc]
    gcongr
    · exact three_pow_rpow_le (by have := hpq'.symm.pos; positivity)
        (by rw [div_le_one hpq'.symm.pos]; exact hpq'.symm.lt.le)
    · exact avgNorm_le_of_whitney hI hpq'.symm.pos hmax₂ (hFI a ha) _
        (Cube.subset_triple _) (by rw [Cube.triple_side, qcube_side])
  calc ENNReal.ofReal Aq * lorentzOneNorm (condExp (protoGrid d) a.1 (czF f₁ a)) q *
        eLpNorm (((qcube a).triple : Set (Rd d)).indicator f₂) (.ofReal q.conjExponent) volume
      ≤ ENNReal.ofReal Aq * (ENNReal.ofReal q * (K₁ * volume (qcube a : Set (Rd d)) ^ (1 / q))) *
          (3 ^ d * (volume (qcube a : Set (Rd d)) ^ (1 / q.conjExponent) * K₂)) := by gcongr
    _ = ENNReal.ofReal Aq * ENNReal.ofReal q * 3 ^ d * K₁ * K₂ *
          (volume (qcube a : Set (Rd d)) ^ (1 / q) *
            volume (qcube a : Set (Rd d)) ^ (1 / q.conjExponent)) := by ring
    _ = _ := by rw [rpow_mul_rpow_of_conj hq]

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- **`III₁`**: `|⟨S b₁, g₂⟩| ≤ 2 p' A(p) 3^d K₂ |Q₀|^{1/p} |Q₀|^{1-1/p} ⟨f₁⟩_{Q₀,p}`. -/
theorem III1_term_X (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    {N₁ N₂ : ℤ} (hN : N₁ ≤ N₂) (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (Q₀ : Cube d)
    {f₁ : SimpleCpt d 𝕜 B₁} (hf₁ : Function.support ⇑f₁ ⊆ Q₀)
    {f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)} (hf₂ : Function.support ⇑f₂ ⊆ Q₀.triple)
    (hWQ3 : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ Q₀.triple).Nonempty →
      (qcube a : Set (Rd d)) ⊆ Q₀.triple)
    {τ₂ : ℝ≥0∞} (hτ₂top : τ₂ ≠ ∞)
    (hmax₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂)
    (hpt₂ : ∀ z ∉ Ω, ‖f₂ z‖ₑ ^ q.conjExponent ≤ τ₂) :
    ‖pairing (psum T N₁ N₂ (czBad F f₁)) ⇑(czGood hΩ F f₂)‖ₑ ≤
      2 * ENNReal.ofReal (p / (p - 1)) * ENNReal.ofReal Ap * 3 ^ d *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) *
          volume (Q₀ : Set (Rd d)) * avgNorm f₁ Q₀ p := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) with hK₂
  have hK₂top : K₂ ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (one_div_nonneg.2 hpq'.symm.pos.le)
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτ₂top)
  have hg := norm_czGood_le_indicator hI hΩ hFI hpq'.symm.lt.le hτ₂top hmax₂ hpt₂ hf₂ hWQ3
  refine (III1_term_le hT hp hN (czBad F f₁) Q₀.triple.measurableSet Q₀.triple.volume_ne_top
    hg).trans ?_
  rw [ENNReal.ofReal_toReal hK₂top]
  have hb : eLpNorm (czBad F f₁) (.ofReal p) volume ≤
      2 * (volume (Q₀ : Set (Rd d)) ^ (1 / p) * avgNorm f₁ Q₀ p) := by
    refine (eLpNorm_sum_czB_le hI hFI f₁ hp.le).trans ?_
    gcongr
    rw [← eLpNorm_eq_of_support Q₀ f₁ hf₁ (by linarith)]
    exact eLpNorm_indicator_le _ (measurableSet_biUnion_qcube F)
  have h3 : volume (Q₀.triple : Set (Rd d)) ^ (1 - 1 / p) ≤
      3 ^ d * volume (Q₀ : Set (Rd d)) ^ (1 - 1 / p) := by
    have h0 : 0 ≤ 1 - 1 / p := by
      have : 1 / p ≤ 1 := by rw [div_le_one (by linarith)]; exact hp.le
      linarith
    rw [Q₀.volume_triple, ENNReal.mul_rpow_of_nonneg _ _ h0]
    gcongr
    exact three_pow_rpow_le h0 (by have : 0 < 1 / p := one_div_pos.2 (by linarith); linarith)
  have hvol : volume (Q₀ : Set (Rd d)) ^ (1 / p) * volume (Q₀ : Set (Rd d)) ^ (1 - 1 / p) =
      volume (Q₀ : Set (Rd d)) := by
    rw [← ENNReal.rpow_add _ _ Q₀.volume_ne_zero Q₀.volume_ne_top,
      show 1 / p + (1 - 1 / p) = 1 by ring, ENNReal.rpow_one]
  calc K₂ * (ENNReal.ofReal (p / (p - 1)) * (ENNReal.ofReal Ap *
        eLpNorm (czBad F f₁) (.ofReal p) volume) * volume (Q₀.triple : Set (Rd d)) ^ (1 - 1 / p))
      ≤ K₂ * (ENNReal.ofReal (p / (p - 1)) * (ENNReal.ofReal Ap *
          (2 * (volume (Q₀ : Set (Rd d)) ^ (1 / p) * avgNorm f₁ Q₀ p))) *
            (3 ^ d * volume (Q₀ : Set (Rd d)) ^ (1 - 1 / p))) := by gcongr
    _ = 2 * ENNReal.ofReal (p / (p - 1)) * ENNReal.ofReal Ap * 3 ^ d * K₂ *
          (volume (Q₀ : Set (Rd d)) ^ (1 / p) * volume (Q₀ : Set (Rd d)) ^ (1 - 1 / p)) *
            avgNorm f₁ Q₀ p := by ring
    _ = _ := by rw [hvol]

omit [CompleteSpace B₂] in
/-- **`III₂`**: `∑_W |⟨S_W b_{1,W}, g₂⟩| ≤ 2 p' A(p) 3^d K₁ K₂ ∑_W |W|`. -/
theorem III2_term_X (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hpq : p ≤ q)
    {N₁ N₂ : ℤ} (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (Q₀ : Cube d)
    (f₁ : SimpleCpt d 𝕜 B₁) {f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)}
    (hf₂ : Function.support ⇑f₂ ⊆ Q₀.triple)
    (hWQ3 : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ Q₀.triple).Nonempty →
      (qcube a : Set (Rd d)) ⊆ Q₀.triple)
    {τ₁ τ₂ : ℝ≥0∞} (hτ₂top : τ₂ ≠ ∞)
    (hmax₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁)
    (hmax₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ q.conjExponent) z ≤ τ₂)
    (hpt₂ : ∀ z ∉ Ω, ‖f₂ z‖ₑ ^ q.conjExponent ≤ τ₂) :
    ∑ a ∈ F, ‖pairing (psumOn T ((Finset.Icc N₁ N₂).filter (· ≤ a.1)) (czB f₁ a))
        ⇑(czGood hΩ F f₂)‖ₑ ≤
      2 * ENNReal.ofReal (p / (p - 1)) * ENNReal.ofReal Ap * 3 ^ d *
        (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) *
          ∑ a ∈ F, volume (qcube a : Set (Rd d)) := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  set K₁ := (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) with hK₁
  set K₂ := (ENNReal.ofReal (upC d) * τ₂) ^ (1 / q.conjExponent) with hK₂
  have hK₂top : K₂ ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (one_div_nonneg.2 hpq'.symm.pos.le)
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτ₂top)
  have hg := norm_czGood_le_indicator hI hΩ hFI hpq'.symm.lt.le hτ₂top hmax₂ hpt₂ hf₂ hWQ3
  have hg' : ∀ x, ‖czGood hΩ F f₂ x‖ ≤ K₂.toReal := fun x => (hg x).trans (by
    by_cases hx : x ∈ (Q₀.triple : Set (Rd d))
    · rw [indicator_of_mem hx]
    · rw [indicator_of_notMem hx]; exact ENNReal.toReal_nonneg)
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun a ha => ?_
  have h2 : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  refine (III2_term_le hT hp a (czB f₁ a) (support_czB_subset f₁ a)
    (SimpleCpt.aestronglyMeasurable _) ENNReal.toReal_nonneg hg').trans ?_
  rw [ENNReal.ofReal_toReal hK₂top]
  have hb := eLpNorm_czB_le hI (hFI a ha) f₁ hp.le hmax₁
  have h0 : 0 ≤ 1 - 1 / p := by
    have : 1 / p ≤ 1 := by rw [div_le_one (by linarith)]; exact hp.le
    linarith
  have h3 : volume ((qcube a).triple : Set (Rd d)) ^ (1 - 1 / p) ≤
      3 ^ d * volume (qcube a : Set (Rd d)) ^ (1 - 1 / p) := by
    rw [Cube.volume_triple, ENNReal.mul_rpow_of_nonneg _ _ h0]
    gcongr
    exact three_pow_rpow_le h0 (by have : 0 < 1 / p := one_div_pos.2 (by linarith); linarith)
  have hvol : volume (qcube a : Set (Rd d)) ^ (1 / p) *
      volume (qcube a : Set (Rd d)) ^ (1 - 1 / p) = volume (qcube a : Set (Rd d)) := by
    rw [← ENNReal.rpow_add _ _ (Cube.volume_ne_zero _) (Cube.volume_ne_top _),
      show 1 / p + (1 - 1 / p) = 1 by ring, ENNReal.rpow_one]
  calc K₂ * (ENNReal.ofReal (p / (p - 1)) * (ENNReal.ofReal Ap *
        eLpNorm (czB f₁ a) (.ofReal p) volume) *
          volume ((qcube a).triple : Set (Rd d)) ^ (1 - 1 / p))
      ≤ K₂ * (ENNReal.ofReal (p / (p - 1)) * (ENNReal.ofReal Ap *
          (2 * (K₁ * volume (qcube a : Set (Rd d)) ^ (1 / p)))) *
            (3 ^ d * volume (qcube a : Set (Rd d)) ^ (1 - 1 / p))) := by gcongr
    _ = 2 * ENNReal.ofReal (p / (p - 1)) * ENNReal.ofReal Ap * 3 ^ d * K₁ * K₂ *
          (volume (qcube a : Set (Rd d)) ^ (1 / p) *
            volume (qcube a : Set (Rd d)) ^ (1 - 1 / p)) := by ring
    _ = _ := by rw [hvol]

end TermsX

/-! ### §4.4: the coefficient of `III₄` after the choice of `ℓ` -/

section IVCoeff

/-- The constant in front of `A∘ log(2 + B/A∘)` in the bound for `III₄`. -/
noncomputable def cIV (d : ℕ) (ε : ℝ) : ℝ :=
  (1 + 3 ^ d) ^ 2 * (4 * (2 / (ε * Real.log 2) + 1 / Real.log 2) +
    2 * Kreg d ε * (4 / ε + 3) * (1 / (1 - (2 : ℝ) ^ (-ε)) + 1 / (1 - (2 : ℝ) ^ (-ε)) ^ 2) /
      Real.log 2)

/-- **The `III₄` coefficient**: with `ℓ = ⌈2 log₂(2 + B/A∘)/ε⌉`,
`4 A∘ (1+3^d)^2 ℓ + 2 (1+3^d)^2 K(d,ε)(B + A∘) ∑_{s>ℓ} (1+s) 2^{-εs} ≤ c_IV A∘ log(2 + B/A∘)`. -/
theorem III4_coeff_le {ε A₀ B : ℝ} (hε : 0 < ε) (hA₀ : 0 < A₀) (hB : 0 ≤ B) (Smax : ℕ) :
    4 * A₀ * (1 + 3 ^ d) ^ 2 * (ellOf ε A₀ B : ℝ) + 2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (B + A₀) *
        ∑ s ∈ Finset.Icc (ellOf ε A₀ B + 1) Smax, (2 : ℝ) ^ (-ε * s) * (1 + s) ≤
      cIV d ε * (A₀ * Real.log (2 + B / A₀)) := by
  set ℓ := ellOf ε A₀ B
  set r : ℝ := (2 : ℝ) ^ (-ε) with hr
  have hr0 : 0 ≤ r := by positivity
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have h1r : 0 < 1 - r := by linarith
  set cr := 1 / (1 - r) + 1 / (1 - r) ^ 2 with hcr
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  set x := 2 + B / A₀ with hx
  have hx2 : 2 ≤ x := by rw [hx]; have := div_nonneg hB hA₀.le; linarith
  have hlogx : Real.log 2 ≤ Real.log x := Real.log_le_log (by norm_num) hx2
  have hKreg := Kreg_nonneg d hε
  -- the geometric tail
  have hsum : ∑ s ∈ Finset.Icc (ℓ + 1) Smax, (2 : ℝ) ^ (-ε * s) * (1 + s) ≤
      r ^ ℓ * ((ℓ : ℝ) + 2) * cr := by
    have hconv : ∀ s : ℕ, (2 : ℝ) ^ (-ε * s) * (1 + s) = (1 + (s : ℝ)) * r ^ s := by
      intro s
      rw [hr, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), mul_comm]
    simp_rw [hconv]
    rw [show Finset.Icc (ℓ + 1) Smax = Finset.Ico (ℓ + 1) (Smax + 1) from rfl]
    refine (sum_Ico_succ_mul_geom_le hr0 hr1 (ℓ + 1) (Smax + 1)).trans ?_
    push_cast
    rw [pow_succ]
    have hℓ0 : (0 : ℝ) ≤ ℓ := Nat.cast_nonneg _
    have hrℓ : 0 ≤ r ^ ℓ := by positivity
    have e1 : (1 + ((ℓ : ℝ) + 1)) / (1 - r) ≤ ((ℓ : ℝ) + 2) * (1 / (1 - r)) := by
      rw [mul_one_div]; apply le_of_eq; ring
    have e2 : r / (1 - r) ^ 2 ≤ ((ℓ : ℝ) + 2) * (1 / (1 - r) ^ 2) := by
      rw [mul_one_div]
      exact div_le_div_of_nonneg_right (by linarith) (by positivity)
    calc r ^ ℓ * r * ((1 + ((ℓ : ℝ) + 1)) / (1 - r) + r / (1 - r) ^ 2)
        ≤ r ^ ℓ * 1 * (((ℓ : ℝ) + 2) * (1 / (1 - r)) + ((ℓ : ℝ) + 2) * (1 / (1 - r) ^ 2)) := by
          gcongr
      _ = r ^ ℓ * ((ℓ : ℝ) + 2) * cr := by rw [hcr]; ring
  have htail := ellOf_tail_le hε hA₀ hB
  have hℓ := ellOf_le hε hA₀ hB
  have hA₀log : A₀ ≤ A₀ * Real.log x / Real.log 2 := by
    rw [le_div_iff₀ hlog2]; nlinarith
  calc 4 * A₀ * (1 + 3 ^ d) ^ 2 * (ℓ : ℝ) + 2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (B + A₀) *
        ∑ s ∈ Finset.Icc (ℓ + 1) Smax, (2 : ℝ) ^ (-ε * s) * (1 + s)
      ≤ 4 * A₀ * (1 + 3 ^ d) ^ 2 * ((2 / (ε * Real.log 2) + 1 / Real.log 2) * Real.log x) +
          2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (B + A₀) * (r ^ ℓ * ((ℓ : ℝ) + 2) * cr) := by
        have hBA : 0 ≤ B + A₀ := by linarith
        exact add_le_add (mul_le_mul_of_nonneg_left hℓ (by positivity))
          (mul_le_mul_of_nonneg_left hsum (by positivity))
    _ = 4 * (1 + 3 ^ d) ^ 2 * (2 / (ε * Real.log 2) + 1 / Real.log 2) * (A₀ * Real.log x) +
          2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * cr * ((B + A₀) * r ^ ℓ * ((ℓ : ℝ) + 2)) := by ring
    _ ≤ 4 * (1 + 3 ^ d) ^ 2 * (2 / (ε * Real.log 2) + 1 / Real.log 2) * (A₀ * Real.log x) +
          2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * cr * ((4 / ε + 3) * (A₀ * Real.log x / Real.log 2)) := by
        have hcr0 : 0 ≤ cr := by rw [hcr]; positivity
        refine add_le_add le_rfl (mul_le_mul_of_nonneg_left ?_ (by positivity))
        exact htail.trans (mul_le_mul_of_nonneg_left hA₀log (by positivity))
    _ = cIV d ε * (A₀ * Real.log x) := by
        rw [cIV, ← hr, ← hcr]
        field_simp

end IVCoeff

/-! ### §4.4: the splitting (first splitting), (three terms), (eq:IIIsplitting) -/

section Splitting

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
theorem pairing_psumOn_eq (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (J : Finset ℤ) (u : SimpleCpt d 𝕜 B₁) (v : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing (psumOn T J u) ⇑v = ∑ j ∈ J, pairingOp hT hp hq j u v := by
  unfold psumOn
  rw [pairing_sum_left J (fun j _ => hT.aestronglyMeasurable j u) hq
    (fun j _ => eLpNorm_op_lt_top hT hp (by linarith) j u)]
  rfl

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
/-- Splitting the scales at the level of each Whitney cube:
`∑_{j ∈ J} T_j (∑_W b_W) = ∑_W ∑_{j ∈ J, j ≤ L(W)} T_j b_W + ∑_{j ∈ J} T_j (∑_{L(W) < j} b_W)`. -/
theorem sum_scales_split (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (J : Finset ℤ) (F : Finset (ℤ × (Fin d → ℤ))) (b : ℤ × (Fin d → ℤ) → SimpleCpt d 𝕜 B₁)
    (v : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F, b a) v =
      ∑ a ∈ F, ∑ j ∈ J.filter (· ≤ a.1), pairingOp hT hp hq j (b a) v +
        ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), b a) v := by
  have h1 : ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F, b a) v =
      ∑ a ∈ F, ∑ j ∈ J, pairingOp hT hp hq j (b a) v := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [LinearMap.map_sum₂]
  have h2 : ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), b a) v =
      ∑ a ∈ F, ∑ j ∈ J.filter (fun j => ¬ j ≤ a.1), pairingOp hT hp hq j (b a) v := by
    simp_rw [LinearMap.map_sum₂]
    rw [Finset.sum_comm' (t' := F) (s' := fun a => J.filter (fun j => ¬ j ≤ a.1))]
    intro j a
    simp only [Finset.mem_filter, not_le]
    tauto
  rw [h1, h2, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_filter_add_sum_filter_not]

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- **The splitting** (first splitting), (three terms), (eq:IIIsplitting), with remainders:
`⟨S f₁, f₂⟩ = ⟨S g₁, f₂⟩ + ⟨S r₁, f₂⟩ + ∑_W (I_W - II_W) + (III₁ - ∑_W III₂,W) + III₃ + III₄
  + ∑_j ⟨T_j b₁^{<j}, r₂⟩`. -/
theorem pairing_split (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (J : Finset ℤ) (f₁ : SimpleCpt d 𝕜 B₁)
    (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing (psumOn T J f₁) ⇑f₂ =
      pairing (psumOn T J (czGood hΩ F f₁)) ⇑f₂ + pairing (psumOn T J (czRem hΩ F f₁)) ⇑f₂ +
      (∑ a ∈ F, pairing (psumOn T (J.filter (· ≤ a.1)) (czF f₁ a)) ⇑f₂ -
        ∑ a ∈ F, pairing (psumOn T (J.filter (· ≤ a.1))
          (condExp (protoGrid d) a.1 (czF f₁ a))) ⇑f₂) +
      (pairing (psumOn T J (czBad F f₁)) ⇑(czGood hΩ F f₂) -
        ∑ a ∈ F, pairing (psumOn T (J.filter (· ≤ a.1)) (czB f₁ a)) ⇑(czGood hΩ F f₂)) +
      ∑ j ∈ J, ∑ a' ∈ F.filter (fun a' => j ≤ a'.1),
        pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a) (czB f₂ a') +
      ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a') +
      ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (czRem hΩ F f₂) := by
  simp only [pairing_psumOn_eq hT hp hq]
  have hd₁ := cz_decomp hI hΩ hFI f₁
  have hd₂ := cz_decomp hI hΩ hFI f₂
  -- expand `f₁`
  conv_lhs => rw [hd₁]
  simp only [map_add, LinearMap.add_apply, Finset.sum_add_distrib]
  -- split the bad part of `f₁` over the scales
  have hsB := sum_scales_split hT hp hq J F (czB f₁) f₂
  have hsBg := sum_scales_split hT hp hq J F (czB f₁) (czGood hΩ F f₂)
  rw [show czBad F f₁ = ∑ a ∈ F, czB f₁ a from rfl, hsB]
  -- the pieces `b_W = f_W - 𝔼 f_W`
  have hb : ∀ a, ∑ j ∈ J.filter (· ≤ a.1), pairingOp hT hp hq j (czB f₁ a) f₂ =
      ∑ j ∈ J.filter (· ≤ a.1), pairingOp hT hp hq j (czF f₁ a) f₂ -
        ∑ j ∈ J.filter (· ≤ a.1),
          pairingOp hT hp hq j (condExp (protoGrid d) a.1 (czF f₁ a)) f₂ := by
    intro a
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [czB, map_sub, LinearMap.sub_apply]
  rw [Finset.sum_congr rfl fun a _ => hb a, Finset.sum_sub_distrib]
  -- expand `f₂` in the remaining term
  have hf₂ : ∀ j, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a) f₂ =
      pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a) (czGood hΩ F f₂) +
      ∑ a' ∈ F.filter (fun a' => j ≤ a'.1),
        pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a) (czB f₂ a') +
      pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a') +
      pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (czRem hΩ F f₂) := by
    intro j
    set X := ∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a
    have : F.filter (fun a' => ¬ j ≤ a'.1) = F.filter (fun a' => a'.1 < j) := by
      congr 1; funext a'; simp
    conv_lhs => rw [hd₂]
    rw [show czBad F f₂ = ∑ a ∈ F, czB f₂ a from rfl,
      ← Finset.sum_filter_add_sum_filter_not F (fun a' => j ≤ a'.1), this,
      map_add (pairingOp hT hp hq j X), map_add (pairingOp hT hp hq j X),
      map_add (pairingOp hT hp hq j X), map_sum (pairingOp hT hp hq j X)]
    ring
  rw [Finset.sum_congr rfl fun j _ => hf₂ j]
  simp only [Finset.sum_add_distrib]
  -- the `g₂` part: `III₁ - ∑ III₂`
  have hg : ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
      (czGood hΩ F f₂) = ∑ j ∈ J, pairingOp hT hp hq j (∑ a ∈ F, czB f₁ a) (czGood hΩ F f₂) -
        ∑ a ∈ F, ∑ j ∈ J.filter (· ≤ a.1), pairingOp hT hp hq j (czB f₁ a) (czGood hΩ F f₂) := by
    rw [hsBg]; ring
  rw [hg]
  ring

end Splitting

/-! ### §4.4: auxiliary facts for the inductive step -/

section StepAux

variable {𝕜 : Type*} [RCLike 𝕜]

/-- Simple functions are bounded. -/
theorem SimpleCpt.exists_norm_le {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]
    (f : SimpleCpt d 𝕜 B) : ∃ M : ℝ, 0 ≤ M ∧ ∀ x, ‖f x‖ ≤ M := by
  refine ⟨∑ b ∈ (f : SimpleFunc (Rd d) B).range, ‖b‖, Finset.sum_nonneg fun _ _ => norm_nonneg _,
    fun x => ?_⟩
  exact Finset.single_le_sum (f := fun b => ‖b‖) (fun _ _ => norm_nonneg _)
    (SimpleFunc.mem_range_self _ x)

/-- `‖f 1_S‖_r ≤ M |S|^{1/r}` for `|f| ≤ M`. -/
theorem eLpNorm_restrict_le {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]
    (f : SimpleCpt d 𝕜 B) {S : Set (Rd d)} (hS : MeasurableSet S) {M : ℝ} (hM : 0 ≤ M)
    (hfM : ∀ x, ‖f x‖ ≤ M) {r : ℝ} (hr : 0 < r) :
    eLpNorm (SimpleCpt.restrict f hS) (.ofReal r) volume ≤
      ENNReal.ofReal M * volume S ^ (1 / r) := by
  have h := eLpNorm_indicator_const (c := M) hS.nullMeasurableSet (μ := volume)
    (p := .ofReal r) (by simpa using hr) ENNReal.ofReal_ne_top
  rw [ENNReal.toReal_ofReal hr.le, ← ofReal_norm, Real.norm_of_nonneg hM] at h
  rw [← h]
  refine eLpNorm_mono (SimpleCpt.aestronglyMeasurable _) fun x => ?_
  rw [SimpleCpt.restrict_apply]
  by_cases hx : x ∈ S
  · rw [indicator_of_mem hx, indicator_of_mem hx, Real.norm_of_nonneg hM]; exact hfM x
  · rw [indicator_of_notMem hx, indicator_of_notMem hx, norm_zero, norm_zero]

/-- Choosing `δ` so that `C δ^{1/r} ≤ η`. -/
theorem exists_delta {C : ℝ≥0∞} (hC : C ≠ ∞) {η : ℝ≥0∞} (hη : 0 < η) {r : ℝ} (hr : 0 < r) :
    ∃ δ : ℝ≥0∞, 0 < δ ∧ ∀ x ≤ δ, C * x ^ (1 / r) ≤ η := by
  by_cases hηtop : η = ∞
  · exact ⟨1, one_pos, fun _ _ => hηtop ▸ le_top⟩
  set y := η / (C + 1) with hy
  have hy0 : 0 < y := ENNReal.div_pos hη.ne' (by simp [hC])
  have hytop : y ≠ ∞ := ENNReal.div_ne_top hηtop (by simp)
  refine ⟨y ^ r, ENNReal.rpow_pos hy0 hytop, fun x hx => ?_⟩
  calc C * x ^ (1 / r) ≤ C * (y ^ r) ^ (1 / r) := by gcongr
    _ = C * y := by rw [one_div, ENNReal.rpow_rpow_inv hr.ne']
    _ ≤ (C + 1) * y := by gcongr; exact le_self_add
    _ = η := ENNReal.mul_div_cancel (by simp) (by simp [hC])

variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

/-- Finite subfamilies of the Whitney family exhaust `Ω` in measure. -/
theorem exists_finset_whitney_approx (hI : IsWhitneyIndex Ω I) (hΩfin : volume Ω ≠ ∞)
    {δ : ℝ≥0∞} (hδ : 0 < δ) :
    ∃ F : Finset (ℤ × (Fin d → ℤ)), (∀ a ∈ F, a ∈ I) ∧
      volume (Ω \ ⋃ a ∈ F, (qcube a : Set (Rd d))) < δ := by
  classical
  rcases I.eq_empty_or_nonempty with hIe | hIne
  · refine ⟨∅, by simp, ?_⟩
    have : Ω = ∅ := by rw [← hI.iUnion_eq, hIe]; simp
    rw [this]; simpa using hδ
  obtain ⟨e, he⟩ := (Set.to_countable I).exists_eq_range hIne
  let s : ℕ → Set (Rd d) := fun n => (qcube (e n) : Set (Rd d))
  have hU : ⋃ n, s n = Ω := by
    rw [← hI.iUnion_eq, he]
    ext x
    simp [s]
  have hsup : volume Ω = ⨆ n, volume (accumulate s n) := by
    rw [← hU, measure_iUnion_eq_iSup_accumulate]
  have hex : ∃ n, volume Ω < volume (accumulate s n) + δ := by
    by_cases hδtop : δ = ∞
    · exact ⟨0, by rw [hδtop, add_top]; exact hΩfin.lt_top⟩
    by_cases h0 : volume Ω = 0
    · exact ⟨0, by rw [h0]; exact lt_of_lt_of_le hδ le_add_self⟩
    have hlt := ENNReal.sub_lt_self hΩfin h0 hδ.ne'
    conv_rhs at hlt => rw [hsup]
    obtain ⟨n, hn⟩ := lt_iSup_iff.1 hlt
    exact ⟨n, ENNReal.lt_add_of_sub_lt_right (Or.inl hΩfin) hn⟩
  obtain ⟨n, hn⟩ := hex
  refine ⟨(Finset.range (n + 1)).image e, fun a ha => ?_, ?_⟩
  · obtain ⟨k, _, rfl⟩ := Finset.mem_image.1 ha
    rw [he]; exact ⟨k, rfl⟩
  · have hacc : ⋃ a ∈ (Finset.range (n + 1)).image e, (qcube a : Set (Rd d)) =
        accumulate s n := by
      ext x
      simp only [mem_iUnion, exists_prop, Finset.mem_image, Finset.mem_range, mem_accumulate, s]
      constructor
      · rintro ⟨a, ⟨k, hk, rfl⟩, hx⟩; exact ⟨k, by omega, hx⟩
      · rintro ⟨k, hk, hx⟩; exact ⟨e k, ⟨k, by omega, rfl⟩, hx⟩
    rw [hacc]
    have hsub : accumulate s n ⊆ Ω := by
      rw [← hU]
      exact iUnion₂_subset fun k _ => subset_iUnion s k
    have hmeas : MeasurableSet (accumulate s n) := by
      rw [accumulate_def]
      exact MeasurableSet.iUnion fun k => MeasurableSet.iUnion fun _ => Cube.measurableSet _
    rw [measure_sdiff hsub hmeas.nullMeasurableSet
      (ne_top_of_le_ne_top hΩfin (measure_mono hsub))]
    rw [add_comm] at hn
    exact ENNReal.sub_lt_of_lt_add (measure_mono hsub) hn

open Classical in
/-- The union of sparse families in pairwise disjoint regions, together with an extra cube whose
set `E₀` avoids all regions, is sparse. -/
theorem isSparse_insert_biUnion {γ : ℝ} {ι : Type*} (A : Finset ι)
    (𝔖 : ι → Finset (Cube d)) (U : ι → Set (Rd d))
    (hsp : ∀ i ∈ A, IsSparse γ (𝔖 i : Set (Cube d)))
    (hU : ∀ i ∈ A, ∀ Q ∈ 𝔖 i, (Q : Set (Rd d)) ⊆ U i)
    (hdisj : ∀ i ∈ A, ∀ i' ∈ A, i ≠ i' → Disjoint (U i) (U i'))
    (Q₀ : Cube d) (E₀ : Set (Rd d)) (hE₀m : MeasurableSet E₀) (hE₀Q : E₀ ⊆ Q₀)
    (hE₀γ : ENNReal.ofReal γ * volume (Q₀ : Set (Rd d)) ≤ volume E₀)
    (hE₀U : ∀ i ∈ A, Disjoint E₀ (U i)) (hQ₀ : ∀ i ∈ A, Q₀ ∉ 𝔖 i) :
    IsSparse γ (((insert Q₀ (A.biUnion 𝔖)) : Finset (Cube d)) : Set (Cube d)) := by
  classical
  choose! E hE hEd using hsp
  refine ⟨fun Q => if Q = Q₀ then E₀ else ⋃ i ∈ A.filter (fun i => Q ∈ 𝔖 i), E i Q, ?_, ?_⟩
  · intro Q hQ
    simp only [Finset.coe_insert, mem_insert_iff, Finset.mem_coe, Finset.mem_biUnion] at hQ
    by_cases h0 : Q = Q₀
    · subst h0
      simp only [↓reduceIte]
      exact ⟨hE₀m, hE₀Q, hE₀γ⟩
    · rcases hQ with hQ | ⟨i, hi, hQi⟩
      · exact absurd hQ h0
      simp only [h0, ↓reduceIte]
      refine ⟨Finset.measurableSet_biUnion _ fun i' hi' =>
          (hE i' (Finset.mem_filter.1 hi').1 Q (Finset.mem_filter.1 hi').2).1,
        iUnion₂_subset fun i' hi' =>
          (hE i' (Finset.mem_filter.1 hi').1 Q (Finset.mem_filter.1 hi').2).2.1, ?_⟩
      refine (hE i hi Q hQi).2.2.trans (measure_mono ?_)
      exact subset_iUnion₂_of_subset i (Finset.mem_filter.2 ⟨hi, hQi⟩) subset_rfl
  · intro Q hQ Q' hQ' hne
    simp only [Function.onFun]
    simp only [Finset.coe_insert, mem_insert_iff, Finset.mem_coe, Finset.mem_biUnion] at hQ hQ'
    have hpiece : ∀ R, R ≠ Q₀ → ∀ i ∈ A, ∀ x ∈ ⋃ i ∈ A.filter (fun i => R ∈ 𝔖 i), E i R,
        x ∈ U i → R ∈ 𝔖 i ∧ x ∈ E i R := by
      intro R _ i hi x hx hxU
      obtain ⟨i', hi', hx'⟩ := mem_iUnion₂.1 hx
      have hi'' := Finset.mem_filter.1 hi'
      have hxU' : x ∈ U i' := hU i' hi''.1 R hi''.2 ((hE i' hi''.1 R hi''.2).2.1 hx')
      by_cases hii : i = i'
      · subst hii; exact ⟨hi''.2, hx'⟩
      · exact absurd hxU' (Set.disjoint_left.1 (hdisj i hi i' hi''.1 hii) hxU)
    rw [Set.disjoint_left]
    intro x hx hx'
    by_cases h0 : Q = Q₀
    · subst h0
      have h0' : Q' ≠ Q := Ne.symm hne
      simp only [↓reduceIte, h0'] at hx hx'
      obtain ⟨i, hi, hx''⟩ := mem_iUnion₂.1 hx'
      have hi' := Finset.mem_filter.1 hi
      exact Set.disjoint_left.1 (hE₀U i hi'.1) hx
        (hU i hi'.1 Q' hi'.2 ((hE i hi'.1 Q' hi'.2).2.1 hx''))
    · by_cases h0' : Q' = Q₀
      · subst h0'
        simp only [↓reduceIte, h0] at hx hx'
        obtain ⟨i, hi, hx''⟩ := mem_iUnion₂.1 hx
        have hi' := Finset.mem_filter.1 hi
        exact Set.disjoint_left.1 (hE₀U i hi'.1) hx'
          (hU i hi'.1 Q hi'.2 ((hE i hi'.1 Q hi'.2).2.1 hx''))
      · simp only [h0, h0', ↓reduceIte] at hx hx'
        obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 hx
        have hi' := Finset.mem_filter.1 hi
        have hxU : x ∈ U i := hU i hi'.1 Q hi'.2 ((hE i hi'.1 Q hi'.2).2.1 hxi)
        obtain ⟨hQ'i, hx'i⟩ := hpiece Q' h0' i hi'.1 x hx' hxU
        exact Set.disjoint_left.1 (hEd i hi'.1 hi'.2 hQ'i hne) hxi hx'i

/-- Dyadic subcubes of `Q₀` have their triples inside `3Q₀`. -/
theorem Cube.IsDyadicSubcube.triple_subset {Q R : Cube d} (h : Q.IsDyadicSubcube R) :
    (R.triple : Set (Rd d)) ⊆ Q.triple := by
  obtain ⟨l, hs, v, hv, hc⟩ := h
  intro x hx i
  have hxi := hx i
  have h2 : (1 : ℝ) ≤ 2 ^ l := one_le_pow₀ (by norm_num)
  have hRs : R.side * 2 ^ l = Q.side := by rw [hs]; field_simp
  have hvi : (v i : ℝ) + 1 ≤ 2 ^ l := by exact_mod_cast hv i
  have hRpos := R.side_pos
  have hRQ : R.side ≤ Q.side := by rw [← hRs]; nlinarith
  simp only [triple] at hxi ⊢
  rw [hc i] at hxi
  constructor
  · nlinarith [hxi.1, (Nat.cast_nonneg (v i) : (0 : ℝ) ≤ v i)]
  · nlinarith [hxi.2]

/-- `⟨f⟩_{S,r}` is monotone in `|f|`. -/
theorem avgNorm_mono {B B' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B']
    {f : Rd d → B} {g : Rd d → B'} (h : ∀ x, ‖f x‖ ≤ ‖g x‖) (S : Set (Rd d)) {r : ℝ}
    (hr : 0 < r) : avgNorm f S r ≤ avgNorm g S r := by
  unfold avgNorm
  refine ENNReal.rpow_le_rpow ?_ (one_div_nonneg.2 hr.le)
  refine mul_le_mul_right (lintegral_mono fun x => ENNReal.rpow_le_rpow ?_ hr.le) _
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (h x)

theorem frakG_mono {B B' B'' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B']
    [NormedAddCommGroup B''] {γ p r : ℝ} (hr : 0 < r) (Q₀ : Cube d) (f₁ : Rd d → B)
    {f₂ : Rd d → B'} {g₂ : Rd d → B''} (h : ∀ x, ‖f₂ x‖ ≤ ‖g₂ x‖) :
    frakG γ p r Q₀ f₁ f₂ ≤ frakG γ p r Q₀ f₁ g₂ :=
  iSup_mono fun _ => iSup_mono fun _ => iSup_mono fun _ =>
    Finset.sum_le_sum fun _Q _ => mul_le_mul_right (avgNorm_mono h _ hr) _

/-- Bookkeeping for sums of suprema: if `C + ∑_{i ∈ s} f_i(g_i) ≤ D` for every admissible choice
`g`, then `C + ∑_{i ∈ s} sup_{x admissible} f_i(x) ≤ D`. -/
theorem add_sum_biSup_le {ι α : Type*} (s : Finset ι) (P : ι → α → Prop)
    (f : ι → α → ℝ≥0∞) (hne : ∀ i, ∃ x, P i x) {D : ℝ≥0∞} :
    ∀ C : ℝ≥0∞, (∀ g : ι → α, (∀ i, P i (g i)) → C + ∑ i ∈ s, f i (g i) ≤ D) →
      C + ∑ i ∈ s, ⨆ (x : α) (_ : P i x), f i x ≤ D := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro C h
    choose g hg using hne
    simpa using h g hg
  | insert i s hi ih =>
    intro C h
    rw [Finset.sum_insert hi, iSup_subtype']
    have : Nonempty {x // P i x} := let ⟨x, hx⟩ := hne i; ⟨⟨x, hx⟩⟩
    rw [ENNReal.iSup_add, ENNReal.add_iSup]
    refine iSup_le fun x => ?_
    rw [← add_assoc]
    refine ih _ fun g hg => ?_
    have h' := h (Function.update g i x.1) fun j => by
      by_cases hj : j = i
      · subst hj; simpa using x.2
      · rw [Function.update_of_ne hj]; exact hg j
    rw [Finset.sum_insert hi, Function.update_self] at h'
    rw [add_assoc]
    convert h' using 3
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [Function.update_of_ne (fun h : j = i => hi (h ▸ hj))]

theorem isSparse_empty (γ : ℝ) : IsSparse γ (∅ : Set (Cube d)) :=
  ⟨fun _ => ∅, by simp, by simp⟩

/-- **The sparse family of the inductive step**: `{Q₀} ∪ ⋃_W 𝔖_W` is `γ`-sparse, which gives
`|Q₀| ⟨f₁⟩_{Q₀,p} ⟨f₂⟩_{3Q₀,r} + ∑_W 𝔊_W(g_W, f₂) ≤ 𝔊_{Q₀}(f₁, f₂)` for `|g_W| ≤ |f₁|`. -/
theorem frakG_step {B B' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B']
    (hI : IsWhitneyIndex Ω I) {γ : ℝ} (hγ0 : 0 < γ) (hγ1 : γ < 1) {M : ℤ} {t₀ : Fin d → ℤ}
    (hΩm : MeasurableSet Ω)
    (hvol : volume Ω < ENNReal.ofReal (1 - γ) * volume ((protoGrid d).cube M t₀ : Set (Rd d)))
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (hFL : ∀ a ∈ F, a.1 ≤ M)
    (hFQ : ∀ a ∈ F, (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube M t₀)
    {p r : ℝ} (hp : 0 < p) (f₁ : Rd d → B) (g : ℤ × (Fin d → ℤ) → Rd d → B)
    (hg : ∀ a x, ‖g a x‖ ≤ ‖f₁ x‖) (f₂ : Rd d → B') :
    volume ((protoGrid d).cube M t₀ : Set (Rd d)) * avgNorm f₁ ((protoGrid d).cube M t₀) p *
        avgNorm f₂ ((protoGrid d).cube M t₀).triple r +
      ∑ a ∈ F, frakG γ p r (qcube a) (g a) f₂ ≤
      frakG γ p r ((protoGrid d).cube M t₀) f₁ f₂ := by
  classical
  set Q₀ := (protoGrid d).cube M t₀ with hQ₀
  have hsubΩ : ∀ a ∈ I, (qcube a : Set (Rd d)) ⊆ Ω := fun a ha => by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  let P : ℤ × (Fin d → ℤ) → Finset (Cube d) → Prop := fun a 𝔖 =>
    (∀ Q ∈ 𝔖, (qcube a).IsDyadicSubcube Q) ∧ IsSparse γ (𝔖 : Set (Cube d))
  have hrw : ∀ a, frakG γ p r (qcube a) (g a) f₂ = ⨆ (𝔖 : Finset (Cube d)) (_ : P a 𝔖),
      ∑ Q ∈ 𝔖, volume (Q : Set (Rd d)) * avgNorm (g a) Q p * avgNorm f₂ Q.triple r := by
    intro a; simp only [frakG, P, iSup_and]
  rw [Finset.sum_congr rfl fun a _ => hrw a]
  refine add_sum_biSup_le F P _ (fun a => ⟨∅, by simp, by simpa using isSparse_empty γ⟩) _
    fun 𝔖 hP => ?_
  have hvolQ : volume Ω < volume (Q₀ : Set (Rd d)) := hvol.trans_le
    (mul_le_of_le_one_left zero_le (ENNReal.ofReal_le_one.2 (by linarith)))
  have hQ₀ : ∀ a ∈ F, Q₀ ∉ 𝔖 a := fun a ha h => by
    have := measure_mono (μ := volume) (((hP a).1 Q₀ h).subset.trans (hsubΩ a (hFI a ha)))
    exact absurd hvolQ (not_lt.2 this)
  have hQ₀' : Q₀ ∉ F.biUnion 𝔖 := fun h => by
    obtain ⟨a, ha, h⟩ := Finset.mem_biUnion.1 h; exact hQ₀ a ha h
  have hdisj : (F : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint 𝔖 := by
    intro a ha a' ha' hne
    rw [Function.onFun, Finset.disjoint_left]
    intro Q hQ hQ'
    obtain ⟨x, hx⟩ := Q.nonempty
    exact Set.disjoint_left.1 (hI.disjoint a (hFI a ha) a' (hFI a' ha') hne)
      (((hP a).1 Q hQ).subset hx) (((hP a').1 Q hQ').subset hx)
  have hdy : ∀ Q ∈ insert Q₀ (F.biUnion 𝔖), Q₀.IsDyadicSubcube Q := by
    intro Q hQ
    rcases Finset.mem_insert.1 hQ with rfl | hQ
    · exact ⟨0, Cube.IsDyadicSubcubeAt.refl _⟩
    · obtain ⟨a, ha, hQa⟩ := Finset.mem_biUnion.1 hQ
      have hne : ((qcube a : Set (Rd d)) ∩ Q₀).Nonempty := by
        obtain ⟨x, hx⟩ := (qcube a).nonempty; exact ⟨x, hx, hFQ a ha hx⟩
      exact ((protoGrid d).isDyadicSubcube_of_inter (hFL a ha) hne).trans ((hP a).1 Q hQa)
  have hE₀ : ENNReal.ofReal γ * volume (Q₀ : Set (Rd d)) ≤ volume ((Q₀ : Set (Rd d)) \ Ω) := by
    refine le_trans ?_ (le_measure_sdiff)
    have hQtop := Q₀.volume_ne_top
    refine ENNReal.le_sub_of_add_le_right (ne_top_of_lt hvolQ) ?_
    calc ENNReal.ofReal γ * volume (Q₀ : Set (Rd d)) + volume Ω
        ≤ ENNReal.ofReal γ * volume (Q₀ : Set (Rd d)) +
          ENNReal.ofReal (1 - γ) * volume (Q₀ : Set (Rd d)) := by gcongr
      _ = volume (Q₀ : Set (Rd d)) := by
        rw [← add_mul, ← ENNReal.ofReal_add hγ0.le (by linarith)]
        norm_num
  have hsp := isSparse_insert_biUnion F 𝔖 (fun a => (qcube a : Set (Rd d)))
    (fun a _ => (hP a).2) (fun a _ Q hQ => ((hP a).1 Q hQ).subset)
    (fun a ha a' ha' hne => hI.disjoint a (hFI a ha) a' (hFI a' ha') hne) Q₀ _
    (Q₀.measurableSet.diff hΩm) sdiff_subset hE₀
    (fun a ha => Set.disjoint_left.2 fun x hx hxa => hx.2 (hsubΩ a (hFI a ha) hxa)) hQ₀
  refine le_trans ?_ (le_frakG _ hdy hsp)
  rw [Finset.sum_insert hQ₀', Finset.sum_biUnion hdisj]
  gcongr with a _ Q _
  exact avgNorm_mono (hg a) _ hp

section PairingReductions

variable {𝕜 : Type*} [RCLike 𝕜] {B₂ : Type*} [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂]

theorem pairing_eq_restrict {F : Rd d → B₂} {S : Set (Rd d)} (hS : MeasurableSet S)
    (hF : ∀ᵐ y ∂volume, y ∉ S → F y = 0) (g : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing F ⇑g = pairing F ⇑(SimpleCpt.restrict g hS) := by
  unfold pairing
  refine integral_congr_ae ?_
  filter_upwards [hF] with y hy
  rw [SimpleCpt.restrict_apply]
  by_cases hyS : y ∈ S
  · rw [indicator_of_mem hyS]
  · rw [hy hyS, map_zero, map_zero]

theorem pairing_eq_zero_of_left {F : Rd d → B₂} (hF : F =ᵐ[volume] 0)
    (g : Rd d → StrongDual 𝕜 B₂) : pairing F g = 0 := by
  unfold pairing
  rw [integral_eq_zero_of_ae]
  filter_upwards [hF] with y hy
  rw [hy, Pi.zero_apply, map_zero]; rfl

theorem pairing_eq_zero_of_right (F : Rd d → B₂) {g : Rd d → StrongDual 𝕜 B₂}
    (hg : g =ᵐ[volume] 0) : pairing F g = 0 := by
  unfold pairing
  rw [integral_eq_zero_of_ae]
  filter_upwards [hg] with y hy
  rw [hy]; rfl

end PairingReductions

end StepAux

/-! ### §4.4: the constant of the inductive step -/

section StepConstant

/-- `c_r = (C_up Λ)^{1/r}`, so that `K_i = c_{r_i} ⟨f_i⟩` in (upperboundsWh). -/
noncomputable def cOne (d : ℕ) (γ r : ℝ) : ℝ := (upC d * omegaConst d γ) ^ (1 / r)

theorem cOne_nonneg {γ : ℝ} (hγ1 : γ < 1) (r : ℝ) : 0 ≤ cOne d γ r :=
  Real.rpow_nonneg (mul_nonneg upC_pos.le (omegaConst_pos hγ1).le) _

/-- The constant `K` of Claim 4.3: `U(n) ≤ K 𝒞` for all `n`. -/
noncomputable def Kstep (d : ℕ) (p q ε γ : ℝ) : ℝ :=
  q * 3 ^ d * (cOne d γ p + cOne d γ p * cOne d γ q.conjExponent) +
    2 * (p / (p - 1)) * 3 ^ d * (cOne d γ q.conjExponent + cOne d γ p * cOne d γ q.conjExponent) +
    4 * 2 ^ d * (8 * wδ d) ^ d * (cOne d γ p * cOne d γ q.conjExponent) / Real.log 2 +
    cOne d γ p * cOne d γ q.conjExponent * cIV d ε

theorem cIV_nonneg {ε : ℝ} (hε : 0 < ε) : 0 ≤ cIV d ε := by
  have h1 : 0 < 1 - (2 : ℝ) ^ (-ε) := by
    have : (2 : ℝ) ^ (-ε) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
    linarith
  have hK := Kreg_nonneg d hε
  have hl := Real.log_pos (by norm_num : (1 : ℝ) < 2)
  unfold cIV
  positivity

theorem ofReal_one_add_three_pow : ENNReal.ofReal (1 + 3 ^ d) = 1 + 3 ^ d := by
  rw [ENNReal.ofReal_add (by norm_num) (by positivity), ENNReal.ofReal_one,
    ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_ofNat]

/-- Rewriting the `III₄` bound with real coefficients. -/
theorem III4_conv {ε A₀ Bc : ℝ} (hε : 0 < ε) (hA₀ : 0 ≤ A₀) (hB : 0 ≤ Bc)
    (K₁ K₂ V : ℝ≥0∞) (ℓ : ℕ) (S : Finset ℕ) :
    (4 * ENNReal.ofReal A₀ * K₁ * K₂ * (1 + 3 ^ d) * (1 + 3 ^ d) * ℓ +
        ∑ s ∈ S, 2 * ENNReal.ofReal (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) * K₁ * K₂ *
          (1 + 3 ^ d) * ((1 + 3 ^ d) * (1 + s))) * V =
      K₁ * K₂ * ENNReal.ofReal (4 * A₀ * (1 + 3 ^ d) ^ 2 * (ℓ : ℝ) +
        2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (Bc + A₀) *
          ∑ s ∈ S, (2 : ℝ) ^ (-ε * s) * (1 + s)) * V := by
  have hK := Kreg_nonneg d hε
  have hk : ∀ s : ℕ, 0 ≤ Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s) := fun s => by positivity
  have hc : (0 : ℝ) ≤ 2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (Bc + A₀) := by positivity
  rw [Finset.mul_sum, ENNReal.ofReal_add (by positivity)
    (Finset.sum_nonneg fun s _ => by positivity),
    ENNReal.ofReal_sum_of_nonneg fun s _ => by positivity, mul_add (K₁ * K₂),
    Finset.mul_sum S _ (K₁ * K₂)]
  congr 1
  congr 1
  · rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_pow (by positivity),
      ofReal_one_add_three_pow, ENNReal.ofReal_natCast, ENNReal.ofReal_ofNat]
    ring
  · refine Finset.sum_congr rfl fun s _ => ?_
    rw [show 2 * (1 + 3 ^ d) ^ 2 * Kreg d ε * (Bc + A₀) * ((2 : ℝ) ^ (-ε * s) * (1 + s)) =
        (2 * (1 + 3 ^ d) ^ 2) * (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)) * (1 + s) by ring,
      ENNReal.ofReal_mul (p := 2 * (1 + 3 ^ d) ^ 2 * (Kreg d ε * (Bc + A₀) * (2 : ℝ) ^ (-ε * s)))
        (mul_nonneg (by positivity) (hk s)),
      ENNReal.ofReal_mul (p := 2 * (1 + 3 ^ d) ^ 2) (by positivity),
      ENNReal.ofReal_mul (p := 2) (by norm_num),
      ENNReal.ofReal_pow (by positivity : (0 : ℝ) ≤ 1 + 3 ^ d),
      ofReal_one_add_three_pow, ENNReal.ofReal_ofNat,
      ENNReal.ofReal_add (by norm_num) (by positivity), ENNReal.ofReal_one,
      ENNReal.ofReal_natCast]
    ring

/-- The real coefficients of all terms are at most `K 𝒞`. -/
theorem coeff_sum_le {p q ε γ Ap Aq A₀ Bc : ℝ} (hp : 1 < p) (hq : 0 ≤ q) (hε : 0 < ε) (hγ1 : γ < 1)
    (hAp : 0 ≤ Ap) (hAq : 0 ≤ Aq) (hA₀ : 0 < A₀) (hB : 0 ≤ Bc) :
    Aq * q * 3 ^ d * cOne d γ p + Aq * q * 3 ^ d * (cOne d γ p * cOne d γ q.conjExponent) +
      2 * (p / (p - 1)) * Ap * 3 ^ d * cOne d γ q.conjExponent +
      2 * (p / (p - 1)) * Ap * 3 ^ d * (cOne d γ p * cOne d γ q.conjExponent) +
      4 * 2 ^ d * (8 * wδ d) ^ d * A₀ * (cOne d γ p * cOne d γ q.conjExponent) +
      cOne d γ p * cOne d γ q.conjExponent * (cIV d ε * (A₀ * Real.log (2 + Bc / A₀))) ≤
      Kstep d p q ε γ * constC Ap Aq A₀ Bc := by
  have hc₁ := cOne_nonneg (d := d) hγ1 p
  have hc₂ := cOne_nonneg (d := d) hγ1 q.conjExponent
  have hl2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
  have hL : Real.log 2 ≤ Real.log (2 + Bc / A₀) :=
    Real.log_le_log (by norm_num) (by have := div_nonneg hB hA₀.le; linarith)
  have hIV := cIV_nonneg (d := d) hε
  have hp' : 0 ≤ p / (p - 1) := div_nonneg (by linarith) (by linarith)
  unfold Kstep constC
  set c₁ := cOne d γ p
  set c₂ := cOne d γ q.conjExponent
  set L := Real.log (2 + Bc / A₀)
  set C := Ap + Aq + A₀ * L with hC
  have hA₀L : 0 ≤ A₀ * L := mul_nonneg hA₀.le (hl2.le.trans hL)
  have hAqC : Aq ≤ C := by linarith
  have hApC : Ap ≤ C := by linarith
  have hA₀C : A₀ * L ≤ C := by linarith
  have hA₀l : A₀ * Real.log 2 ≤ C := (mul_le_mul_of_nonneg_left hL hA₀.le).trans hA₀C
  have hk3 : 0 ≤ 4 * 2 ^ d * (8 * wδ d) ^ d * (c₁ * c₂) := by
    have := wδ_pos (d := d); positivity
  have h1 : Aq * (q * 3 ^ d * c₁) ≤ C * (q * 3 ^ d * c₁) :=
    mul_le_mul_of_nonneg_right hAqC (by positivity)
  have h2 : Aq * (q * 3 ^ d * (c₁ * c₂)) ≤ C * (q * 3 ^ d * (c₁ * c₂)) :=
    mul_le_mul_of_nonneg_right hAqC (by positivity)
  have h3 : Ap * (2 * (p / (p - 1)) * 3 ^ d * c₂) ≤ C * (2 * (p / (p - 1)) * 3 ^ d * c₂) :=
    mul_le_mul_of_nonneg_right hApC (by positivity)
  have h4 : Ap * (2 * (p / (p - 1)) * 3 ^ d * (c₁ * c₂)) ≤
      C * (2 * (p / (p - 1)) * 3 ^ d * (c₁ * c₂)) :=
    mul_le_mul_of_nonneg_right hApC (by positivity)
  have h5 : 4 * 2 ^ d * (8 * wδ d) ^ d * A₀ * (c₁ * c₂) ≤
      4 * 2 ^ d * (8 * wδ d) ^ d * (c₁ * c₂) / Real.log 2 * C := by
    rw [div_mul_eq_mul_div, le_div_iff₀ hl2]
    have := mul_le_mul_of_nonneg_left hA₀l hk3
    linarith
  have h6 : c₁ * c₂ * cIV d ε * (A₀ * L) ≤ c₁ * c₂ * cIV d ε * C :=
    mul_le_mul_of_nonneg_left hA₀C (by positivity)
  linarith

end StepConstant

/-! ### §4.4: the inductive step (proof of Claim 4.3) -/

section Step

variable {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁] [NormedSpace 𝕜 B₁]
  [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁]
  [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] [CompleteSpace B₂]
variable {T : ℤ → Op d 𝕜 B₁ B₂} {p q ε Ap Aq A₀ Bc : ℝ}
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

omit [CompleteSpace B₂] [CompleteSpace B₁] in
/-- The triangle inequality applied to the splitting `pairing_split`. -/
theorem split_enorm_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (J : Finset ℤ) (f₁ : SimpleCpt d 𝕜 B₁)
    (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    ‖pairing (psumOn T J f₁) ⇑f₂‖ₑ ≤
      ‖pairing (psumOn T J (czGood hΩ F f₁)) ⇑f₂‖ₑ +
      ‖pairing (psumOn T J (czRem hΩ F f₁)) ⇑f₂‖ₑ +
      (∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1)) (czF f₁ a)) ⇑f₂‖ₑ +
        ∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1))
          (condExp (protoGrid d) a.1 (czF f₁ a))) ⇑f₂‖ₑ) +
      (‖pairing (psumOn T J (czBad F f₁)) ⇑(czGood hΩ F f₂)‖ₑ +
        ∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1)) (czB f₁ a)) ⇑(czGood hΩ F f₂)‖ₑ) +
      ∑ j ∈ J, ∑ a' ∈ F, ∑ a ∈ F, (if a.1 < j ∧ j ≤ a'.1 then
        ‖pairing (T j (czB f₁ a)) (czB f₂ a')‖ₑ else 0) +
      ∑ j ∈ J, ‖pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (∑ a' ∈ F.filter (fun a' => a'.1 < j), czB f₂ a')‖ₑ +
      ∑ j ∈ J, ‖pairingOp hT hp hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (czRem hΩ F f₂)‖ₑ := by
  rw [pairing_split hT hp hq hI hΩ hFI J f₁ f₂]
  refine (enorm_add_le _ _).trans (add_le_add ?_ (enorm_sum_le _ _))
  refine (enorm_add_le _ _).trans (add_le_add ?_ (enorm_sum_le _ _))
  refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
  · refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
    · refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
      · exact enorm_add_le _ _
      · exact enorm_sub_le.trans (add_le_add (enorm_sum_le _ _) (enorm_sum_le _ _))
    · exact enorm_sub_le.trans (add_le_add le_rfl (enorm_sum_le _ _))
  · refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    refine (enorm_sum_le _ _).trans ?_
    rw [Finset.sum_filter]
    refine Finset.sum_le_sum fun a' _ => ?_
    split_ifs with h
    · rw [map_sum, LinearMap.sum_apply]
      refine (enorm_sum_le _ _).trans ?_
      rw [Finset.sum_filter]
      refine Finset.sum_le_sum fun a _ => ?_
      split_ifs with h' h'' <;> first | rfl | exact absurd ⟨h', h⟩ h'' | simp
    · exact zero_le

omit [NormedSpace ℝ B₁] [IsScalarTower ℝ 𝕜 B₁] [CompleteSpace B₁] [CompleteSpace B₂] in
/-- The first remainder (ErrorReport E5): `|⟨S r₁, f₂⟩| ≤ C_J M₁ |Ω ∖ ⋃ℱ|^{1/p} ‖f₂‖_{q'}`. -/
theorem rem1_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 0 < p) (hq : 1 < q)
    (hΩ : MeasurableSet Ω) (F : Finset (ℤ × (Fin d → ℤ))) (J : Finset ℤ)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {M₁ : ℝ} (hM₁ : 0 ≤ M₁)
    (hfM : ∀ x, ‖f₁ x‖ ≤ M₁) :
    ‖pairing (psumOn T J (czRem hΩ F f₁)) ⇑f₂‖ₑ ≤
      psumConst d p q A₀ J * (ENNReal.ofReal M₁ *
        volume (Ω \ ⋃ a ∈ F, (qcube a : Set (Rd d))) ^ (1 / p)) *
          eLpNorm f₂ (.ofReal q.conjExponent) volume := by
  refine (enorm_pairing_le (psumOn_aestronglyMeasurable hT J _)
    (SimpleCpt.aestronglyMeasurable f₂) hq).trans ?_
  gcongr
  refine (eLpNorm_psumOn_le hT hp hq.le J _).trans ?_
  gcongr
  exact eLpNorm_restrict_le f₁ _ hM₁ hfM hp

omit [CompleteSpace B₂] in
/-- The second remainder (ErrorReport E5):
`∑_j |⟨T_j b₁^{<j}, r₂⟩| ≤ C_J · 2 K₁ |Ω|^{1/p} · M₂ |Ω ∖ ⋃ℱ|^{1/q'}`. -/
theorem rem2_le (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p) (hq : 1 < q)
    (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (J : Finset ℤ)
    (f₁ : SimpleCpt d 𝕜 B₁) (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) {M₂ : ℝ} (hM₂ : 0 ≤ M₂)
    (hfM : ∀ x, ‖f₂ x‖ ≤ M₂) {τ₁ : ℝ≥0∞}
    (hτ₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁) :
    ∑ j ∈ J, ‖pairingOp hT (by linarith) hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
        (czRem hΩ F f₂)‖ₑ ≤
      psumConst d p q A₀ J * (2 * ((ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
        volume Ω ^ (1 / p))) * (ENNReal.ofReal M₂ *
          volume (Ω \ ⋃ a ∈ F, (qcube a : Set (Rd d))) ^ (1 / q.conjExponent)) := by
  have hpq := Real.HolderConjugate.conjExponent hq
  unfold psumConst
  rw [Finset.sum_mul, Finset.sum_mul]
  refine Finset.sum_le_sum fun j _ => ?_
  rw [pairingOp_apply]
  refine (enorm_pairing_le (hT.aestronglyMeasurable j _)
    (SimpleCpt.aestronglyMeasurable _) hq).trans ?_
  gcongr
  · refine (eLpNorm_op_le_of_singleScale (by linarith) (by linarith) (hT.aestronglyMeasurable j)
      (hT.singleScale j) _).trans ?_
    gcongr
    refine (eLpNorm_sum_czB_le' hI (fun a ha => hFI a (Finset.mem_filter.1 ha).1) f₁ hp.le
      hτ₁).trans ?_
    gcongr
    exact sum_volume_le_of_subset hI (fun a ha => hFI a (Finset.mem_filter.1 ha).1)
      fun a ha => by
        rw [← hI.iUnion_eq]
        exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d)))
          (hFI a (Finset.mem_filter.1 ha).1)
  · exact eLpNorm_restrict_le f₂ _ hM₂ hfM hpq.symm.pos

theorem ofReal_add6 {a b c e f g : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (he : 0 ≤ e)
    (hf : 0 ≤ f) (hg : 0 ≤ g) :
    ENNReal.ofReal a + ENNReal.ofReal b + ENNReal.ofReal c + ENNReal.ofReal e +
      ENNReal.ofReal f + ENNReal.ofReal g = ENNReal.ofReal (a + b + c + e + f + g) := by
  rw [ENNReal.ofReal_add (p := a + b + c + e + f) (by linarith) hg,
    ENNReal.ofReal_add (p := a + b + c + e) (by linarith) hf,
    ENNReal.ofReal_add (p := a + b + c) (by linarith) he,
    ENNReal.ofReal_add (p := a + b) (by linarith) hc, ENNReal.ofReal_add ha hb]

omit [CompleteSpace B₂] in
/-- **The inductive step** (proof of Claim 4.3, §4.4) for `f₂` supported in `3Q₀`. -/
theorem step_core (hd : 0 < d) (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p)
    (hpq : p ≤ q) (hε : 0 < ε) {γ : ℝ} (hγ0 : 0 < γ) (hγ1 : γ < 1) (hAp : 0 ≤ Ap)
    (hAq : 0 ≤ Aq) (hA₀ : 0 < A₀) (hB : 0 ≤ Bc) {KC : ℝ}
    (hKC : Kstep d p q ε γ * constC Ap Aq A₀ Bc ≤ KC) {n : ℕ}
    (IH : ∀ m < n, InductionStatement T γ p q KC m) {N₁ N₂ M : ℤ} (hN : N₁ ≤ N₂)
    (hN₂ : N₂ ≤ M) (hn : (M - N₁).toNat ≤ n) (t₀ : Fin d → ℤ) (f₁ : SimpleCpt d 𝕜 B₁)
    (hf₁ : Function.support ⇑f₁ ⊆ ((protoGrid d).cube M t₀ : Set (Rd d)))
    (f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂))
    (hf₂ : Function.support ⇑f₂ ⊆ (((protoGrid d).cube M t₀).triple : Set (Rd d))) :
    ‖pairing (psum T N₁ N₂ f₁) f₂‖ₑ ≤
      ENNReal.ofReal KC * frakG γ p q.conjExponent ((protoGrid d).cube M t₀) f₁ f₂ := by
  classical
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  have hpq' := Real.HolderConjugate.conjExponent hq
  have hp0 : 0 < p := by linarith
  have hr0 : 0 < q.conjExponent := hpq'.symm.pos
  have hr1 : 1 ≤ q.conjExponent := hpq'.symm.lt.le
  set Q₀ := (protoGrid d).cube M t₀ with hQ₀
  set r := q.conjExponent with hr
  set J := Finset.Icc N₁ N₂ with hJ
  -- the degenerate cases
  by_cases h₁ : avgNorm f₁ Q₀ p = 0
  · have he : eLpNorm f₁ (.ofReal p) volume = 0 := by
      rw [eLpNorm_eq_of_support Q₀ f₁ hf₁ hp0, h₁, mul_zero]
    have hS : eLpNorm (psumOn T J f₁) (.ofReal q) volume = 0 :=
      le_antisymm ((eLpNorm_psumOn_le hT hp0 hq.le J f₁).trans (by rw [he, mul_zero])) zero_le
    rw [eLpNorm_eq_zero_iff (by simp; linarith)] at hS
    rw [psum_eq_psumOn, pairing_eq_zero_of_left hS]
    simp
  by_cases h₂ : avgNorm f₂ Q₀.triple r = 0
  · have he : eLpNorm f₂ (.ofReal r) volume = 0 :=
      le_antisymm ((eLpNorm_le_of_support_triple Q₀ f₂ hf₂ hr1).trans (by rw [h₂]; simp))
        zero_le
    refine le_trans ?_ zero_le
    refine (enorm_pairing_le (psumOn_aestronglyMeasurable hT J f₁)
      (SimpleCpt.aestronglyMeasurable f₂) hq).trans (le_of_eq ?_)
    rw [he, mul_zero]
  -- the exceptional set and the Whitney family
  obtain ⟨Ω, hΩo, hvol, hΩ⟩ := exists_exceptionalSet Q₀ hf₁ hf₂ hp0 hr0 hγ1 h₁ h₂
  have hΩm := hΩo.measurableSet
  have hΛ := (omegaConst_pos (d := d) hγ1).le
  set a₁ := avgNorm f₁ Q₀ p with ha₁
  set a₂ := avgNorm f₂ Q₀.triple r with ha₂
  set τ₁ := ENNReal.ofReal (omegaConst d γ) * a₁ ^ p with hτ₁
  set τ₂ := ENNReal.ofReal (omegaConst d γ) * a₂ ^ r with hτ₂
  have ha₁top : a₁ ≠ ∞ := SimpleCpt.avgNorm_ne_top f₁ Q₀ hp0
  have ha₂top : a₂ ≠ ∞ := SimpleCpt.avgNorm_ne_top f₂ Q₀.triple hr0
  have hτ₁top : τ₁ ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.rpow_ne_top_of_nonneg hp0.le ha₁top)
  have hτ₂top : τ₂ ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.rpow_ne_top_of_nonneg hr0.le ha₂top)
  have hmax₁ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤ τ₁ :=
    fun z hz => (hΩ z hz).1.1
  have hpt₁ : ∀ z ∉ Ω, ‖f₁ z‖ₑ ^ p ≤ τ₁ := fun z hz => (hΩ z hz).1.2
  have hmax₂ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ r) z ≤ τ₂ :=
    fun z hz => (hΩ z hz).2.1
  have hpt₂ : ∀ z ∉ Ω, ‖f₂ z‖ₑ ^ r ≤ τ₂ := fun z hz => (hΩ z hz).2.2
  have hvolQ : volume Ω < volume (Q₀ : Set (Rd d)) := hvol.trans_le
    (mul_le_of_le_one_left zero_le (ENNReal.ofReal_le_one.2 (by linarith)))
  have hΩc : Ωᶜ.Nonempty := by
    by_contra h
    rw [Set.not_nonempty_iff_eq_empty, Set.compl_empty_iff] at h
    rw [h] at hvolQ
    exact absurd (measure_mono (μ := volume) (subset_univ (Q₀ : Set (Rd d)))) (not_le.2 hvolQ)
  obtain ⟨I, hI⟩ := exists_whitneyIndex hd hΩo hΩc
  have hsubΩ : ∀ a ∈ I, (qcube a : Set (Rd d)) ⊆ Ω := fun a ha => by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  have hWQ : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ Q₀).Nonempty → (qcube a : Set (Rd d)) ⊆ Q₀ :=
    fun a ha hne => (whitney_subset_of_inter hI ha hvolQ hne).2
  have hWQ3 : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ Q₀.triple).Nonempty →
      (qcube a : Set (Rd d)) ⊆ Q₀.triple :=
    fun a ha hne => (whitney_subset_triple hI ha hvolQ hne).2
  -- the constants `K₁ = c₁ ⟨f₁⟩`, `K₂ = c₂ ⟨f₂⟩`
  have hK₁ : (ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) = ENNReal.ofReal (cOne d γ p) * a₁ :=
    K_eq hp0 hΛ a₁
  have hK₂ : (ENNReal.ofReal (upC d) * τ₂) ^ (1 / r) = ENNReal.ofReal (cOne d γ r) * a₂ :=
    K_eq hr0 hΛ a₂
  have hc₁ := cOne_nonneg (d := d) hγ1 p
  have hc₂ := cOne_nonneg (d := d) hγ1 r
  set c₁ := cOne d γ p with hc₁def
  set c₂ := cOne d γ r with hc₂def
  set X := volume (Q₀ : Set (Rd d)) * a₁ * a₂ with hX
  obtain ⟨M₁, hM₁, hfM₁⟩ := SimpleCpt.exists_norm_le f₁
  obtain ⟨M₂, hM₂, hfM₂⟩ := SimpleCpt.exists_norm_le f₂
  have hvolΩtop : volume Ω ≠ ∞ := ne_top_of_lt hvolQ
  -- the approximation parameter
  refine ENNReal.le_of_forall_pos_le_add fun η hη _ => ?_
  set CR1 := psumConst d p q A₀ J * ENNReal.ofReal M₁ * eLpNorm f₂ (.ofReal r) volume
  set CR2 := psumConst d p q A₀ J * (2 * ((ENNReal.ofReal (upC d) * τ₁) ^ (1 / p) *
    volume Ω ^ (1 / p))) * ENNReal.ofReal M₂
  have hCR1 : CR1 ≠ ∞ := ENNReal.mul_ne_top (ENNReal.mul_ne_top (psumConst_ne_top _ _ _ _)
    ENNReal.ofReal_ne_top) (SimpleCpt.eLpNorm_lt_top f₂ hr0).ne
  have hCR2 : CR2 ≠ ∞ := ENNReal.mul_ne_top (ENNReal.mul_ne_top (psumConst_ne_top _ _ _ _)
    (ENNReal.mul_ne_top ENNReal.ofNat_ne_top (ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg (by positivity)
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτ₁top))
      (ENNReal.rpow_ne_top_of_nonneg (by positivity) hvolΩtop)))) ENNReal.ofReal_ne_top
  have hη2 : (0 : ℝ≥0∞) < (η : ℝ≥0∞) / 2 :=
    ENNReal.half_pos (by exact_mod_cast hη.ne')
  obtain ⟨δ₁, hδ₁, hδ₁'⟩ := exists_delta hCR1 hη2 hp0
  obtain ⟨δ₂, hδ₂, hδ₂'⟩ := exists_delta hCR2 hη2 hr0
  obtain ⟨F, hFI, hFδ⟩ := exists_finset_whitney_approx hI hvolΩtop (lt_min hδ₁ hδ₂)
  set x := volume (Ω \ ⋃ a ∈ F, (qcube a : Set (Rd d))) with hx
  -- the remainders
  have hR1 : ‖pairing (psumOn T J (czRem hΩm F f₁)) ⇑f₂‖ₑ ≤ (η : ℝ≥0∞) / 2 := by
    refine (rem1_le hT hp0 hq hΩm F J f₁ f₂ hM₁ hfM₁).trans ?_
    refine le_trans (le_of_eq ?_) (hδ₁' x (hFδ.le.trans (min_le_left _ _)))
    ring
  have hR2 : ∑ j ∈ J, ‖pairingOp hT hp0 hq j (∑ a ∈ F.filter (fun a => a.1 < j), czB f₁ a)
      (czRem hΩm F f₂)‖ₑ ≤ (η : ℝ≥0∞) / 2 := by
    refine (rem2_le hT hp hq hI hΩm hFI J f₁ f₂ hM₂ hfM₂ hmax₁).trans ?_
    refine le_trans (le_of_eq ?_) (hδ₂' x (hFδ.le.trans (min_le_right _ _)))
    ring
  -- the terms `I_W`, by the induction hypothesis
  set F' := F.filter (fun a => (qcube a : Set (Rd d)) ⊆ Q₀) with hF'
  have hF'I : ∀ a ∈ F', a ∈ I := fun a ha => hFI a (Finset.mem_filter.1 ha).1
  have hF'Q : ∀ a ∈ F', (qcube a : Set (Rd d)) ⊆ Q₀ := fun a ha => (Finset.mem_filter.1 ha).2
  have hF'M : ∀ a ∈ F', a.1 < M := fun a ha => by
    obtain ⟨y, hy⟩ := (qcube a).nonempty
    exact (whitney_subset_of_inter hI (hF'I a ha) hvolQ ⟨y, hy, hF'Q a ha hy⟩).1
  have hIt : ∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1)) (czF f₁ a)) ⇑f₂‖ₑ ≤
      ENNReal.ofReal KC * ∑ a ∈ F', frakG γ p r (qcube a) ⇑(czF f₁ a) ⇑f₂ := by
    rw [← Finset.sum_filter_add_sum_filter_not F (fun a => (qcube a : Set (Rd d)) ⊆ Q₀),
      Finset.mul_sum]
    have h0 : ∑ a ∈ F.filter (fun a => ¬ (qcube a : Set (Rd d)) ⊆ Q₀),
        ‖pairing (psumOn T (J.filter (· ≤ a.1)) (czF f₁ a)) ⇑f₂‖ₑ = 0 := by
      refine Finset.sum_eq_zero fun a ha => ?_
      obtain ⟨haF, hna⟩ := Finset.mem_filter.1 ha
      have hz : czF f₁ a = 0 := by
        apply Subtype.ext; apply SimpleFunc.ext; intro y
        change (czF f₁ a) y = (0 : SimpleCpt d 𝕜 B₁) y
        rw [czF, SimpleCpt.restrict_apply, SimpleCpt.coe_zero', Pi.zero_apply]
        by_cases hy : y ∈ (qcube a : Set (Rd d))
        · rw [indicator_of_mem hy]
          exact Function.notMem_support.1 fun h =>
            hna (hWQ a (hFI a haF) ⟨y, hy, hf₁ h⟩)
        · rw [indicator_of_notMem hy]
      rw [hz]
      simp [psumOn, pairing]
    rw [h0, add_zero]
    refine Finset.sum_le_sum fun a ha => ?_
    have haM := hF'M a ha
    by_cases haN : N₁ ≤ a.1
    · rw [hJ, Icc_filter_le_eq, ← psum_eq_psumOn]
      refine IH (a.1 - N₁).toNat (by omega) N₁ (min N₂ a.1) a.1 (le_min hN haN)
        (min_le_right _ _) le_rfl a.2 (czF f₁ a) ?_ f₂
      rw [czF, SimpleCpt.restrict_apply]
      exact Set.support_indicator_subset
    · have he : J.filter (· ≤ a.1) = ∅ := by
        ext j; simp only [hJ, Finset.mem_filter, Finset.mem_Icc, Finset.notMem_empty, iff_false]
        omega
      rw [he]
      simp [psumOn, pairing]
  -- the main terms
  have hV : ∑ a ∈ F, volume (qcube a : Set (Rd d)) ≤ volume (Q₀ : Set (Rd d)) :=
    (sum_volume_le_of_subset hI hFI fun a ha => hsubΩ a (hFI a ha)).trans hvolQ.le
  have eG : ‖pairing (psumOn T J (czGood hΩm F f₁)) ⇑f₂‖ₑ ≤
      ENNReal.ofReal (Aq * q * 3 ^ d * c₁) * X := by
    refine (good_term_X hT hp hpq hN hI hΩm hFI Q₀ hf₁ hf₂ hWQ hτ₁top hmax₁ hpt₁).trans
      (le_of_eq ?_)
    rw [hK₁]
    simp (disch := positivity) only [ENNReal.ofReal_mul, ENNReal.ofReal_pow, ENNReal.ofReal_ofNat]
    ring
  have eII : ∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1))
      (condExp (protoGrid d) a.1 (czF f₁ a))) ⇑f₂‖ₑ ≤
      ENNReal.ofReal (Aq * q * 3 ^ d * (c₁ * c₂)) * X := by
    refine (II_term_X hT hp hpq hI hFI f₁ f₂ hτ₁top hτ₂top hmax₁ hmax₂).trans ?_
    rw [hK₁, hK₂]
    calc _ ≤ ENNReal.ofReal Aq * ENNReal.ofReal q * 3 ^ d * (ENNReal.ofReal c₁ * a₁) *
          (ENNReal.ofReal c₂ * a₂) * volume (Q₀ : Set (Rd d)) := by gcongr
      _ = _ := by
        simp (disch := positivity) only [ENNReal.ofReal_mul, ENNReal.ofReal_pow,
          ENNReal.ofReal_ofNat]
        ring
  have eIII1 : ‖pairing (psumOn T J (czBad F f₁)) ⇑(czGood hΩm F f₂)‖ₑ ≤
      ENNReal.ofReal (2 * (p / (p - 1)) * Ap * 3 ^ d * c₂) * X := by
    refine (III1_term_X hT hp hpq hN hI hΩm hFI Q₀ hf₁ hf₂ hWQ3 hτ₂top hmax₂ hpt₂).trans
      (le_of_eq ?_)
    rw [hK₂]
    have : 0 ≤ p / (p - 1) := div_nonneg (by linarith) (by linarith)
    simp (disch := positivity) only [ENNReal.ofReal_mul, ENNReal.ofReal_pow, ENNReal.ofReal_ofNat]
    ring
  have eIII2 : ∑ a ∈ F, ‖pairing (psumOn T (J.filter (· ≤ a.1)) (czB f₁ a))
      ⇑(czGood hΩm F f₂)‖ₑ ≤
      ENNReal.ofReal (2 * (p / (p - 1)) * Ap * 3 ^ d * (c₁ * c₂)) * X := by
    refine (III2_term_X hT hp hpq hI hΩm hFI Q₀ f₁ hf₂ hWQ3 hτ₂top hmax₁ hmax₂ hpt₂).trans ?_
    rw [hK₁, hK₂]
