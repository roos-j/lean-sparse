/-- **(Lrbounds-sumsb)**: `‖∑_{W ∈ ℱ'} b_W‖_r ≤ 2 ‖f 1_U‖_r`. -/
theorem eLpNorm_sum_czB_le (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) {r : ℝ} (hr : 1 ≤ r) :
