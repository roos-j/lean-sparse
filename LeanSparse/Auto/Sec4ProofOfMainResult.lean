/-- `‖f 1_U‖_r ≤ (C_up τ)^{1/r} |U|^{1/r}` for a union `U` of Whitney cubes. -/
theorem eLpNorm_indicator_union_le (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) {r : ℝ}
    (hr : 0 < r) {τ : ℝ≥0∞}
    (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ) :
    eLpNorm ((⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f) (.ofReal r) volume ≤
      (ENNReal.ofReal (upC d) * τ) ^ (1 / r) *
        volume (⋃ a ∈ F, (qcube a : Set (Rd d))) ^ (1 / r) := by
  have hr0 : ENNReal.ofReal r ≠ 0 := by simpa using hr
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hr0 ENNReal.ofReal_ne_top
    ((SimpleCpt.aestronglyMeasurable f).indicator (measurableSet_biUnion_qcube F)),
    ENNReal.toReal_ofReal hr.le, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  gcongr
  exact lintegral_rpow_indicator_union_le hI hFI hr hτ

