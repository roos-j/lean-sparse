theorem claim_4_3 (hd : 0 < d) (hT : BasicAssumptions T p q ε Ap Aq A₀ Bc) (hp : 1 < p)
    (hpq : p ≤ q) (hε : 0 < ε) {γ : ℝ} (hγ0 : 0 < γ) (hγ1 : γ < 1) (hAp : 0 ≤ Ap)
    (hAq : 0 ≤ Aq) (hA₀ : 0 < A₀) (hB : 0 ≤ Bc) {KC : ℝ}
    (hKC : Kstep d p q ε γ * constC Ap Aq A₀ Bc ≤ KC) (n : ℕ) :
    InductionStatement T γ p q KC n := by
  induction n using Nat.strong_induction_on with
  | _ n IH =>
  intro N₁ N₂ M hN hN₂ hn t₀ f₁ hf₁ f₂
  have hr0 : 0 < q.conjExponent :=
