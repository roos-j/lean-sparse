/-! ### Tools: Lorentz and weak-type estimates for bounded functions -/

section Tools

variable {B : Type*} [NormedAddCommGroup B]

/-- `‖F‖_{q,1} ≤ q M |E|^{1/q}` if `|F| ≤ M 1_E`. -/
theorem lorentzOneNorm_le_of_le_indicator {F : Rd d → B} {E : Set (Rd d)} {M : ℝ}
    (hF : ∀ x, ‖F x‖ ≤ E.indicator (fun _ => M) x) {q : ℝ} (hq : 0 < q) :
    lorentzOneNorm F q ≤ ENNReal.ofReal q * (ENNReal.ofReal M * volume E ^ (1 / q)) := by
  unfold lorentzOneNorm
  gcongr
  calc ∫⁻ t in Ioi (0 : ℝ), volume {x | t < ‖F x‖} ^ (1 / q)
      ≤ ∫⁻ t in Ioi (0 : ℝ), (Iio M).indicator (fun _ => volume E ^ (1 / q)) t := by
        refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
        have ht' : (0 : ℝ) < t := ht
        by_cases htM : t < M
        · rw [indicator_of_mem (show t ∈ Iio M from htM)]
          gcongr
          intro x hx
          by_contra hxE
          have h1 := hF x
          rw [indicator_of_notMem hxE] at h1
          have h2 : t < ‖F x‖ := hx
          linarith
        · rw [indicator_of_notMem (show t ∉ Iio M from htM)]
          have : {x | t < ‖F x‖} = ∅ := by
            ext x
            simp only [mem_ofPred_eq, mem_empty_iff_false, iff_false, not_lt]
            refine (hF x).trans ?_
            by_cases hx : x ∈ E
            · rw [indicator_of_mem hx]; exact not_lt.1 htM
            · rw [indicator_of_notMem hx]; linarith [not_lt.1 htM]
          rw [this, measure_empty, ENNReal.zero_rpow_of_pos (by positivity)]
    _ = ENNReal.ofReal M * volume E ^ (1 / q) := by
        rw [lintegral_indicator measurableSet_Iio, setLIntegral_const, Measure.restrict_apply
          measurableSet_Iio, inter_comm, Ioi_inter_Iio, Real.volume_Ioo, sub_zero, mul_comm]

/-- The distribution bound `t |{|F| > t}|^{1/p} ≤ ‖F‖_{p,∞}`. -/
theorem ofReal_mul_le_weakNorm (F : Rd d → B) (p : ℝ) {t : ℝ} (ht : 0 ≤ t) :
    ENNReal.ofReal t * volume {x | t < ‖F x‖} ^ (1 / p) ≤ weakNorm F p := by
  have h := le_iSup (fun s : ℝ≥0 => (s : ℝ≥0∞) * volume {x | (s : ℝ) < ‖F x‖} ^ (1 / p))
    t.toNNReal
  simp only [Real.coe_toNNReal _ ht] at h
  exact h

/-- If `‖F‖_{p,∞} = 0` then `F = 0` almost everywhere. -/
theorem ae_eq_zero_of_weakNorm_eq_zero {F : Rd d → B} {p : ℝ} (hp : 0 < p)
    (h : weakNorm F p = 0) : ∀ᵐ x ∂volume, F x = 0 := by
  have hnull : ∀ n : ℕ, volume {x | (1 / ((n : ℝ) + 1)) < ‖F x‖} = 0 := by
    intro n
    have h1 := ofReal_mul_le_weakNorm F p (t := 1 / ((n : ℝ) + 1)) (by positivity)
    rw [h, nonpos_iff_eq_zero, mul_eq_zero] at h1
    rcases h1 with h1 | h1
    · rw [ENNReal.ofReal_eq_zero] at h1
      have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
      linarith
    · exact (ENNReal.rpow_eq_zero_iff_of_pos (by positivity)).1 h1
  have hU : {x | ¬F x = 0} = ⋃ n : ℕ, {x | (1 / ((n : ℝ) + 1)) < ‖F x‖} := by
    ext x
    simp only [mem_ofPred_eq, mem_iUnion]
    constructor
    · intro hx
      exact exists_nat_one_div_lt (norm_pos_iff.2 hx)
    · rintro ⟨n, hn⟩ h0
      rw [h0, norm_zero] at hn
      exact absurd hn (not_lt.2 (by positivity))
  rw [ae_iff, hU]
  exact measure_iUnion_null hnull

/-- The real-variable identity behind Kolmogorov's inequality:
`α t₀ + w^p t₀^{1-p}/(p-1) = p/(p-1) w α^{1-1/p}` for `t₀ = w α^{-1/p}`. -/
theorem kolmogorov_identity {w α p : ℝ} (hw : 0 < w) (hα : 0 < α) (hp : 1 < p) :
    α * (w * α ^ (-(1 / p))) + w ^ p * ((w * α ^ (-(1 / p))) ^ (-p + 1) / (p - 1)) =
      p / (p - 1) * w * α ^ (1 - 1 / p) := by
  have hp0 : 0 < p := by linarith
  have hp1 : 0 < p - 1 := by linarith
  have e1 : w ^ p * (w * α ^ (-(1 / p))) ^ (-p + 1) = w * α ^ (1 - 1 / p) := by
    rw [Real.mul_rpow hw.le (by positivity), ← Real.rpow_mul hα.le, ← mul_assoc,
      ← Real.rpow_add hw, show p + (-p + 1) = 1 by ring, Real.rpow_one]
    congr 2
    field_simp
    ring
  have e2 : α * (w * α ^ (-(1 / p))) = w * α ^ (1 - 1 / p) := by
    rw [mul_left_comm, sub_eq_add_neg, Real.rpow_add hα, Real.rpow_one]
  rw [e2, ← mul_div_assoc, e1]
  field_simp
  ring

/-- **Kolmogorov's inequality**: `∫_E |F| ≤ p' ‖F‖_{p,∞} |E|^{1 - 1/p}` for `1 < p`. -/
theorem lintegral_enorm_le_weakNorm {F : Rd d → B} (hF : AEStronglyMeasurable F volume)
    {E : Set (Rd d)} (hEfin : volume E ≠ ∞) {p : ℝ} (hp : 1 < p) :
    ∫⁻ x in E, ‖F x‖ₑ ≤
      ENNReal.ofReal (p / (p - 1)) * weakNorm F p * volume E ^ (1 - 1 / p) := by
  set W := weakNorm F p with hW
  have hp0 : 0 < p := by linarith
  have hp1 : 0 < p - 1 := by linarith
  have hexp : 0 < 1 - 1 / p := by
    have : 1 / p < 1 := by rw [div_lt_one hp0]; exact hp
    linarith
  rcases eq_or_ne (volume E) 0 with hE0 | hE0
  · rw [Measure.restrict_eq_zero.2 hE0, lintegral_zero_measure]
    exact zero_le
  by_cases hWtop : W = ∞
  · rw [hWtop, ENNReal.mul_top (by simp [hp0, hp1]), ENNReal.top_mul
      (ENNReal.rpow_pos (pos_iff_ne_zero.2 hE0) hEfin).ne']
    exact le_top
  rcases eq_or_ne W 0 with hW0 | hW0
  · have hzero := ae_eq_zero_of_weakNorm_eq_zero hp0 (hW ▸ hW0)
    calc ∫⁻ x in E, ‖F x‖ₑ = ∫⁻ _x in E, 0 := by
          refine lintegral_congr_ae ?_
          filter_upwards [ae_restrict_of_ae hzero] with x hx
          simp [hx]
      _ ≤ _ := by simp
  -- the main case `0 < W < ∞`, `0 < |E| < ∞`
  set w := W.toReal with hw
  set α := (volume E).toReal with hα
  have hw0 : 0 < w := ENNReal.toReal_pos hW0 hWtop
  have hα0 : 0 < α := ENNReal.toReal_pos hE0 hEfin
  set t₀ := w * α ^ (-(1 / p)) with ht₀
  have ht₀0 : 0 < t₀ := by positivity
  have hlayer : ∫⁻ x in E, ‖F x‖ₑ = ∫⁻ t in Ioi 0, (volume.restrict E) {x | t < ‖F x‖} := by
    rw [← lintegral_eq_lintegral_meas_lt _ (Filter.Eventually.of_forall fun x => norm_nonneg _)
      hF.norm.aemeasurable.restrict]
    simp
  have hbound : ∀ t ∈ Ioi (0 : ℝ), (volume.restrict E) {x | t < ‖F x‖} ≤
      (Ioc 0 t₀).indicator (fun _ => volume E) t +
        (Ioi t₀).indicator (fun t => ENNReal.ofReal (w ^ p * t ^ (-p))) t := by
    intro t ht
    have ht' : (0 : ℝ) < t := ht
    by_cases htt : t ≤ t₀
    · rw [indicator_of_mem (show t ∈ Ioc 0 t₀ from ⟨ht', htt⟩),
        indicator_of_notMem (show t ∉ Ioi t₀ from not_lt.2 htt), add_zero]
      calc (volume.restrict E) {x | t < ‖F x‖} ≤ (volume.restrict E) univ :=
            measure_mono (subset_univ _)
        _ = volume E := Measure.restrict_apply_univ _
    · rw [indicator_of_notMem (show t ∉ Ioc 0 t₀ from fun h => htt h.2),
        indicator_of_mem (show t ∈ Ioi t₀ from not_le.1 htt), zero_add]
      refine (Measure.restrict_apply_le _ _).trans ?_
      have h := ofReal_mul_le_weakNorm F p ht'.le
      rw [← hW] at h
      have h2 : volume {x | t < ‖F x‖} ^ (1 / p) ≤ ENNReal.ofReal (w / t) := by
        rw [ENNReal.ofReal_div_of_pos ht', hw, ENNReal.ofReal_toReal hWtop,
          ENNReal.le_div_iff_mul_le (Or.inl (by simp [ht'])) (Or.inl ENNReal.ofReal_ne_top),
          mul_comm]
        exact h
      calc volume {x | t < ‖F x‖} = (volume {x | t < ‖F x‖} ^ (1 / p)) ^ p := by
            rw [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one]
        _ ≤ ENNReal.ofReal (w / t) ^ p := by gcongr
        _ = ENNReal.ofReal (w ^ p * t ^ (-p)) := by
            rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hp0.le, Real.div_rpow hw0.le ht'.le,
              Real.rpow_neg ht'.le, div_eq_mul_inv]
  rw [hlayer]
  have hint : IntegrableOn (fun t : ℝ => w ^ p * t ^ (-p)) (Ioi t₀) :=
    (integrableOn_Ioi_rpow_of_lt (by linarith) ht₀0).const_mul _
  have hnn : 0 ≤ᵐ[volume.restrict (Ioi t₀)] fun t : ℝ => w ^ p * t ^ (-p) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have : (0 : ℝ) < t := ht₀0.trans ht
    positivity
  calc ∫⁻ t in Ioi 0, (volume.restrict E) {x | t < ‖F x‖}
      ≤ ∫⁻ t in Ioi 0, ((Ioc 0 t₀).indicator (fun _ => volume E) t +
          (Ioi t₀).indicator (fun t => ENNReal.ofReal (w ^ p * t ^ (-p))) t) :=
        setLIntegral_mono' measurableSet_Ioi hbound
    _ ≤ ∫⁻ t, ((Ioc 0 t₀).indicator (fun _ => volume E) t +
          (Ioi t₀).indicator (fun t => ENNReal.ofReal (w ^ p * t ^ (-p))) t) :=
        setLIntegral_le_lintegral _ _
    _ = volume E * ENNReal.ofReal t₀ +
          ENNReal.ofReal (∫ t in Ioi t₀, w ^ p * t ^ (-p)) := by
        rw [lintegral_add_left (measurable_const.indicator measurableSet_Ioc),
          lintegral_indicator measurableSet_Ioc, lintegral_indicator measurableSet_Ioi,
          setLIntegral_const, Real.volume_Ioc, sub_zero,
          ofReal_integral_eq_lintegral_ofReal hint hnn]
    _ = ENNReal.ofReal (α * t₀ + w ^ p * (t₀ ^ (-p + 1) / (p - 1))) := by
        rw [integral_const_mul, integral_Ioi_rpow_of_lt (by linarith) ht₀0,
          ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul hα0.le, hα,
          ENNReal.ofReal_toReal hEfin]
        congr 3
        rw [neg_div, ← div_neg, neg_add, neg_neg]
        ring
    _ = ENNReal.ofReal (p / (p - 1) * w * α ^ (1 - 1 / p)) := by
        rw [ht₀, kolmogorov_identity hw0 hα0 hp]
    _ = _ := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity), hw,
          ENNReal.ofReal_toReal hWtop, ← ENNReal.ofReal_rpow_of_nonneg hα0.le hexp.le, hα,
          ENNReal.ofReal_toReal hEfin]

end Tools

/-! ### Tools: the pairing -/

section PairingTools

variable {𝕜 : Type*} [RCLike 𝕜] {B₂ : Type*} [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂]

/-- `|⟨F, g⟩| ≤ ∫ |g| |F|`. -/
theorem enorm_pairing_le_lintegral (F : Rd d → B₂) (g : Rd d → StrongDual 𝕜 B₂) :
    ‖pairing F g‖ₑ ≤ ∫⁻ x, ‖g x‖ₑ * ‖F x‖ₑ :=
  (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun x => (g x).le_opENorm (F x))

/-- Weak-type pairing: if `|g| ≤ M 1_E` then `|⟨F, g⟩| ≤ M p' ‖F‖_{p,∞} |E|^{1-1/p}`. -/
theorem enorm_pairing_le_weakNorm {F : Rd d → B₂} (hF : AEStronglyMeasurable F volume)
    {g : Rd d → StrongDual 𝕜 B₂} {E : Set (Rd d)} (hE : MeasurableSet E)
    (hEfin : volume E ≠ ∞) {M : ℝ} (hg : ∀ x, ‖g x‖ ≤ E.indicator (fun _ => M) x) {p : ℝ}
    (hp : 1 < p) :
    ‖pairing F g‖ₑ ≤ ENNReal.ofReal M *
      (ENNReal.ofReal (p / (p - 1)) * weakNorm F p * volume E ^ (1 - 1 / p)) := by
  refine (enorm_pairing_le_lintegral F g).trans ?_
  calc ∫⁻ x, ‖g x‖ₑ * ‖F x‖ₑ ≤ ∫⁻ x, E.indicator (fun x => ENNReal.ofReal M * ‖F x‖ₑ) x := by
        refine lintegral_mono fun x => ?_
        by_cases hx : x ∈ E
        · rw [indicator_of_mem hx]
          gcongr
          have := hg x
          rw [indicator_of_mem hx] at this
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal this
        · rw [indicator_of_notMem hx]
          have := hg x
          rw [indicator_of_notMem hx] at this
          rw [norm_le_zero_iff.1 this, ← ofReal_norm, norm_zero, ENNReal.ofReal_zero, zero_mul]
    _ = ENNReal.ofReal M * ∫⁻ x in E, ‖F x‖ₑ := by
        rw [lintegral_indicator hE, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ ≤ _ := by gcongr; exact lintegral_enorm_le_weakNorm hF hEfin hp

theorem integrable_pairing_integrand_of_memLp {F : Rd d → B₂} (hF : AEStronglyMeasurable F volume)
    {q : ℝ} (hq : 1 < q) (hFq : eLpNorm F (.ofReal q) volume < ∞)
    (g : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) : Integrable (fun x => g x (F x)) volume :=
  integrable_pairing_integrand hF hq hFq g

theorem pairing_add_left {F₁ F₂ : Rd d → B₂} (hF₁ : AEStronglyMeasurable F₁ volume)
    (hF₂ : AEStronglyMeasurable F₂ volume) {q : ℝ} (hq : 1 < q)
    (hF₁q : eLpNorm F₁ (.ofReal q) volume < ∞) (hF₂q : eLpNorm F₂ (.ofReal q) volume < ∞)
    (g : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing (F₁ + F₂) g = pairing F₁ g + pairing F₂ g := by
  unfold pairing
  rw [← integral_add (integrable_pairing_integrand hF₁ hq hF₁q g)
    (integrable_pairing_integrand hF₂ hq hF₂q g)]
  congr 1
  funext x
  simp

theorem pairing_sum_left {ι : Type*} (s : Finset ι) {F : ι → Rd d → B₂}
    (hF : ∀ i ∈ s, AEStronglyMeasurable (F i) volume) {q : ℝ} (hq : 1 < q)
    (hFq : ∀ i ∈ s, eLpNorm (F i) (.ofReal q) volume < ∞)
    (g : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing (∑ i ∈ s, F i) g = ∑ i ∈ s, pairing (F i) g := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [pairing]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    have hs : AEStronglyMeasurable (∑ i ∈ s, F i) volume :=
      Finset.aestronglyMeasurable_sum s fun i hi => hF i (Finset.mem_insert_of_mem hi)
    have hsq : eLpNorm (∑ i ∈ s, F i) (.ofReal q) volume < ∞ := by
      refine lt_of_le_of_lt (eLpNorm_sum_le (by simp; linarith)) ?_
      exact ENNReal.sum_lt_top.2 fun i hi => hFq i (Finset.mem_insert_of_mem hi)
    rw [pairing_add_left (hF a (Finset.mem_insert_self a s)) hs hq
      (hFq a (Finset.mem_insert_self a s)) hsq,
      ih (fun i hi => hF i (Finset.mem_insert_of_mem hi))
        (fun i hi => hFq i (Finset.mem_insert_of_mem hi))]

theorem pairing_sum_right {F : Rd d → B₂} (hF : AEStronglyMeasurable F volume) {q : ℝ}
    (hq : 1 < q) (hFq : eLpNorm F (.ofReal q) volume < ∞) {ι : Type*} (s : Finset ι)
    (g : ι → SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing F (∑ i ∈ s, g i) = ∑ i ∈ s, pairing F (g i) := by
  unfold pairing
  simp only [Finset.sum_apply, sum_apply]
  exact integral_finsetSum s fun i _ => integrable_pairing_integrand hF hq hFq (g i)

theorem pairing_sub_right {F : Rd d → B₂} (hF : AEStronglyMeasurable F volume) {q : ℝ}
    (hq : 1 < q) (hFq : eLpNorm F (.ofReal q) volume < ∞)
    (g₁ g₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂)) :
    pairing F (g₁ - g₂) = pairing F g₁ - pairing F g₂ := by
  unfold pairing
  rw [SimpleCpt.coe_sub', ← integral_sub (integrable_pairing_integrand hF hq hFq g₁)
    (integrable_pairing_integrand hF hq hFq g₂)]
  congr 1

end PairingTools

/-! ### §4.1: the forms `𝔊_{Q₀}` and the induction statement -/

/-- **Definition 4.1**: `𝔊_{Q₀}(f₁, f₂) = sup ∑_{Q ∈ 𝔖} |Q| ⟨f₁⟩_{Q,p} ⟨f₂⟩_{3Q,q'}`, the supremum
over `γ`-sparse collections `𝔖` of dyadic subcubes of `Q₀`. (We take the supremum over finite
collections; since all terms are nonnegative this is the same supremum.) -/
noncomputable def frakG {B B' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B']
    (γ p r : ℝ) (Q₀ : Cube d) (f₁ : Rd d → B) (f₂ : Rd d → B') : ℝ≥0∞ :=
  ⨆ (𝔖 : Finset (Cube d)) (_ : ∀ Q ∈ 𝔖, Q₀.IsDyadicSubcube Q) (_ : IsSparse γ (𝔖 : Set (Cube d))),
    ∑ Q ∈ 𝔖, volume (Q : Set (Rd d)) * avgNorm f₁ Q p * avgNorm f₂ Q.triple r

theorem le_frakG {B B' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B']
    {γ p r : ℝ} {Q₀ : Cube d} {f₁ : Rd d → B} {f₂ : Rd d → B'} (𝔖 : Finset (Cube d))
    (h𝔖 : ∀ Q ∈ 𝔖, Q₀.IsDyadicSubcube Q) (hsp : IsSparse γ (𝔖 : Set (Cube d))) :
    ∑ Q ∈ 𝔖, volume (Q : Set (Rd d)) * avgNorm f₁ Q p * avgNorm f₂ Q.triple r ≤
      frakG γ p r Q₀ f₁ f₂ :=
  le_iSup_of_le 𝔖 <| le_iSup_of_le h𝔖 <| le_iSup_of_le hsp le_rfl

/-- The partial sums `S_{N₁,N₂} = ∑_{j=N₁}^{N₂} T_j`. -/
noncomputable def psum {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁]
    [NormedSpace 𝕜 B₁] [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] (T : ℤ → Op d 𝕜 B₁ B₂)
    (N₁ N₂ : ℤ) (f : SimpleCpt d 𝕜 B₁) : Rd d → B₂ :=
  ∑ j ∈ Finset.Icc N₁ N₂, T j f

/-- **The induction statement** (Definition 4.2, in the form used for the induction): for all
`N₁ ≤ N₂ ≤ M` with `M - N₁ ≤ n`, all cubes `Q₀` of side `2^M` of the prototype lattice and all
`f₁` supported in `Q₀`, `|⟨∑_{j=N₁}^{N₂} T_j f₁, f₂⟩| ≤ K 𝒞 𝔊_{Q₀}(f₁, f₂)`. (This contains the
paper's `U(n) ≤ K 𝒞`; the padding by zero operators in §4.2 corresponds to `N₂ < M`.) -/
def InductionStatement {𝕜 : Type*} [RCLike 𝕜] {B₁ B₂ : Type*} [NormedAddCommGroup B₁]
    [NormedSpace 𝕜 B₁] [NormedAddCommGroup B₂] [NormedSpace 𝕜 B₂] (T : ℤ → Op d 𝕜 B₁ B₂)
    (γ p q : ℝ) (KC : ℝ) (n : ℕ) : Prop :=
  ∀ N₁ N₂ M : ℤ, N₁ ≤ N₂ → N₂ ≤ M → (M - N₁).toNat ≤ n → ∀ t₀ : Fin d → ℤ,
    ∀ f₁ : SimpleCpt d 𝕜 B₁, Function.support ⇑f₁ ⊆ ((protoGrid d).cube M t₀ : Set (Rd d)) →
    ∀ f₂ : SimpleCpt d 𝕜 (StrongDual 𝕜 B₂),
      ‖pairing (psum T N₁ N₂ f₁) f₂‖ₑ ≤
        ENNReal.ofReal KC * frakG γ p q.conjExponent ((protoGrid d).cube M t₀) f₁ f₂

/-! ### §4.4: the exceptional set `Ω` (Omdefs) -/

section ExceptionalSet

variable {𝕜 : Type*} [RCLike 𝕜] {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]

theorem lintegral_rpow_eq_volume_mul_avgNorm {f : Rd d → B} {S : Set (Rd d)}
    (_hS : MeasurableSet S) (hf : Function.support f ⊆ S) (hS0 : volume S ≠ 0)
    (hStop : volume S ≠ ∞) {p : ℝ} (hp : 0 < p) :
    ∫⁻ x, ‖f x‖ₑ ^ p = volume S * avgNorm f S p ^ p := by
  rw [avgNorm, ← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one, ← mul_assoc,
    ENNReal.mul_inv_cancel hS0 hStop, one_mul, setLIntegral_eq_of_support_subset]
  intro x hx
  by_contra hxS
  have : f x = 0 := Function.notMem_support.1 fun h => hxS (hf h)
  rw [Function.mem_support, this, enorm_zero, ENNReal.zero_rpow_of_pos hp] at hx
  exact hx rfl

theorem SimpleCpt.avgNorm_ne_top (f : SimpleCpt d 𝕜 B) (Q : Cube d) {p : ℝ} (hp : 0 < p) :
    avgNorm f Q p ≠ ∞ := by
  have h := eLpNorm_indicator_eq_avgNorm (SimpleCpt.aestronglyMeasurable f) Q.measurableSet
    Q.volume_ne_zero Q.volume_ne_top hp
  have hfin : eLpNorm ((Q : Set (Rd d)).indicator f) (.ofReal p) volume < ∞ :=
    lt_of_le_of_lt (eLpNorm_indicator_le _ Q.measurableSet) (SimpleCpt.eLpNorm_lt_top f hp)
  rw [h] at hfin
  intro htop
  rw [htop, ENNReal.mul_top (ENNReal.rpow_pos (pos_iff_ne_zero.2 Q.volume_ne_zero)
    Q.volume_ne_top).ne'] at hfin
  exact lt_irrefl _ hfin

/-- The constant `Λ = 20^{d+1} / (1 - γ)` in the definition of `Ω`. -/
noncomputable def omegaConst (d : ℕ) (γ : ℝ) : ℝ := 20 ^ (d + 1) / (1 - γ)

theorem omegaConst_pos {γ : ℝ} (hγ1 : γ < 1) : 0 < omegaConst d γ := by
  unfold omegaConst
  have : 0 < 1 - γ := by linarith
  positivity

/-- The exceptional set for one function: an open set of measure `≤ (4^d + 1) |S| / Λ + η`
outside of which `𝓜(|f|^p) ≤ τ` and `|f|^p ≤ τ`, where `τ = Λ ⟨f⟩_{S,p}^p`. -/
theorem exists_exceptionalSet_one {f : SimpleCpt d 𝕜 B} {S : Set (Rd d)}
    (hS : MeasurableSet S) (hf : Function.support ⇑f ⊆ S) (hS0 : volume S ≠ 0)
    (hStop : volume S ≠ ∞) {p : ℝ} (hp : 0 < p) (hpos : avgNorm f S p ≠ 0)
    (havg : avgNorm f S p ≠ ∞) {Λ : ℝ≥0∞} (hΛ0 : Λ ≠ 0) (hΛtop : Λ ≠ ∞) :
    ∃ Ω : Set (Rd d), IsOpen Ω ∧ Λ * volume Ω < (4 ^ d + 2) * volume S ∧
      ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ p) z ≤ Λ * avgNorm f S p ^ p ∧
        ‖f z‖ₑ ^ p ≤ Λ * avgNorm f S p ^ p := by
  set τ := Λ * avgNorm f S p ^ p with hτ
  have hap0 : avgNorm f S p ^ p ≠ 0 := (ENNReal.rpow_pos (pos_iff_ne_zero.2 hpos) havg).ne'
  have haptop : avgNorm f S p ^ p ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg hp.le havg
  have hτ0 : τ ≠ 0 := mul_ne_zero hΛ0 hap0
  have hτtop : τ ≠ ∞ := ENNReal.mul_ne_top hΛtop haptop
  have hint := lintegral_rpow_eq_volume_mul_avgNorm hS hf hS0 hStop hp
  have hmeas : AEMeasurable (fun x => ‖f x‖ₑ ^ p) volume :=
    ((SimpleCpt.aestronglyMeasurable f).enorm).pow_const _
  -- the maximal function part
  set A := {x | τ < hlMaximal volume (fun x => ‖f x‖ₑ ^ p) x} with hA
  have hAopen : IsOpen A := isOpen_setOf_lt_hlMaximal _ _ _
  have hAvol : Λ * volume A ≤ 4 ^ d * volume S := by
    have h := hlMaximal_weakType_one_one volume (fun x => ‖f x‖ₑ ^ p) τ
    rw [finrank_rd, hint, hτ] at h
    have : Λ * volume A * avgNorm f S p ^ p ≤ 4 ^ d * volume S * avgNorm f S p ^ p := by
      calc Λ * volume A * avgNorm f S p ^ p = Λ * avgNorm f S p ^ p * volume A := by ring
        _ ≤ 4 ^ d * (volume S * avgNorm f S p ^ p) := h
        _ = 4 ^ d * volume S * avgNorm f S p ^ p := by ring
    exact (ENNReal.mul_le_mul_iff_left hap0 haptop).1 this
  -- the Chebyshev part
  set C := {x | τ < ‖f x‖ₑ ^ p} with hC
  have hCvol : Λ * volume C ≤ volume S := by
    have h := mul_meas_ge_le_lintegral₀ hmeas τ
    rw [hint] at h
    have hsub : volume C ≤ volume {x | τ ≤ ‖f x‖ₑ ^ p} :=
      measure_mono fun x (hx : τ < ‖f x‖ₑ ^ p) => (le_of_lt hx : τ ≤ ‖f x‖ₑ ^ p)
    have h2 : τ * volume C ≤ volume S * avgNorm f S p ^ p :=
      le_trans (by gcongr) h
    have : Λ * volume C * avgNorm f S p ^ p ≤ volume S * avgNorm f S p ^ p := by
      calc Λ * volume C * avgNorm f S p ^ p = τ * volume C := by rw [hτ]; ring
        _ ≤ _ := h2
    exact (ENNReal.mul_le_mul_iff_left hap0 haptop).1 this
  have hCfin : volume C ≠ ∞ := by
    intro htop
    rw [htop, ENNReal.mul_top hΛ0] at hCvol
    exact hStop (top_le_iff.1 hCvol)
  have hη : volume C < volume C + volume S / Λ :=
    ENNReal.lt_add_right hCfin (ENNReal.div_pos hS0 hΛtop).ne'
  obtain ⟨U, hCU, hUopen, hUvol⟩ := Set.exists_isOpen_lt_of_lt C _ hη
  refine ⟨A ∪ U, hAopen.union hUopen, ?_, fun z hz => ?_⟩
  · have hU' : Λ * volume U < Λ * volume C + volume S := by
      calc Λ * volume U < Λ * (volume C + volume S / Λ) :=
            (ENNReal.mul_lt_mul_iff_right hΛ0 hΛtop).2 hUvol
        _ = Λ * volume C + volume S := by
            rw [mul_add, ENNReal.mul_div_cancel hΛ0 hΛtop]
    calc Λ * volume (A ∪ U) ≤ Λ * (volume A + volume U) := by gcongr; exact measure_union_le _ _
      _ = Λ * volume A + Λ * volume U := mul_add _ _ _
      _ < 4 ^ d * volume S + (Λ * volume C + volume S) := by
          refine ENNReal.add_lt_add_of_le_of_lt ?_ hAvol hU'
          exact ne_top_of_le_ne_top (ENNReal.mul_ne_top (by simp) hStop) hAvol
      _ ≤ 4 ^ d * volume S + (volume S + volume S) := by gcongr
      _ = (4 ^ d + 2) * volume S := by ring
  · have hzA : z ∉ A := fun h => hz (Or.inl h)
    have hzC : z ∉ C := fun h => hz (Or.inr (hCU h))
    simp only [hA, hC, mem_ofPred_eq, not_lt] at hzA hzC
    exact ⟨hzA, hzC⟩

theorem nat_omega_bound (d : ℕ) : (4 ^ d + 2) * (1 + 3 ^ d) ≤ 20 ^ (d + 1) := by
  have h1 : 4 ^ d + 2 ≤ 3 * 4 ^ d := by have := Nat.one_le_pow d 4 (by norm_num); omega
  have h2 : 1 + 3 ^ d ≤ 2 * 3 ^ d := by have := Nat.one_le_pow d 3 (by norm_num); omega
  have h3 : 12 ^ d ≤ 20 ^ d := Nat.pow_le_pow_left (by norm_num) d
  calc (4 ^ d + 2) * (1 + 3 ^ d) ≤ (3 * 4 ^ d) * (2 * 3 ^ d) := Nat.mul_le_mul h1 h2
    _ = 6 * 12 ^ d := by rw [show (12 : ℕ) = 4 * 3 by norm_num, mul_pow]; ring
    _ ≤ 20 * 20 ^ d := by omega
    _ = 20 ^ (d + 1) := by ring

variable {B' : Type*} [NormedAddCommGroup B'] [NormedSpace 𝕜 B']

/-- **The exceptional set `Ω`** (BRS (Omdefs), modified as in ErrorReport E6): an open set with
`|Ω| < (1 - γ)|Q₀|` outside of which `𝓜(|f₁|^p) ≤ Λ⟨f₁⟩_{Q₀,p}^p`, `|f₁|^p ≤ Λ⟨f₁⟩_{Q₀,p}^p`,
`𝓜(|f₂|^r) ≤ Λ⟨f₂⟩_{3Q₀,r}^r` and `|f₂|^r ≤ Λ⟨f₂⟩_{3Q₀,r}^r`, with `Λ = 20^{d+1}/(1-γ)`. -/
theorem exists_exceptionalSet (Q₀ : Cube d) {f₁ : SimpleCpt d 𝕜 B} {f₂ : SimpleCpt d 𝕜 B'}
    (hf₁ : Function.support ⇑f₁ ⊆ Q₀) (hf₂ : Function.support ⇑f₂ ⊆ Q₀.triple) {p r : ℝ}
    (hp : 0 < p) (hr : 0 < r) {γ : ℝ} (hγ1 : γ < 1) (hpos₁ : avgNorm f₁ Q₀ p ≠ 0)
    (hpos₂ : avgNorm f₂ Q₀.triple r ≠ 0) :
    ∃ Ω : Set (Rd d), IsOpen Ω ∧ volume Ω < ENNReal.ofReal (1 - γ) * volume (Q₀ : Set (Rd d)) ∧
      ∀ z ∉ Ω,
        (hlMaximal volume (fun x => ‖f₁ x‖ₑ ^ p) z ≤
            ENNReal.ofReal (omegaConst d γ) * avgNorm f₁ Q₀ p ^ p ∧
          ‖f₁ z‖ₑ ^ p ≤ ENNReal.ofReal (omegaConst d γ) * avgNorm f₁ Q₀ p ^ p) ∧
        (hlMaximal volume (fun x => ‖f₂ x‖ₑ ^ r) z ≤
            ENNReal.ofReal (omegaConst d γ) * avgNorm f₂ Q₀.triple r ^ r ∧
          ‖f₂ z‖ₑ ^ r ≤ ENNReal.ofReal (omegaConst d γ) * avgNorm f₂ Q₀.triple r ^ r) := by
  set Λ := ENNReal.ofReal (omegaConst d γ) with hΛ
  have hΛ0 : Λ ≠ 0 := by rw [hΛ]; exact (ENNReal.ofReal_pos.2 (omegaConst_pos hγ1)).ne'
  have hΛtop : Λ ≠ ∞ := ENNReal.ofReal_ne_top
  obtain ⟨Ω₁, hΩ₁, hvol₁, h₁⟩ := exists_exceptionalSet_one Q₀.measurableSet hf₁
    Q₀.volume_ne_zero Q₀.volume_ne_top hp hpos₁ (SimpleCpt.avgNorm_ne_top f₁ Q₀ hp) hΛ0 hΛtop
  obtain ⟨Ω₂, hΩ₂, hvol₂, h₂⟩ := exists_exceptionalSet_one Q₀.triple.measurableSet hf₂
    Q₀.triple.volume_ne_zero Q₀.triple.volume_ne_top hr hpos₂
    (SimpleCpt.avgNorm_ne_top f₂ Q₀.triple hr) hΛ0 hΛtop
  refine ⟨Ω₁ ∪ Ω₂, hΩ₁.union hΩ₂, ?_, fun z hz => ⟨h₁ z fun h => hz (Or.inl h),
    h₂ z fun h => hz (Or.inr h)⟩⟩
  rw [Q₀.volume_triple] at hvol₂
  have hQ := Q₀.volume_ne_top
  have hkey : Λ * volume (Ω₁ ∪ Ω₂) < Λ * (ENNReal.ofReal (1 - γ) * volume (Q₀ : Set (Rd d))) := by
    calc Λ * volume (Ω₁ ∪ Ω₂) ≤ Λ * volume Ω₁ + Λ * volume Ω₂ := by
          rw [← mul_add]; gcongr; exact measure_union_le _ _
      _ < (4 ^ d + 2) * volume (Q₀ : Set (Rd d)) +
          (4 ^ d + 2) * (3 ^ d * volume (Q₀ : Set (Rd d))) :=
          ENNReal.add_lt_add hvol₁ hvol₂
      _ = (((4 ^ d + 2) * (1 + 3 ^ d) : ℕ) : ℝ≥0∞) * volume (Q₀ : Set (Rd d)) := by
          push_cast; ring
      _ ≤ ((20 ^ (d + 1) : ℕ) : ℝ≥0∞) * volume (Q₀ : Set (Rd d)) := by
          gcongr; exact_mod_cast nat_omega_bound d
      _ = Λ * (ENNReal.ofReal (1 - γ) * volume (Q₀ : Set (Rd d))) := by
          rw [← mul_assoc, hΛ, ← ENNReal.ofReal_mul (omegaConst_pos hγ1).le, omegaConst,
            div_mul_cancel₀ _ (by linarith : (1 : ℝ) - γ ≠ 0)]
          push_cast
          rw [ENNReal.ofReal_pow (by norm_num)]
          norm_num
  exact (ENNReal.mul_lt_mul_iff_right hΛ0 hΛtop).1 hkey

end ExceptionalSet

/-! ### §4.4: the Whitney family (wh) and (W in Q0) -/

section WhitneyFamily

/-- The cube of the prototype lattice with index `a = (level, position)`. -/
noncomputable abbrev qcube (a : ℤ × (Fin d → ℤ)) : Cube d := (protoGrid d).cube a.1 a.2

/-- The constant `δ = √d + 1` bounding the diameters of the lattice cubes. -/
noncomputable def wδ (d : ℕ) : ℝ := Real.sqrt d + 1

theorem wδ_pos : 0 < wδ d := by unfold wδ; positivity

theorem one_le_wδ : 1 ≤ wδ d := by unfold wδ; linarith [Real.sqrt_nonneg (d : ℝ)]

theorem protoGrid_side (L : ℤ) : (protoGrid d).side L = (2 : ℝ) ^ L := by
  simp [protoGrid, GridData.side]

theorem qcube_side (a : ℤ × (Fin d → ℤ)) : (qcube a).side = (2 : ℝ) ^ a.1 := by
  simp [qcube, GridData.cube, protoGrid_side]

theorem dist_le_of_mem_qcube {a : ℤ × (Fin d → ℤ)} {x y : Rd d}
    (hx : x ∈ (qcube a : Set (Rd d))) (hy : y ∈ (qcube a : Set (Rd d))) :
    dist x y ≤ wδ d * (2 : ℝ) ^ a.1 := by
  have h := (protoGrid d).dist_le_of_mem_cube hx hy
  rw [protoGrid_side] at h
  refine h.trans ?_
  unfold wδ
  have : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  nlinarith

/-- The levels of the prototype lattice form a nested sequence of partitions (with the level
`L = -k`), with cells of diameter at most `δ 2^{-k}`. -/
theorem protoGrid_isNestedPartition :
    IsNestedPartition
      (fun k : ℤ => {S : Set (Rd d) | ∃ t : Fin d → ℤ, S = (qcube (-k, t) : Set (Rd d))})
      (wδ d) where
  cover k x := ⟨_, ⟨(protoGrid d).idx (-k) x, rfl⟩, (protoGrid d).mem_cube_idx _ x⟩
  eq_of_nonempty_inter := by
    rintro k _ ⟨t, rfl⟩ _ ⟨t', rfl⟩ ⟨x, hx, hx'⟩
    have := (protoGrid d).eq_of_mem_cube (L := -k) hx hx'
    exact congrArg (fun t => ((protoGrid d).cube (-k) t : Set (Rd d))) this
  nest := by
    rintro k _ ⟨t, rfl⟩
    refine ⟨_, ⟨(protoGrid d).parent (-k) t, rfl⟩, ?_⟩
    have h := (protoGrid d).isDyadicSubcubeAt_parent (-k) t
    rw [show -k - 1 = -(k + 1) by ring] at h
    exact h.subset
  dist_le := by
    rintro k _ ⟨t, rfl⟩ x hx y hy
    have := dist_le_of_mem_qcube hx hy
    simpa using this

theorem qcube_set_inj (hd : 0 < d) {a b : ℤ × (Fin d → ℤ)}
    (h : (qcube a : Set (Rd d)) = qcube b) : a = b := by
  have hvol : volume (qcube a : Set (Rd d)) = volume (qcube b : Set (Rd d)) := by rw [h]
  rw [Cube.volume_eq, Cube.volume_eq, qcube_side, qcube_side] at hvol
  have h1 := (ENNReal.ofReal_eq_ofReal_iff (by positivity) (by positivity)).1 hvol
  have h2 : (2 : ℝ) ^ a.1 = (2 : ℝ) ^ b.1 :=
    (pow_left_inj₀ (by positivity) (by positivity) hd.ne').1 h1
  have hL : a.1 = b.1 := zpow_right_injective₀ (by norm_num) (by norm_num) h2
  have hx := (qcube a).corner_mem
  rw [h] at hx
  have ht := (protoGrid d).eq_of_mem_cube (qcube a).corner_mem (show _ ∈
    ((protoGrid d).cube a.1 b.2 : Set (Rd d)) by rw [hL]; exact hx)
  exact Prod.ext hL ht

variable {Ω : Set (Rd d)}

/-- The Whitney family as a set of lattice indices, with the properties (wh) (with `δ = √d + 1`,
constants `5δ` and `12δ`). -/
structure IsWhitneyIndex (Ω : Set (Rd d)) (I : Set (ℤ × (Fin d → ℤ))) : Prop where
  disjoint : ∀ a ∈ I, ∀ b ∈ I, a ≠ b → Disjoint (qcube a : Set (Rd d)) (qcube b)
  iUnion_eq : ⋃ a ∈ I, (qcube a : Set (Rd d)) = Ω
  dist_ge : ∀ a ∈ I, ∀ y ∈ (qcube a : Set (Rd d)), ∀ z ∉ Ω, 5 * (wδ d * (2 : ℝ) ^ a.1) ≤ dist y z
  dist_lt : ∀ a ∈ I, ∃ y ∈ (qcube a : Set (Rd d)), ∃ z ∉ Ω,
    dist y z < 12 * (wδ d * (2 : ℝ) ^ a.1)

/-- **Whitney decomposition of `Ω`** with cubes of the prototype lattice (BRS (wh)). -/
theorem exists_whitneyIndex (hd : 0 < d) (hΩ : IsOpen Ω) (hΩc : Ωᶜ.Nonempty) :
    ∃ I : Set (ℤ × (Fin d → ℤ)), IsWhitneyIndex Ω I := by
  obtain ⟨𝒲, hdisj, hU, hdist⟩ :=
    exists_whitney_decomposition (protoGrid_isNestedPartition (d := d)) wδ_pos hΩ hΩc
      (by norm_num : (0 : ℝ) < 5)
  refine ⟨{a | (qcube a : Set (Rd d)) ∈ 𝒲}, ⟨?_, ?_, ?_, ?_⟩⟩
  · intro a ha b hb hab
    exact hdisj ha hb fun h => hab (qcube_set_inj hd h)
  · rw [← hU]
    ext x
    simp only [mem_iUnion, mem_ofPred_eq, exists_prop, mem_sUnion]
    constructor
    · rintro ⟨a, ha, hx⟩; exact ⟨_, ha, hx⟩
    · rintro ⟨W, hW, hx⟩
      obtain ⟨k, ⟨t, rfl⟩, -⟩ := hdist W hW
      exact ⟨(-k, t), hW, hx⟩
  · intro a ha y hy z hz
    obtain ⟨k, ⟨t, ht⟩, h1, -⟩ := hdist _ ha
    have hk : a = (-k, t) := qcube_set_inj hd ht
    have := h1 y hy z hz
    rw [hk]
    simpa using this
  · intro a ha
    obtain ⟨k, ⟨t, ht⟩, -, h2⟩ := hdist _ ha
    have hk : a = (-k, t) := qcube_set_inj hd ht
    obtain ⟨y, hy, z, hz, hyz⟩ := h2
    refine ⟨y, hy, z, hz, ?_⟩
    rw [hk]
    have : (2 : ℝ) * 5 + 2 = 12 := by norm_num
    simpa [this] using hyz

/-- (W in Q0): a Whitney cube meeting a lattice cube `P` of level `M` with `|Ω| < |P|` is a
proper dyadic subcube of `P`. -/
theorem whitney_subset_of_inter {I : Set (ℤ × (Fin d → ℤ))} (hI : IsWhitneyIndex Ω I)
    {a : ℤ × (Fin d → ℤ)} (ha : a ∈ I) {M : ℤ} {t : Fin d → ℤ}
    (hvol : volume Ω < volume ((protoGrid d).cube M t : Set (Rd d)))
    (hne : ((qcube a : Set (Rd d)) ∩ (protoGrid d).cube M t).Nonempty) :
    a.1 < M ∧ (qcube a : Set (Rd d)) ⊆ (protoGrid d).cube M t := by
  have hsubΩ : (qcube a : Set (Rd d)) ⊆ Ω := by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  rcases lt_or_ge a.1 M with h | h
  · exact ⟨h, ((protoGrid d).isDyadicSubcube_of_inter h.le hne).subset⟩
  · exfalso
    have hsub := ((protoGrid d).isDyadicSubcube_of_inter h (by rwa [inter_comm] at hne)).subset
    exact absurd (measure_mono (hsub.trans hsubΩ)) (not_le.2 hvol)

/-- A lattice cube of level `M` through a point of `3Q₀` (`Q₀` of level `M`) lies in `3Q₀`. -/
theorem cube_idx_subset_triple {M : ℤ} {t₀ : Fin d → ℤ} {x : Rd d}
    (hx : x ∈ (((protoGrid d).cube M t₀).triple : Set (Rd d))) :
    ((protoGrid d).cube M ((protoGrid d).idx M x) : Set (Rd d)) ⊆
      ((protoGrid d).cube M t₀).triple := by
  set G := protoGrid d
  have hs := G.side_pos M
  intro y hy i
  have hxi := hx i
  have hyi := hy i
  have hxc := G.mem_cube_idx M x i
  simp only [Cube.triple, GridData.cube] at hxi hyi hxc ⊢
  set t' := G.idx M x i
  have h1 : (t' : ℝ) < t₀ i + 2 := by
    have : G.side M * (t' + G.o M i) < G.side M * (t₀ i + G.o M i) + 2 * G.side M := by
      linarith [hxc.1, hxi.2]
    nlinarith
  have h2 : (t₀ i : ℝ) - 2 < t' := by
    have : G.side M * (t₀ i + G.o M i) - G.side M < G.side M * (t' + G.o M i) + G.side M := by
      linarith [hxc.2, hxi.1]
    nlinarith
  have h1' : t' ≤ t₀ i + 1 := by
    have : t' < t₀ i + 2 := by exact_mod_cast h1
    omega
  have h2' : t₀ i - 1 ≤ t' := by
    have : t₀ i - 2 < t' := by exact_mod_cast h2
    omega
  have h1r : (t' : ℝ) ≤ t₀ i + 1 := by exact_mod_cast h1'
  have h2r : (t₀ i : ℝ) - 1 ≤ t' := by exact_mod_cast h2'
  constructor <;> nlinarith [hyi.1, hyi.2]

/-- (W in Q0) for `3Q₀`: a Whitney cube meeting `3Q₀` lies in `3Q₀` and has level `< M`. -/
theorem whitney_subset_triple {I : Set (ℤ × (Fin d → ℤ))} (hI : IsWhitneyIndex Ω I)
    {a : ℤ × (Fin d → ℤ)} (ha : a ∈ I) {M : ℤ} {t₀ : Fin d → ℤ}
    (hvol : volume Ω < volume ((protoGrid d).cube M t₀ : Set (Rd d)))
    (hne : ((qcube a : Set (Rd d)) ∩ ((protoGrid d).cube M t₀).triple).Nonempty) :
    a.1 < M ∧ (qcube a : Set (Rd d)) ⊆ ((protoGrid d).cube M t₀).triple := by
  obtain ⟨x, hxa, hx3⟩ := hne
  set P := (protoGrid d).cube M ((protoGrid d).idx M x)
  have hvolP : volume (P : Set (Rd d)) = volume ((protoGrid d).cube M t₀ : Set (Rd d)) := by
    rw [Cube.volume_eq, Cube.volume_eq]; rfl
  obtain ⟨h1, h2⟩ := whitney_subset_of_inter hI ha (hvolP ▸ hvol)
    ⟨x, hxa, (protoGrid d).mem_cube_idx M x⟩
  exact ⟨h1, h2.trans (cube_idx_subset_triple hx3)⟩

end WhitneyFamily

/-! ### §4.4: upper bounds for averages (upperboundsWh), (upperboundsWhext) -/

section UpperBounds

theorem Cube.dist_le (Q : Cube d) {x y : Rd d} (hx : x ∈ (Q : Set (Rd d)))
    (hy : y ∈ (Q : Set (Rd d))) : dist x y ≤ Real.sqrt d * Q.side := by
  rw [EuclideanSpace.dist_eq]
  have hs := Q.side_pos
  have hcoord : ∀ i, dist (x i) (y i) ^ 2 ≤ Q.side ^ 2 := by
    intro i
    have h1 := hx i
    have h2 := hy i
    rw [Real.dist_eq, sq_abs]
    nlinarith [h1.1, h1.2, h2.1, h2.2]
  calc Real.sqrt (∑ i, dist (x i) (y i) ^ 2) ≤ Real.sqrt (∑ _i : Fin d, Q.side ^ 2) :=
        Real.sqrt_le_sqrt (Finset.sum_le_sum fun i _ => hcoord i)
    _ = Real.sqrt d * Q.side := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          Real.sqrt_mul (Nat.cast_nonneg d), Real.sqrt_sq hs.le]

theorem volume_ball_le (z : Rd d) {r : ℝ} (hr : 0 < r) :
    volume (Metric.ball z r) ≤ ENNReal.ofReal ((2 * r) ^ d) := by
  have hsub : Metric.ball z r ⊆ (WithLp.ofLp) ⁻¹'
      Set.pi univ fun i => Ioo (z i - r) (z i + r) := by
    intro x hx
    simp only [mem_preimage, mem_pi, mem_univ, mem_Ioo, forall_const]
    intro i
    have hx' : dist x z < r := hx
    have h1 : |x i - z i| ≤ dist x z := by rw [← Real.dist_eq]; exact PiLp.dist_apply_le x z i
    rw [abs_le] at h1
    constructor <;> linarith [h1.1, h1.2]
  refine (measure_mono hsub).trans (le_of_eq ?_)
  rw [(PiLp.volume_preserving_ofLp (Fin d)).measure_preimage
    (MeasurableSet.univ_pi fun _ => measurableSet_Ioo).nullMeasurableSet, Real.volume_pi_Ioo]
  simp only [show ∀ i, z i + r - (z i - r) = 2 * r from fun i => by ring, Finset.prod_const,
    Finset.card_univ, Fintype.card_fin]
  rw [ENNReal.ofReal_pow (by positivity)]

variable {𝕜 : Type*} [RCLike 𝕜] {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]

/-- If `𝓜(|f|^p)(z) ≤ τ` and `Q ⊆ B(z, r)` then `⟨f⟩_{Q,p}^p ≤ |B(z,r)|/|Q| · τ`. -/
theorem avgNorm_rpow_le_of_hlMaximal {f : Rd d → B} {p : ℝ} (hp : 0 < p) {z : Rd d} {τ : ℝ≥0∞}
    (hz : hlMaximal volume (fun x => ‖f x‖ₑ ^ p) z ≤ τ) (Q : Cube d) {r : ℝ} (hr : 0 < r)
    (hQ : (Q : Set (Rd d)) ⊆ Metric.ball z r) :
    avgNorm f Q p ^ p ≤ (volume (Q : Set (Rd d)))⁻¹ * (volume (Metric.ball z r) * τ) := by
  rw [avgNorm, ← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one]
  gcongr
  have hB0 : volume (Metric.ball z r) ≠ 0 := (Metric.measure_ball_pos volume z hr).ne'
  have hBtop : volume (Metric.ball z r) ≠ ∞ :=
    (measure_ball_lt_top (μ := volume) (x := z) (r := r)).ne
  have h := (le_hlMaximal volume (fun x => ‖f x‖ₑ ^ p) hr (Metric.mem_ball_self hr)).trans hz
  calc ∫⁻ x in (Q : Set (Rd d)), ‖f x‖ₑ ^ p ≤ ∫⁻ x in Metric.ball z r, ‖f x‖ₑ ^ p :=
        lintegral_mono_set hQ
    _ = volume (Metric.ball z r) * ((volume (Metric.ball z r))⁻¹ *
          ∫⁻ x in Metric.ball z r, ‖f x‖ₑ ^ p) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel hB0 hBtop, one_mul]
    _ ≤ volume (Metric.ball z r) * τ := by gcongr

/-- The constant `C_up = (2(3√d + 12δ))^d` in (upperboundsWhext). -/
noncomputable def upC (d : ℕ) : ℝ := (2 * (3 * Real.sqrt d + 12 * wδ d)) ^ d

theorem upC_pos : 0 < upC d := by
  unfold upC
  have := wδ_pos (d := d)
  positivity

/-- **(upperboundsWhext)**: if `W` is a Whitney cube and `Q ⊇ W` a cube of side `≤ 3ℓ(W)`, then
`⟨f⟩_{Q,p}^p ≤ C_up τ`, where `τ` bounds `𝓜(|f|^p)` off `Ω`. -/
theorem avgNorm_rpow_le_of_whitney {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}
    (hI : IsWhitneyIndex Ω I) {f : Rd d → B} {p : ℝ} (hp : 0 < p) {τ : ℝ≥0∞}
    (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ p) z ≤ τ) {a : ℤ × (Fin d → ℤ)}
    (ha : a ∈ I) (Q : Cube d) (hWQ : (qcube a : Set (Rd d)) ⊆ Q)
    (hside : Q.side ≤ 3 * (2 : ℝ) ^ a.1) :
    avgNorm f Q p ^ p ≤ ENNReal.ofReal (upC d) * τ := by
  obtain ⟨y, hy, z, hz, hyz⟩ := hI.dist_lt a ha
  set r := (3 * Real.sqrt d + 12 * wδ d) * (2 : ℝ) ^ a.1 with hr
  have h2 : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
  have hrpos : 0 < r := by have := wδ_pos (d := d); positivity
  have hQB : (Q : Set (Rd d)) ⊆ Metric.ball z r := by
    intro x hx
    rw [Metric.mem_ball]
    have h1 := Q.dist_le hx (hWQ hy)
    have hsq := Real.sqrt_nonneg (d : ℝ)
    calc dist x z ≤ dist x y + dist y z := dist_triangle _ _ _
      _ < Real.sqrt d * Q.side + 12 * (wδ d * (2 : ℝ) ^ a.1) := by linarith
      _ ≤ Real.sqrt d * (3 * (2 : ℝ) ^ a.1) + 12 * (wδ d * (2 : ℝ) ^ a.1) := by gcongr
      _ = r := by rw [hr]; ring
  have h := avgNorm_rpow_le_of_hlMaximal hp (hτ z hz) Q hrpos hQB
  refine h.trans ?_
  have hvolQ : ENNReal.ofReal (((2 : ℝ) ^ a.1) ^ d) ≤ volume (Q : Set (Rd d)) := by
    rw [← qcube_side a, ← Cube.volume_eq]
    exact measure_mono hWQ
  have hQ0 : volume (Q : Set (Rd d)) ≠ 0 := Q.volume_ne_zero
  have hB : volume (Metric.ball z r) ≤ ENNReal.ofReal (upC d) * volume (Q : Set (Rd d)) := by
    refine (volume_ball_le z hrpos).trans ?_
    calc ENNReal.ofReal ((2 * r) ^ d) = ENNReal.ofReal (upC d) *
          ENNReal.ofReal (((2 : ℝ) ^ a.1) ^ d) := by
          rw [← ENNReal.ofReal_mul upC_pos.le, upC, ← mul_pow, hr]
          congr 2
          ring
      _ ≤ _ := by gcongr
  calc (volume (Q : Set (Rd d)))⁻¹ * (volume (Metric.ball z r) * τ)
      ≤ (volume (Q : Set (Rd d)))⁻¹ * (ENNReal.ofReal (upC d) * volume (Q : Set (Rd d)) * τ) := by
        gcongr
    _ = ENNReal.ofReal (upC d) * τ := by
        rw [mul_comm (ENNReal.ofReal (upC d)), mul_assoc, ← mul_assoc,
          ENNReal.inv_mul_cancel hQ0 Q.volume_ne_top, one_mul]

end UpperBounds

/-! ### §4.4: the Calderón–Zygmund decomposition with a finite Whitney family (ErrorReport E5) -/

section CZ

variable {𝕜 : Type*} [RCLike 𝕜] {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]
  [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜 B] [CompleteSpace B]

/-- `f_W = f 1_W`. -/
noncomputable def czF (f : SimpleCpt d 𝕜 B) (a : ℤ × (Fin d → ℤ)) : SimpleCpt d 𝕜 B :=
  SimpleCpt.restrict f (qcube a).measurableSet

/-- `b_W = (I - 𝔼_{L(W)}) f_W = (f - ⨍_W f) 1_W`. -/
noncomputable def czB (f : SimpleCpt d 𝕜 B) (a : ℤ × (Fin d → ℤ)) : SimpleCpt d 𝕜 B :=
  czF f a - condExp (protoGrid d) a.1 (czF f a)

omit [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜 B] [CompleteSpace B] in
theorem czF_apply (f : SimpleCpt d 𝕜 B) (a : ℤ × (Fin d → ℤ)) :
    ⇑(czF f a) = (qcube a : Set (Rd d)).indicator f :=
  SimpleCpt.restrict_apply _ _

omit [CompleteSpace B] in
theorem condExp_czF_apply (f : SimpleCpt d 𝕜 B) (a : ℤ × (Fin d → ℤ)) (x : Rd d) :
    condExp (protoGrid d) a.1 (czF f a) x =
      (qcube a : Set (Rd d)).indicator (fun _ => ⨍ y in (qcube a : Set (Rd d)), f y) x := by
  rw [condExp_apply, condExpFun, czF_apply]
  by_cases hx : x ∈ (qcube a : Set (Rd d))
  · rw [indicator_of_mem hx, ← (protoGrid d).mem_cube_iff.1 hx]
    exact setAverage_congr_fun (Cube.measurableSet _)
      (Filter.Eventually.of_forall fun y hy => indicator_of_mem hy _)
  · rw [indicator_of_notMem hx]
    have hdisj : ∀ y ∈ ((protoGrid d).cube a.1 ((protoGrid d).idx a.1 x) : Set (Rd d)),
        y ∉ (qcube a : Set (Rd d)) := by
      intro y hy hya
      apply hx
      have := (protoGrid d).eq_of_mem_cube hy hya
      rw [show (qcube a : Set (Rd d)) = (protoGrid d).cube a.1 a.2 from rfl, ← this]
      exact (protoGrid d).mem_cube_idx _ x
    rw [setAverage_congr_fun (Cube.measurableSet _)
      (Filter.Eventually.of_forall fun y hy => indicator_of_notMem (hdisj y hy) _)]
    simp

omit [CompleteSpace B] in
theorem czB_apply (f : SimpleCpt d 𝕜 B) (a : ℤ × (Fin d → ℤ)) (x : Rd d) :
    czB f a x =
      (qcube a : Set (Rd d)).indicator (fun y => f y - ⨍ y in (qcube a : Set (Rd d)), f y) x := by
  change (czF f a) x - (condExp (protoGrid d) a.1 (czF f a)) x = _
  rw [condExp_czF_apply, czF_apply]
  by_cases hx : x ∈ (qcube a : Set (Rd d))
  · simp only [indicator_of_mem hx]
  · simp only [indicator_of_notMem hx, sub_zero]

variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

omit [NormedAddCommGroup B] [NormedSpace 𝕜 B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜 B]
  [CompleteSpace B] in
theorem sum_indicator_eq_of_mem {M : Type*} [AddCommMonoid M] (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (φ : ℤ × (Fin d → ℤ) → Rd d → M)
    {a : ℤ × (Fin d → ℤ)} (ha : a ∈ F)
    {x : Rd d} (hx : x ∈ (qcube a : Set (Rd d))) :
    ∑ b ∈ F, (qcube b : Set (Rd d)).indicator (φ b) x = φ a x := by
  classical
  rw [Finset.sum_eq_single a]
  · exact indicator_of_mem hx _
  · intro b hb hba
    refine indicator_of_notMem (fun hxb => ?_) _
    exact Set.disjoint_left.1 (hI.disjoint a (hFI a ha) b (hFI b hb) (Ne.symm hba)) hx hxb
  · intro h; exact absurd ha h

omit [NormedAddCommGroup B] [NormedSpace 𝕜 B] [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜 B]
  [CompleteSpace B] in
theorem sum_indicator_eq_zero {M : Type*} [AddCommMonoid M] {F : Finset (ℤ × (Fin d → ℤ))}
    (φ : ℤ × (Fin d → ℤ) → Rd d → M)
    {x : Rd d} (hx : ∀ a ∈ F, x ∉ (qcube a : Set (Rd d))) :
    ∑ b ∈ F, (qcube b : Set (Rd d)).indicator (φ b) x = 0 :=
  Finset.sum_eq_zero fun b hb => indicator_of_notMem (hx b hb) _

theorem measurableSet_biUnion_qcube (F : Finset (ℤ × (Fin d → ℤ))) :
    MeasurableSet (⋃ a ∈ F, (qcube a : Set (Rd d))) :=
  Finset.measurableSet_biUnion _ fun _a _ => Cube.measurableSet _

/-- The good part `g = f 1_{Ωᶜ} + ∑_{W ∈ ℱ} (⨍_W f) 1_W`. -/
noncomputable def czGood (hΩ : MeasurableSet Ω) (F : Finset (ℤ × (Fin d → ℤ)))
    (f : SimpleCpt d 𝕜 B) : SimpleCpt d 𝕜 B :=
  SimpleCpt.restrict f hΩ.compl + ∑ a ∈ F, condExp (protoGrid d) a.1 (czF f a)

/-- The bad part `b = ∑_{W ∈ ℱ} b_W`. -/
noncomputable def czBad (F : Finset (ℤ × (Fin d → ℤ))) (f : SimpleCpt d 𝕜 B) :
    SimpleCpt d 𝕜 B :=
  ∑ a ∈ F, czB f a

/-- The remainder `r = f 1_{Ω ∖ ⋃ℱ}`. -/
noncomputable def czRem (hΩ : MeasurableSet Ω) (F : Finset (ℤ × (Fin d → ℤ)))
    (f : SimpleCpt d 𝕜 B) : SimpleCpt d 𝕜 B :=
  SimpleCpt.restrict f (hΩ.diff (measurableSet_biUnion_qcube F))

omit [CompleteSpace B] in
theorem czGood_apply (_hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (_hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) (x : Rd d) :
    czGood hΩ F f x = Ωᶜ.indicator f x + ∑ a ∈ F,
      (qcube a : Set (Rd d)).indicator (fun _ => ⨍ y in (qcube a : Set (Rd d)), f y) x := by
  change (SimpleCpt.restrict f hΩ.compl) x + (∑ a ∈ F, condExp (protoGrid d) a.1 (czF f a)) x = _
  rw [SimpleCpt.restrict_apply, SimpleCpt.coe_sum', Finset.sum_apply]
  simp only [condExp_czF_apply]

omit [CompleteSpace B] in
theorem czBad_apply (f : SimpleCpt d 𝕜 B) (F : Finset (ℤ × (Fin d → ℤ))) (x : Rd d) :
    czBad F f x = ∑ a ∈ F,
      (qcube a : Set (Rd d)).indicator (fun y => f y - ⨍ y in (qcube a : Set (Rd d)), f y) x := by
  change (∑ a ∈ F, czB f a) x = _
  rw [SimpleCpt.coe_sum', Finset.sum_apply]
  simp only [czB_apply]

omit [CompleteSpace B] in
/-- The decomposition `f = g + b + r` (first splitting), with the remainder of ErrorReport E5. -/
theorem cz_decomp (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) :
    f = czGood hΩ F f + czBad F f + czRem hΩ F f := by
  have hsub : ∀ a ∈ I, (qcube a : Set (Rd d)) ⊆ Ω := fun a ha => by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  apply Subtype.ext; apply SimpleFunc.ext; intro x
  change f x = (czGood hΩ F f + czBad F f + czRem hΩ F f) x
  rw [SimpleCpt.coe_add', SimpleCpt.coe_add', Pi.add_apply, Pi.add_apply,
    czGood_apply hI hΩ hFI, czBad_apply, czRem, SimpleCpt.restrict_apply]
  by_cases hxΩ : x ∈ Ω
  · by_cases hxF : ∃ a ∈ F, x ∈ (qcube a : Set (Rd d))
    · obtain ⟨a, ha, hxa⟩ := hxF
      rw [indicator_of_notMem (by simpa using hxΩ), sum_indicator_eq_of_mem hI hFI _ ha hxa,
        sum_indicator_eq_of_mem hI hFI _ ha hxa, indicator_of_notMem
          (fun h => h.2 (mem_iUnion₂.2 ⟨a, ha, hxa⟩))]
      abel
    · push Not at hxF
      have hmem : x ∈ Ω \ ⋃ a ∈ F, (qcube a : Set (Rd d)) := ⟨hxΩ, fun h => by
        obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 h; exact hxF a ha hxa⟩
      rw [indicator_of_notMem (by simpa using hxΩ), sum_indicator_eq_zero _ hxF,
        sum_indicator_eq_zero _ hxF, indicator_of_mem hmem]
      simp
  · have hxF : ∀ a ∈ F, x ∉ (qcube a : Set (Rd d)) := fun a ha h => hxΩ (hsub a (hFI a ha) h)
    rw [indicator_of_mem (show x ∈ Ωᶜ from hxΩ), sum_indicator_eq_zero _ hxF,
      sum_indicator_eq_zero _ hxF, indicator_of_notMem (fun h => hxΩ h.1)]
    simp

end CZ

/-! ### §4.4: bounds for the pieces: (Linfty-g), (ri-g), (Lrbounds-sumsb) -/

section CZBounds

variable {𝕜 : Type*} [RCLike 𝕜] {B : Type*} [NormedAddCommGroup B] [NormedSpace 𝕜 B]
  [NormedSpace ℝ B] [IsScalarTower ℝ 𝕜 B] [CompleteSpace B]
variable {Ω : Set (Rd d)} {I : Set (ℤ × (Fin d → ℤ))}

theorem one_le_upC : 1 ≤ upC d := by
  unfold upC
  apply one_le_pow₀
  have := one_le_wδ (d := d)
  have := Real.sqrt_nonneg (d : ℝ)
  nlinarith

omit [NormedSpace ℝ B] [CompleteSpace B] in
/-- The local bound: for a Whitney cube `W`, `⟨f⟩_{W,r} ≤ (C_up τ)^{1/r}`. -/
theorem avgNorm_le_of_whitney (hI : IsWhitneyIndex Ω I) {f : Rd d → B} {r : ℝ} (hr : 0 < r)
    {τ : ℝ≥0∞} (hτ : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ)
    {a : ℤ × (Fin d → ℤ)} (ha : a ∈ I) (Q : Cube d) (hWQ : (qcube a : Set (Rd d)) ⊆ Q)
    (hside : Q.side ≤ 3 * (2 : ℝ) ^ a.1) :
    avgNorm f Q r ≤ (ENNReal.ofReal (upC d) * τ) ^ (1 / r) := by
  have h := avgNorm_rpow_le_of_whitney hI hr hτ ha Q hWQ hside
  calc avgNorm f Q r = (avgNorm f Q r ^ r) ^ (1 / r) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hr.ne', ENNReal.rpow_one]
    _ ≤ _ := by gcongr

omit [CompleteSpace B] in
/-- **(Linfty-g)**: `|g(x)| ≤ (C_up τ)^{1/r}` everywhere. -/
theorem enorm_czGood_le (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) {r : ℝ}
    (hr : 1 ≤ r) {τ : ℝ≥0∞} (hτmax : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ)
    (hτpt : ∀ z ∉ Ω, ‖f z‖ₑ ^ r ≤ τ) (x : Rd d) :
    ‖czGood hΩ F f x‖ₑ ≤ (ENNReal.ofReal (upC d) * τ) ^ (1 / r) := by
  have hsub : ∀ a ∈ I, (qcube a : Set (Rd d)) ⊆ Ω := fun a ha => by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  rw [czGood_apply hI hΩ hFI]
  by_cases hxΩ : x ∈ Ω
  · rw [indicator_of_notMem (by simpa using hxΩ), zero_add]
    by_cases hxF : ∃ a ∈ F, x ∈ (qcube a : Set (Rd d))
    · obtain ⟨a, ha, hxa⟩ := hxF
      rw [sum_indicator_eq_of_mem hI hFI _ ha hxa]
      have h2 : (0 : ℝ) < (2 : ℝ) ^ a.1 := by positivity
      exact (enorm_setAverage_le_avgNorm (SimpleCpt.aestronglyMeasurable f)
        (Cube.volume_ne_zero _) (Cube.volume_ne_top _) hr).trans
        (avgNorm_le_of_whitney hI (by linarith) hτmax (hFI a ha) (qcube a) subset_rfl
          (by rw [qcube_side]; linarith))
    · push Not at hxF
      rw [sum_indicator_eq_zero _ hxF, enorm_zero]
      exact zero_le
  · have hxF : ∀ a ∈ F, x ∉ (qcube a : Set (Rd d)) := fun a ha h => hxΩ (hsub a (hFI a ha) h)
    rw [indicator_of_mem (show x ∈ Ωᶜ from hxΩ), sum_indicator_eq_zero _ hxF, add_zero]
    have hr0 : r ≠ 0 := by linarith
    calc ‖f x‖ₑ = (‖f x‖ₑ ^ r) ^ (1 / r) := by
          rw [← ENNReal.rpow_mul, mul_one_div_cancel hr0, ENNReal.rpow_one]
      _ ≤ τ ^ (1 / r) := by gcongr; exact hτpt x hxΩ
      _ ≤ _ := by
          gcongr
          calc τ = 1 * τ := (one_mul τ).symm
            _ ≤ _ := by gcongr; rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal one_le_upC

omit [CompleteSpace B] in
/-- The support of the good part: if `f` is supported in `S` and Whitney cubes meeting `S` lie in
`S`, then `g` is supported in `S`. -/
theorem support_czGood_subset (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) {f : SimpleCpt d 𝕜 B}
    {S : Set (Rd d)} (hfS : Function.support ⇑f ⊆ S)
    (hWS : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ S).Nonempty → (qcube a : Set (Rd d)) ⊆ S) :
    Function.support ⇑(czGood hΩ F f) ⊆ S := by
  have hsub : ∀ a ∈ I, (qcube a : Set (Rd d)) ⊆ Ω := fun a ha => by
    rw [← hI.iUnion_eq]; exact subset_biUnion_of_mem (u := fun a => (qcube a : Set (Rd d))) ha
  intro x hx
  rw [Function.mem_support, czGood_apply hI hΩ hFI] at hx
  by_cases hxΩ : x ∈ Ω
  · rw [indicator_of_notMem (by simpa using hxΩ), zero_add] at hx
    by_cases hxF : ∃ a ∈ F, x ∈ (qcube a : Set (Rd d))
    · obtain ⟨a, ha, hxa⟩ := hxF
      rw [sum_indicator_eq_of_mem hI hFI _ ha hxa] at hx
      refine hWS a (hFI a ha) ?_ hxa
      by_contra hne
      apply hx
      rw [setAverage_congr_fun (Cube.measurableSet _) (Filter.Eventually.of_forall fun y hy =>
        show f y = 0 from Function.notMem_support.1 fun h => hne ⟨y, hy, hfS h⟩)]
      simp
    · push Not at hxF
      rw [sum_indicator_eq_zero _ hxF] at hx
      exact absurd rfl hx
  · have hxF : ∀ a ∈ F, x ∉ (qcube a : Set (Rd d)) := fun a ha h => hxΩ (hsub a (hFI a ha) h)
    rw [indicator_of_mem (show x ∈ Ωᶜ from hxΩ), sum_indicator_eq_zero _ hxF, add_zero] at hx
    exact hfS hx

