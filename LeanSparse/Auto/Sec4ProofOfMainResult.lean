  rw [pairing_eq_restrict Q₀.triple.measurableSet hS3 f₂]
  refine (step_core hd hT hp hpq hε hγ0 hγ1 hAp hAq hA₀ hB hKC IH hN hN₂ hn t₀ f₁ hf₁ _
    ?_).trans ?_
  · rw [SimpleCpt.restrict_apply]; exact Set.support_indicator_subset
  · gcongr
