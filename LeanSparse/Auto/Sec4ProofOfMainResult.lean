/-- The sum of the bad pieces is `f 1_U - h`. -/
theorem sum_czB_eq (hI : IsWhitneyIndex Ω I) {F : Finset (ℤ × (Fin d → ℤ))}
    (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) :
