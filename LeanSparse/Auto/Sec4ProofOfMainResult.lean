/-- The averaged part `h = ∑_{W ∈ ℱ'} (⨍_W f) 1_W` satisfies `‖h‖_r ≤ ‖f 1_U‖_r`. -/
theorem eLpNorm_sum_avg_le (hI : IsWhitneyIndex Ω I)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) (f : SimpleCpt d 𝕜 B) {r : ℝ}
    (hr : 1 ≤ r) :
    eLpNorm (∑ a ∈ F, ⇑(condExp (protoGrid d) a.1 (czF f a))) (.ofReal r) volume ≤
      eLpNorm ((⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f) (.ofReal r) volume := by
  have hr0' : 0 < r := by linarith
  have hr0 : ENNReal.ofReal r ≠ 0 := by simpa using hr0'
  have hdisj : (F : Set (ℤ × (Fin d → ℤ))).PairwiseDisjoint fun a => (qcube a : Set (Rd d)) :=
    fun a ha b hb hab => hI.disjoint a (hFI a ha) b (hFI b hb) hab
  have hmeas : AEStronglyMeasurable (∑ a ∈ F, ⇑(condExp (protoGrid d) a.1 (czF f a))) volume :=
    Finset.aestronglyMeasurable_sum F fun a _ => SimpleCpt.aestronglyMeasurable _
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hr0 ENNReal.ofReal_ne_top hmeas,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hr0 ENNReal.ofReal_ne_top
      ((SimpleCpt.aestronglyMeasurable f).indicator (measurableSet_biUnion_qcube F)),
    ENNReal.toReal_ofReal hr0'.le]
  gcongr 1
  have hpt : ∀ x, ‖(∑ a ∈ F, ⇑(condExp (protoGrid d) a.1 (czF f a))) x‖ₑ ^ r =
      ∑ a ∈ F, (qcube a : Set (Rd d)).indicator
        (fun _ => ‖⨍ y in (qcube a : Set (Rd d)), f y‖ₑ ^ r) x := by
    intro x
    simp only [Finset.sum_apply, condExp_czF_apply]
    by_cases hxF : ∃ a ∈ F, x ∈ (qcube a : Set (Rd d))
    · obtain ⟨a, ha, hxa⟩ := hxF
      rw [sum_indicator_eq_of_mem hI hFI _ ha hxa, sum_indicator_eq_of_mem hI hFI
        (fun b (_ : Rd d) => ‖⨍ y in (qcube b : Set (Rd d)), f y‖ₑ ^ r) ha hxa]
    · push Not at hxF
      rw [sum_indicator_eq_zero _ hxF, sum_indicator_eq_zero
        (fun b (_ : Rd d) => ‖⨍ y in (qcube b : Set (Rd d)), f y‖ₑ ^ r) hxF, enorm_zero,
        ENNReal.zero_rpow_of_pos hr0']
  have hind : (fun x => ‖(⋃ a ∈ F, (qcube a : Set (Rd d))).indicator f x‖ₑ ^ r) =
      (⋃ a ∈ F, (qcube a : Set (Rd d))).indicator fun x => ‖f x‖ₑ ^ r := by
    funext x
    by_cases hx : x ∈ ⋃ a ∈ F, (qcube a : Set (Rd d))
    · simp [indicator_of_mem hx]
    · simp [indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hr0']
  rw [lintegral_congr hpt, lintegral_finsetSum _ fun a _ =>
      (measurable_const.indicator (Cube.measurableSet _)), hind,
    lintegral_indicator (measurableSet_biUnion_qcube F),
    lintegral_biUnion_finset hdisj (fun a _ => Cube.measurableSet _)]
  refine Finset.sum_le_sum fun a _ => ?_
  rw [lintegral_indicator (Cube.measurableSet _), setLIntegral_const, mul_comm]
  exact volume_mul_enorm_setAverage_rpow_le (SimpleCpt.aestronglyMeasurable f)
    (Cube.volume_ne_zero _) (Cube.volume_ne_top _) hr

