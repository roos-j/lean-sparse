  · push Not at hxF
    rw [sum_indicator_eq_zero _ hxF, sum_indicator_eq_zero _ hxF, indicator_of_notMem
      (fun h => by obtain ⟨a, ha, hxa⟩ := mem_iUnion₂.1 h; exact hxF a ha hxa), sub_zero]

