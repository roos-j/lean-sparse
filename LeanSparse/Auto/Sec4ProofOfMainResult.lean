/-- **(ri-g)**: `‖g‖_{s,1} ≤ s (C_up τ)^{1/r} |S|^{1/s}` for `g` supported in `S`. -/
theorem lorentzOneNorm_czGood_le (hI : IsWhitneyIndex Ω I) (hΩ : MeasurableSet Ω)
    {F : Finset (ℤ × (Fin d → ℤ))} (hFI : ∀ a ∈ F, a ∈ I) {f : SimpleCpt d 𝕜 B} {r : ℝ}
    (hr : 1 ≤ r) {τ : ℝ≥0∞} (hτtop : τ ≠ ∞)
    (hτmax : ∀ z ∉ Ω, hlMaximal volume (fun x => ‖f x‖ₑ ^ r) z ≤ τ)
    (hτpt : ∀ z ∉ Ω, ‖f z‖ₑ ^ r ≤ τ) {S : Set (Rd d)} (hfS : Function.support ⇑f ⊆ S)
    (hWS : ∀ a ∈ I, ((qcube a : Set (Rd d)) ∩ S).Nonempty → (qcube a : Set (Rd d)) ⊆ S)
    {s : ℝ} (hs : 0 < s) :
    lorentzOneNorm (czGood hΩ F f) s ≤
      ENNReal.ofReal s * ((ENNReal.ofReal (upC d) * τ) ^ (1 / r) * volume S ^ (1 / s)) := by
  set Mg := (ENNReal.ofReal (upC d) * τ) ^ (1 / r) with hMg
  have hMgtop : Mg ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (by positivity) (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hτtop)
  have hbound : ∀ x, ‖czGood hΩ F f x‖ ≤ S.indicator (fun _ => Mg.toReal) x := by
    intro x
    by_cases hxS : x ∈ S
    · rw [indicator_of_mem hxS, ← ENNReal.ofReal_le_iff_le_toReal hMgtop, ofReal_norm]
      exact enorm_czGood_le hI hΩ hFI f hr hτmax hτpt x
    · have : czGood hΩ F f x = 0 := Function.notMem_support.1 fun h =>
        hxS (support_czGood_subset hI hΩ hFI hfS hWS h)
      rw [indicator_of_notMem hxS, this, norm_zero]
  have h := lorentzOneNorm_le_of_le_indicator hbound hs
  rwa [ENNReal.ofReal_toReal hMgtop] at h

