section IVP

/-- **Intermediate values of Lebesgue measure** (used for the Carleson–sparse equivalence,
Lerner–Nazarov Lemma 6.3): for `d > 0`, every measurable `A ⊆ ℝ^d` contains measurable subsets
`A ∩ B(0, r)` of every measure `t ≤ |A|`. -/
theorem volume_ivp (hd : 0 < d) (A : Set (Rd d)) (hA : MeasurableSet A) (t : ℝ≥0∞)
    (ht : t ≤ volume A) : ∃ B ⊆ A, MeasurableSet B ∧ volume B = t := by
  rcases eq_or_lt_of_le ht with rfl | ht'
  · exact ⟨A, subset_rfl, hA, rfl⟩
  have httop : t ≠ ∞ := ht'.ne_top
  have : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  set f : ℝ → ℝ≥0∞ := fun r => volume (A ∩ Metric.ball (0 : Rd d) r) with hf
  set C := volume (Metric.ball (0 : Rd d) 1) with hC
  have hCtop : C ≠ ∞ := measure_ball_lt_top.ne
  have hball : ∀ r : ℝ, 0 ≤ r →
      volume (Metric.ball (0 : Rd d) r) = ENNReal.ofReal (r ^ d) * C := fun r hr => by
    rw [Measure.addHaar_ball volume (0 : Rd d) hr, finrank_euclideanSpace_fin]
  -- some radius `R` with `t < f R`
  have hU : A = ⋃ n : ℕ, A ∩ Metric.ball (0 : Rd d) n := by
    ext x
    simp only [mem_iUnion, mem_inter_iff, Metric.mem_ball, dist_zero_right]
    constructor
    · intro hx
      obtain ⟨n, hn⟩ := exists_nat_gt ‖x‖
      exact ⟨n, hx, hn⟩
    · rintro ⟨n, hx, _⟩; exact hx
  have hmono : Monotone fun n : ℕ => A ∩ Metric.ball (0 : Rd d) n := fun m n hmn =>
    inter_subset_inter_right _ (Metric.ball_subset_ball (by exact_mod_cast hmn))
  have hsup : volume A = ⨆ n : ℕ, f n := by
    conv_lhs => rw [hU]
    rw [measure_iUnion_eq_iSup_accumulate]
    congr 1; funext n
    congr 1
    refine subset_antisymm ?_ ?_
    · rw [accumulate_def]; exact iUnion₂_subset fun k hk => hmono hk
    · exact fun x hx => mem_accumulate.2 ⟨n, le_rfl, hx⟩
  obtain ⟨n, hn⟩ := lt_iSup_iff.1 (hsup ▸ ht')
  set R : ℝ := ((n : ℕ) : ℝ) with hR
  set g : ℝ → ℝ := fun r => (f r).toReal with hg
  have hfin : ∀ r, f r ≠ ∞ := fun r =>
    ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono inter_subset_right)
  have hdiff : ∀ r r' : ℝ, 0 ≤ r → r ≤ r' → g r' - g r ≤ (r' ^ d - r ^ d) * C.toReal := by
    intro r r' hr hrr'
    have h1 : f r' ≤ f r + volume (Metric.ball (0 : Rd d) r' \ Metric.ball 0 r) := by
      refine le_trans (measure_mono fun x hx => ?_) (measure_union_le _ _)
      by_cases hxr : x ∈ Metric.ball (0 : Rd d) r
      · exact Or.inl ⟨hx.1, hxr⟩
      · exact Or.inr ⟨hx.2, hxr⟩
    have hpow : r ^ d ≤ r' ^ d := pow_le_pow_left₀ hr hrr' d
    have h2 : volume (Metric.ball (0 : Rd d) r' \ Metric.ball 0 r) =
        ENNReal.ofReal (r' ^ d - r ^ d) * C := by
      rw [measure_sdiff (Metric.ball_subset_ball hrr')
        Metric.isOpen_ball.measurableSet.nullMeasurableSet measure_ball_lt_top.ne,
        hball r' (hr.trans hrr'), hball r hr,
        ← ENNReal.sub_mul (fun _ _ => hCtop), ← ENNReal.ofReal_sub _ (by positivity)]
    have h2top : volume (Metric.ball (0 : Rd d) r' \ Metric.ball 0 r) ≠ ∞ := by
      rw [h2]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hCtop
    have h3 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hfin r, h2top⟩) h1
    rw [ENNReal.toReal_add (hfin r) h2top, h2, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (sub_nonneg.2 hpow)] at h3
    simp only [hg]
    linarith
  have hgmono : ∀ r r' : ℝ, r ≤ r' → g r ≤ g r' := fun r r' h =>
    ENNReal.toReal_mono (hfin r')
      (measure_mono (inter_subset_inter_right _ (Metric.ball_subset_ball h)))
  have hcont : ContinuousOn g (Icc 0 R) := by
    intro b hb
    have hh : ContinuousAt (fun r : ℝ => r ^ d * C.toReal) b := by fun_prop
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    obtain ⟨δ, hδ, hδ'⟩ := Metric.continuousAt_iff.1 hh ε hε
    refine ⟨δ, hδ, fun {a} ha hab => ?_⟩
    have h := hδ' hab
    rw [Real.dist_eq] at h ⊢
    rcases le_total a b with hle | hle
    · have h1 := hdiff a b ha.1 hle
      have h2 := hgmono a b hle
      have h3 := neg_le_abs (a ^ d * C.toReal - b ^ d * C.toReal)
      rw [abs_sub_comm, abs_of_nonneg (by linarith)]
      linarith
    · have h1 := hdiff b a hb.1 hle
      have h2 := hgmono b a hle
      have h3 := le_abs_self (a ^ d * C.toReal - b ^ d * C.toReal)
      rw [abs_of_nonneg (by linarith)]
      linarith
  have hg0 : g 0 = 0 := by simp [hg, hf]
  have htR : t.toReal ∈ Icc (g 0) (g R) :=
    ⟨by rw [hg0]; exact ENNReal.toReal_nonneg, ENNReal.toReal_mono (hfin R) hn.le⟩
  obtain ⟨r, _, hgr⟩ := intermediate_value_Icc (by positivity : (0 : ℝ) ≤ R) hcont htR
  refine ⟨A ∩ Metric.ball (0 : Rd d) r, inter_subset_left,
    hA.inter Metric.isOpen_ball.measurableSet, ?_⟩
  exact (ENNReal.toReal_eq_toReal_iff' (hfin r) httop).1 hgr

end IVP

section Lattices

/-- For `d > 0`, a cube is determined by its underlying set. -/
theorem Cube.toSet_injective (hd : 0 < d) : Function.Injective (Cube.toSet : Cube d → _) := by
  intro Q R h
  have hmem : ∀ x, x ∈ (Q : Set (Rd d)) ↔ x ∈ (R : Set (Rd d)) := fun x => by
    rw [show (Q : Set (Rd d)) = Q.toSet from rfl, h]
  have hc : Q.corner = R.corner := funext fun i =>
    le_antisymm (by simpa using ((hmem _).2 R.corner_mem i).1)
      (by simpa using ((hmem _).1 Q.corner_mem i).1)
  have key : ∀ Q R : Cube d, Q.corner = R.corner →
      (∀ x, x ∈ (R : Set (Rd d)) → x ∈ (Q : Set (Rd d))) → R.side ≤ Q.side := by
    intro Q R hc hsub
    by_contra hlt
    push Not at hlt
    have hy : WithLp.toLp 2 (fun i => R.corner i + Q.side) ∈ (R : Set (Rd d)) := fun i => by
      exact ⟨by simp; linarith [Q.side_pos], by simp; linarith⟩
    have := (hsub _ hy ⟨0, hd⟩).2
    simp only [hc] at this
    simp at this
  exact Cube.ext' hc (le_antisymm (key R Q hc.symm fun x hx => (hmem x).1 hx)
    (key Q R hc fun x hx => (hmem x).2 hx))

theorem Cube.triple_injective : Function.Injective (Cube.triple : Cube d → Cube d) := by
  intro Q R h
  have hs : Q.side = R.side := by
    have := congrArg Cube.side h
    simp only [Cube.triple_side] at this
    linarith
  refine Cube.ext' (funext fun i => ?_) hs
  have := congrFun (congrArg Cube.corner h) i
  simp only [Cube.triple] at this
  linarith

namespace GridData

variable (G : GridData d)

theorem offset_int (L : ℤ) (l : ℕ) (i : Fin d) :
    ∃ z : ℤ, (2 : ℝ) ^ l * G.o L i - G.o (L - l) i = z := by
  induction l with
  | zero => exact ⟨0, by simp⟩
  | succ l ih =>
    obtain ⟨z, hz⟩ := ih
    refine ⟨2 * z + G.k (L - l) i, ?_⟩
    have h := G.nest (L - l) i
    have hL : L - ((l + 1 : ℕ) : ℤ) = L - l - 1 := by push_cast; ring
    rw [hL, pow_succ]
    push_cast
    linear_combination 2 * hz + h

/-- Dyadic subcubes of lattice cubes are lattice cubes. -/
theorem eq_cube_of_isDyadicSubcubeAt {L : ℤ} {t : Fin d → ℤ} {R : Cube d} {l : ℕ}
    (h : (G.cube L t).IsDyadicSubcubeAt R l) : ∃ t', R = G.cube (L - l) t' := by
  obtain ⟨hs, v, -, hc⟩ := h
  choose z hz using fun i => G.offset_int L l i
  have hside : G.side (L - l) = G.side L / 2 ^ l := by
    simp only [side, zpow_sub₀ (two_ne_zero' ℝ), zpow_natCast]
    ring
  refine ⟨fun i => 2 ^ l * t i + z i + v i, Cube.ext' (funext fun i => ?_) ?_⟩
  · rw [hc i, hs]
    simp only [cube, hside]
    have h2 : (2 : ℝ) ^ l ≠ 0 := by positivity
    push_cast
    rw [show (z i : ℝ) = 2 ^ l * G.o L i - G.o (L - l) i from (hz i).symm]
    field_simp
    ring
  · rw [hs, cube_side, cube_side, hside]

theorem eq_cube_of_isDyadicSubcube {L : ℤ} {t : Fin d → ℤ} {R : Cube d}
    (h : (G.cube L t).IsDyadicSubcube R) : ∃ L' t', R = G.cube L' t' := by
  obtain ⟨l, hl⟩ := h
  obtain ⟨t', ht'⟩ := G.eq_cube_of_isDyadicSubcubeAt hl
  exact ⟨_, t', ht'⟩

/-- Lattice cubes are nested or disjoint. -/
theorem subset_or_disjoint (L L' : ℤ) (t t' : Fin d → ℤ) :
    (G.cube L t : Set (Rd d)) ⊆ G.cube L' t' ∨ (G.cube L' t' : Set (Rd d)) ⊆ G.cube L t ∨
      Disjoint (G.cube L t : Set (Rd d)) (G.cube L' t') := by
  by_cases hne : ((G.cube L t : Set (Rd d)) ∩ G.cube L' t').Nonempty
  · rcases le_total L L' with h | h
    · exact Or.inl (G.isDyadicSubcube_of_inter h hne).subset
    · rw [inter_comm] at hne
      exact Or.inr (Or.inl (G.isDyadicSubcube_of_inter h hne).subset)
  · exact Or.inr (Or.inr (Set.disjoint_iff_inter_eq_empty.2 (Set.not_nonempty_iff_eq_empty.1 hne)))

end GridData

/-- The sign `(-1)^L` as an integer. -/
def sgnZ (L : ℤ) : ℤ := if Even L then 1 else -1

theorem sgnZ_cases (L : ℤ) : sgnZ L = 1 ∨ sgnZ L = -1 := by
  unfold sgnZ; split_ifs <;> simp

theorem neg_one_zpow_eq_sgnZ (L : ℤ) : (-1 : ℝ) ^ L = sgnZ L := by
  unfold sgnZ
  rcases Int.even_or_odd L with he | ho
  · rw [he.neg_one_zpow]; simp [he]
  · rw [ho.neg_one_zpow]; simp [Int.not_even_iff_odd.2 ho]

theorem sgnZ_sub_one (L : ℤ) : sgnZ (L - 1) = -sgnZ L := by
  unfold sgnZ
  rcases Int.even_or_odd L with he | ho
  · have : ¬ Even (L - 1) := Int.not_even_iff_odd.2 (he.sub_odd odd_one)
    simp [he, this]
  · have : Even (L - 1) := ho.sub_odd odd_one
    simp [Int.not_even_iff_odd.2 ho, this]

theorem fract_div_nine (z : ℤ) (hz : z % 3 ≠ 0) :
    1 / 9 ≤ Int.fract ((z : ℝ) / 9) ∧ Int.fract ((z : ℝ) / 9) ≤ 1 - 1 / 9 := by
  have h0 := Int.emod_nonneg z (by norm_num : (9 : ℤ) ≠ 0)
  have h9 := Int.emod_lt_of_pos z (by norm_num : (0 : ℤ) < 9)
  have hb : Int.fract ((z : ℝ) / 9) = ((z % 9 : ℤ) : ℝ) / 9 := by
    rw [Int.fract_eq_iff]
    refine ⟨by positivity, by
      rw [div_lt_one (by norm_num)]; exact_mod_cast h9, z / 9, ?_⟩
    have : z = z % 9 + 9 * (z / 9) := by omega
    have h' : (z : ℝ) = ((z % 9 : ℤ) : ℝ) + 9 * ((z / 9 : ℤ) : ℝ) := by exact_mod_cast this
    rw [h']
    ring
  have h1 : 1 ≤ z % 9 := by omega
  have h2 : z % 9 ≤ 8 := by omega
  rw [hb]
  have h1' : (1 : ℝ) ≤ ((z % 9 : ℤ) : ℝ) := by exact_mod_cast h1
  have h2' : ((z % 9 : ℤ) : ℝ) ≤ 8 := by exact_mod_cast h2
  constructor <;> linarith

/-- **The triple lattices** `𝒟^{(ν)}` (Three Lattice Theorem, Lerner–Nazarov Thm 3.1, for the
prototype lattice): cubes of side `3 · 2^L` with corners `3 · 2^L (m + (-1)^L (3(ν + L) + 1)/9)`,
`m ∈ ℤ^d`, for `ν ∈ ℤ^d` (only `ν ∈ {0,1,2}^d` is needed). -/
noncomputable def tripleGrid (ν : Fin d → ℤ) : GridData d where
  s := 3
  s_pos := by norm_num
  o L i := (sgnZ L : ℝ) * (3 * ((ν i : ℝ) + L) + 1) / 9
  k L i := sgnZ L * (ν i + L)
  nest L i := by
    rw [sgnZ_sub_one]
    push_cast
    ring
  η := 1 / 9
  η_pos := by norm_num
  margin L i := by
    have h := fract_div_nine (-(sgnZ L * (3 * (ν i + L) + 1))) (by
      rcases sgnZ_cases L with h | h <;> rw [h] <;> omega)
    convert h using 3 <;> push_cast <;> ring

/-- The class `ν` of the triple of a level `L` cube `t` of the prototype lattice. -/
def tripleCls (L : ℤ) (t : Fin d → ℤ) : Fin d → ℤ := fun i => (sgnZ L * (t i - 1) - L) % 3

/-- The index of the triple of a level `L` cube `t` of the prototype lattice in its lattice. -/
def tripleIdx (L : ℤ) (t : Fin d → ℤ) : Fin d → ℤ :=
  fun i => (t i - 1 - sgnZ L * (tripleCls L t i + L)) / 3

theorem tripleCls_mem (L : ℤ) (t : Fin d → ℤ) :
    tripleCls L t ∈ Fintype.piFinset (fun _ : Fin d => Finset.Ico (0 : ℤ) 3) := by
  rw [Fintype.mem_piFinset]
  intro i
  simp only [tripleCls, Finset.mem_Ico]
  omega

/-- **Three Lattice Theorem** for the prototype lattice: `3Q ∈ 𝒟^{(ν)}` for the class `ν` of `Q`. -/
theorem triple_protoGrid_cube (L : ℤ) (t : Fin d → ℤ) :
    ((protoGrid d).cube L t).triple = (tripleGrid (tripleCls L t)).cube L (tripleIdx L t) := by
  have hdiv : ∀ i, 3 * tripleIdx L t i = t i - 1 - sgnZ L * (tripleCls L t i + L) := by
    intro i
    simp only [tripleIdx, tripleCls]
    rcases sgnZ_cases L with h | h <;> rw [h] <;> omega
  refine Cube.ext' (funext fun i => ?_) ?_
  · have h := hdiv i
    have h' : (3 : ℝ) * (tripleIdx L t i : ℝ) =
        (t i : ℝ) - 1 - (sgnZ L : ℝ) * ((tripleCls L t i : ℝ) + L) := by exact_mod_cast h
    simp only [Cube.triple, GridData.cube, GridData.side, protoGrid, tripleGrid,
      neg_one_zpow_eq_sgnZ]
    linear_combination (-(2 : ℝ) ^ L) * h'
  · simp [Cube.triple_side, GridData.cube, GridData.side, protoGrid, tripleGrid]

end Lattices

section Boosting

theorem volume_mul_avgNorm_eq {B : Type*} [NormedAddCommGroup B] (f : Rd d → B)
    {S : Set (Rd d)} (h0 : volume S ≠ 0) (htop : volume S ≠ ∞) {p : ℝ} (hp : 0 < p) :
    volume S * avgNorm f S p =
      volume S ^ (1 - 1 / p) * (∫⁻ x in S, ‖f x‖ₑ ^ p) ^ (1 / p) := by
  unfold avgNorm
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ENNReal.inv_rpow, ← mul_assoc]
  congr 1
  rw [ENNReal.rpow_sub _ _ h0 htop, ENNReal.rpow_one]
  exact (div_eq_mul_inv _ _).symm

/-- `|Q| ⟨f⟩_{Q,p} ≤ |3Q| ⟨f⟩_{3Q,p}` (and similarly for any `S ⊆ S'`), for `p ≥ 1`. -/
theorem volume_mul_avgNorm_le {B : Type*} [NormedAddCommGroup B] (f : Rd d → B)
    {S S' : Set (Rd d)} (hSS' : S ⊆ S') (h0 : volume S ≠ 0) (htop : volume S' ≠ ∞) {p : ℝ}
    (hp : 1 ≤ p) : volume S * avgNorm f S p ≤ volume S' * avgNorm f S' p := by
  have hp0 : 0 < p := by linarith
  have hle := measure_mono (μ := volume) hSS'
  have h0' : volume S' ≠ 0 := (pos_iff_ne_zero.1 ((pos_iff_ne_zero.2 h0).trans_le hle))
  rw [volume_mul_avgNorm_eq f h0 (ne_top_of_le_ne_top htop hle) hp0,
    volume_mul_avgNorm_eq f h0' htop hp0]
  have hexp : 0 ≤ 1 - 1 / p := sub_nonneg.2 ((div_le_one hp0).2 hp)
  gcongr

theorem IsSparse.subset {γ : ℝ} {𝔖 𝔗 : Set (Cube d)} (h : IsSparse γ 𝔖) (h' : 𝔗 ⊆ 𝔖) :
    IsSparse γ 𝔗 :=
  let ⟨E, hE, hd⟩ := h
  ⟨E, fun Q hQ => hE Q (h' hQ), hd.subset h'⟩

open Classical in
/-- The triples of a `γ`-sparse family form a `3^{-d}γ`-sparse family. -/
theorem isSparse_image_triple {γ : ℝ} (_hγ : 0 ≤ γ) (𝔖 : Finset (Cube d))
    (h : IsSparse γ (𝔖 : Set (Cube d))) :
    IsSparse ((3 : ℝ)⁻¹ ^ d * γ) ((𝔖.image Cube.triple : Finset (Cube d)) : Set (Cube d)) := by
  classical
  have : Nonempty (Cube d) := ⟨⟨0, 1, one_pos⟩⟩
  obtain ⟨E, hE, hdisj⟩ := h
  have hinv : ∀ Q ∈ 𝔖, Function.invFunOn Cube.triple (𝔖 : Set (Cube d)) Q.triple = Q :=
    fun Q hQ => Cube.triple_injective (Function.invFunOn_eq ⟨Q, hQ, rfl⟩)
  refine ⟨fun R => E (Function.invFunOn Cube.triple (𝔖 : Set (Cube d)) R), ?_, ?_⟩
  · intro R hR
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hR)
    simp only [hinv Q hQ]
    obtain ⟨h1, h2, h3⟩ := hE Q hQ
    refine ⟨h1, h2.trans Q.subset_triple, le_trans (le_of_eq ?_) h3⟩
    rw [Cube.volume_triple, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num),
      ENNReal.ofReal_inv_of_pos (by norm_num), ENNReal.ofReal_ofNat]
    calc (3 : ℝ≥0∞)⁻¹ ^ d * ENNReal.ofReal γ * (3 ^ d * volume (Q : Set (Rd d))) =
        ENNReal.ofReal γ * volume (Q : Set (Rd d)) * ((3 : ℝ≥0∞)⁻¹ ^ d * 3 ^ d) := by ring
      _ = _ := by
        rw [← mul_pow, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_pow, mul_one]
  · intro R hR R' hR' hne
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hR)
    obtain ⟨Q', hQ', rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hR')
    simp only [Function.onFun, hinv Q hQ, hinv Q' hQ']
    exact hdisj hQ hQ' fun h => hne (congrArg Cube.triple h)

/-- The number of subfamilies in the sparse boosting (Lerner–Nazarov Lemma 6.6). -/
noncomputable def nBoost (η γ : ℝ) : ℕ := ⌈1 / (η * (1 - γ))⌉₊ + 1

theorem nBoost_pos (η γ : ℝ) : 0 < nBoost η γ := by unfold nBoost; omega

theorem boost_le {η γ : ℝ} (hη0 : 0 < η) (hη1 : η ≤ 1) (hγ0 : 0 < γ) (hγ1 : γ < 1) :
    ENNReal.ofReal γ ≤ (1 + ((ENNReal.ofReal η)⁻¹ - 1) / (nBoost η γ : ℝ≥0∞))⁻¹ := by
  set Mb := nBoost η γ with hMb
  have hM : (1 : ℝ) / (η * (1 - γ)) ≤ Mb := by
    have := Nat.le_ceil (1 / (η * (1 - γ)))
    rw [hMb, nBoost]; push_cast; linarith
  have hMpos : (0 : ℝ) < Mb := by exact_mod_cast nBoost_pos η γ
  have h1 : 1 ≤ η⁻¹ := (one_le_inv₀ hη0).2 hη1
  have hx0 : 0 ≤ (η⁻¹ - 1) / Mb := div_nonneg (sub_nonneg.2 h1) hMpos.le
  rw [← ENNReal.ofReal_inv_of_pos hη0, ← ENNReal.ofReal_one, ← ENNReal.ofReal_sub _ zero_le_one,
    ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_div_of_pos hMpos,
    ← ENNReal.ofReal_add zero_le_one hx0, ← ENNReal.ofReal_inv_of_pos (by positivity)]
  apply ENNReal.ofReal_le_ofReal
  rw [← one_div, le_div_iff₀ (by positivity)]
  have hγ' : 0 < 1 - γ := by linarith
  rw [div_le_iff₀ (by positivity)] at hM
  have hx : (η⁻¹ - 1) / Mb ≤ 1 - γ := by
    rw [div_le_iff₀ hMpos]
    have hinv : η⁻¹ * η = 1 := inv_mul_cancel₀ hη0.ne'
    have := mul_le_mul_of_nonneg_left hM (inv_nonneg.2 hη0.le)
    nlinarith
  nlinarith

open Classical in
/-- **Sparse boosting** (Lerner–Nazarov Lemmas 6.3, 6.6): an `η`-sparse finite family of cubes of a
grid lattice splits by depth modulo `nBoost η γ` into `γ`-sparse subfamilies. -/
theorem isSparse_filter_depth (hd : 0 < d) (G : GridData d) {η γ : ℝ} (hη0 : 0 < η)
    (hη1 : η ≤ 1) (hγ0 : 0 < γ) (hγ1 : γ < 1) (𝔗 : Finset (Cube d))
    (h𝔗 : ∀ Q ∈ 𝔗, Q ∈ G.lattice) (hsp : IsSparse η (𝔗 : Set (Cube d))) (i : ℕ) :
    IsSparse γ ((𝔗.filter (fun Q => depth (𝔗.image Cube.toSet) (Q : Set (Rd d)) %
      nBoost η γ = i) : Finset (Cube d)) : Set (Cube d)) := by
  classical
  have : Nonempty (Cube d) := ⟨⟨0, 1, one_pos⟩⟩
  set 𝒮 := 𝔗.image Cube.toSet with h𝒮
  have hinj := Cube.toSet_injective (d := d) hd
  obtain ⟨E, hE, hEd⟩ := hsp
  have hinv : ∀ Q ∈ 𝔗, Function.invFunOn Cube.toSet (𝔗 : Set (Cube d)) Q.toSet = Q :=
    fun Q hQ => hinj (Function.invFunOn_eq ⟨Q, hQ, rfl⟩)
  have hS : IsSparseFamily volume (ENNReal.ofReal η) 𝒮 := by
    refine ⟨fun S => E (Function.invFunOn Cube.toSet (𝔗 : Set (Cube d)) S), ?_, ?_⟩
    · intro S hS
      obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 hS
      simp only [hinv Q hQ]
      obtain ⟨h1, h2, h3⟩ := hE Q hQ
      exact ⟨h2, h1, h3⟩
    · intro S hS S' hS' hne
      obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hS)
      obtain ⟨Q', hQ', rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hS')
      simp only [Function.onFun, hinv Q hQ, hinv Q' hQ']
      exact hEd hQ hQ' fun h => hne (congrArg Cube.toSet h)
  have hlam : IsLaminar 𝒮 := by
    intro S hS S' hS'
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 hS
    obtain ⟨Q', hQ', rfl⟩ := Finset.mem_image.1 hS'
    obtain ⟨L, t, rfl⟩ := h𝔗 Q hQ
    obtain ⟨L', t', rfl⟩ := h𝔗 Q' hQ'
    exact G.subset_or_disjoint L L' t t'
  have hb := hS.filter_depth_mod (by simpa using hη0) (ENNReal.ofReal_le_one.2 hη1) hlam
    (fun S hS => by obtain ⟨Q, -, rfl⟩ := Finset.mem_image.1 hS; exact Q.nonempty)
    (fun S hS => by obtain ⟨Q, -, rfl⟩ := Finset.mem_image.1 hS; exact Q.measurableSet)
    (fun S hS => by obtain ⟨Q, -, rfl⟩ := Finset.mem_image.1 hS; exact Q.volume_ne_top)
    (volume_ivp hd) (nBoost_pos η γ) i
  obtain ⟨E', hE', hE'd⟩ := hb.mono (boost_le hη0 hη1 hγ0 hγ1)
  have hmem : ∀ Q : Cube d,
      Q ∈ 𝔗.filter (fun Q : Cube d => depth 𝒮 Q.toSet % nBoost η γ = i) →
      Q.toSet ∈ 𝒮.filter (fun S => depth 𝒮 S % nBoost η γ = i) := fun Q hQ => by
    obtain ⟨hQ1, hQ2⟩ := Finset.mem_filter.1 hQ
    exact Finset.mem_filter.2 ⟨Finset.mem_image_of_mem Cube.toSet hQ1, hQ2⟩
  refine ⟨fun Q => E' (Q : Set (Rd d)), fun Q hQ => ?_, fun Q hQ Q' hQ' hne => ?_⟩
  · obtain ⟨h1, h2, h3⟩ := hE' _ (hmem Q (Finset.mem_coe.1 hQ))
    exact ⟨h2, h1, h3⟩
  · exact hE'd (hmem Q (Finset.mem_coe.1 hQ)) (hmem Q' (Finset.mem_coe.1 hQ'))
      fun h => hne (hinj h)

/-- **(triple-cubes)** and the conclusion of §4.2:
`𝔊_{Q₀}(f₁, f₂) ≤ 3^d M Λ*_γ(f₁, f₂)` with `M = nBoost (3^{-d}γ) γ`. -/
theorem frakG_le_maxSparseForm (hd : 0 < d) {γ : ℝ} (hγ0 : 0 < γ) (hγ1 : γ < 1) {p r : ℝ}
    (hp : 1 ≤ p) {B B' : Type*} [NormedAddCommGroup B] [NormedAddCommGroup B'] (M : ℤ)
    (t₀ : Fin d → ℤ) (f₁ : Rd d → B) (f₂ : Rd d → B') :
    frakG γ p r ((protoGrid d).cube M t₀) f₁ f₂ ≤
      ((3 ^ d * nBoost ((3 : ℝ)⁻¹ ^ d * γ) γ : ℕ) : ℝ≥0∞) * maxSparseForm γ p r f₁ f₂ := by
  classical
  set η := (3 : ℝ)⁻¹ ^ d * γ with hη
  set Mb := nBoost η γ with hMb
  have hη0 : 0 < η := by positivity
  have hη1 : η ≤ 1 := by
    have h1 : (3 : ℝ)⁻¹ ^ d ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    have h2 : 0 ≤ (3 : ℝ)⁻¹ ^ d := by positivity
    rw [hη]; nlinarith
  set Λ := maxSparseForm γ p r f₁ f₂ with hΛdef
  set w : Cube d → ℝ≥0∞ := fun R => volume (R : Set (Rd d)) * avgNorm f₁ R p * avgNorm f₂ R r
    with hw
  have hΛ : ∀ ν : Fin d → ℤ, ∀ 𝔘 : Finset (Cube d), (∀ R ∈ 𝔘, R ∈ (tripleGrid ν).lattice) →
      IsSparse γ (𝔘 : Set (Cube d)) → ∑ R ∈ 𝔘, w R ≤ Λ := by
    intro ν 𝔘 hU hsp
    refine le_trans (le_of_eq ?_) (le_iSup_of_le (tripleGrid ν).lattice
      (le_iSup_of_le (tripleGrid ν).isDyadicLattice (le_iSup_of_le (𝔘 : Set (Cube d))
        (le_iSup_of_le (fun R hR => hU R hR) (le_iSup_of_le hsp le_rfl)))))
    unfold sparseForm
    exact (Finset.tsum_subtype 𝔘 w).symm
  refine iSup_le fun 𝔖 => iSup_le fun h𝔖 => iSup_le fun hsp => ?_
  have hQ : ∀ Q ∈ 𝔖, ∃ L t, Q = (protoGrid d).cube L t := fun Q hQ =>
    (protoGrid d).eq_cube_of_isDyadicSubcube (h𝔖 Q hQ)
  choose! Lf tf hLt using hQ
  set cls : Cube d → (Fin d → ℤ) := fun Q => tripleCls (Lf Q) (tf Q) with hcls
  set N := Fintype.piFinset (fun _ : Fin d => Finset.Ico (0 : ℤ) 3) with hN
  have hcard : N.card = 3 ^ d := by simp [hN]
  have h1 : ∑ Q ∈ 𝔖, volume (Q : Set (Rd d)) * avgNorm f₁ Q p * avgNorm f₂ Q.triple r ≤
      ∑ Q ∈ 𝔖, w Q.triple := Finset.sum_le_sum fun Q _ =>
    mul_le_mul_left (volume_mul_avgNorm_le f₁ Q.subset_triple Q.volume_ne_zero
      Q.triple.volume_ne_top hp) _
  have h2 : ∑ Q ∈ 𝔖, w Q.triple = ∑ ν ∈ N, ∑ Q ∈ 𝔖.filter (fun Q => cls Q = ν), w Q.triple :=
    (Finset.sum_fiberwise_of_maps_to (fun Q _ => tripleCls_mem _ _) _).symm
  have h3 : ∀ ν ∈ N, ∑ Q ∈ 𝔖.filter (fun Q => cls Q = ν), w Q.triple ≤ Mb * Λ := by
    intro ν _
    set 𝔗 := (𝔖.filter (fun Q => cls Q = ν)).image Cube.triple with h𝔗
    have hT : ∀ R ∈ 𝔗, R ∈ (tripleGrid ν).lattice := by
      intro R hR
      obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 hR
      obtain ⟨hQ𝔖, hcl⟩ := Finset.mem_filter.1 hQ
      have hcl' : tripleCls (Lf Q) (tf Q) = ν := hcl
      rw [hLt Q hQ𝔖, triple_protoGrid_cube, hcl']
      exact ⟨_, _, rfl⟩
    have hTsp : IsSparse η (𝔗 : Set (Cube d)) :=
      isSparse_image_triple hγ0.le _ (hsp.subset fun Q hQ => (Finset.mem_filter.1 hQ).1)
    rw [← Finset.sum_image (fun Q _ Q' _ h => Cube.triple_injective h)]
    have hsplit := Finset.sum_fiberwise_of_maps_to (s := 𝔗) (t := Finset.range Mb)
      (g := fun R : Cube d => depth (𝔗.image Cube.toSet) R.toSet % Mb)
      (fun R _ => Finset.mem_range.2 (Nat.mod_lt _ (nBoost_pos η γ))) w
    rw [← hsplit]
    calc _ ≤ ∑ _i ∈ Finset.range Mb, Λ := Finset.sum_le_sum fun i _ =>
          hΛ ν _ (fun R hR => hT R (Finset.mem_filter.1 hR).1)
            (isSparse_filter_depth hd (tripleGrid ν) hη0 hη1 hγ0 hγ1 𝔗 hT hTsp i)
      _ = Mb * Λ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  calc _ ≤ ∑ Q ∈ 𝔖, w Q.triple := h1
    _ = _ := h2
    _ ≤ ∑ _ν ∈ N, (Mb : ℝ≥0∞) * Λ := Finset.sum_le_sum h3
    _ = _ := by
      rw [Finset.sum_const, hcard, nsmul_eq_mul]
      push_cast
      ring

end Boosting

section MainTheorem

theorem Kstep_pos {p q ε γ : ℝ} (hp : 1 < p) (hq : 0 < q) (hε : 0 < ε) (hγ1 : γ < 1) :
    0 < Kstep d p q ε γ := by
  have hc₁ : 0 < cOne d γ p := Real.rpow_pos_of_pos (mul_pos upC_pos (omegaConst_pos hγ1)) _
  have hc₂ : 0 < cOne d γ q.conjExponent :=
    Real.rpow_pos_of_pos (mul_pos upC_pos (omegaConst_pos hγ1)) _
  have hp1 : 0 < p / (p - 1) := div_pos (by linarith) (by linarith)
  have hIV := cIV_nonneg (d := d) hε
  have hδ := wδ_pos (d := d)
  have hl := Real.log_pos (by norm_num : (1 : ℝ) < 2)
  unfold Kstep
  positivity

theorem constC_nonneg {Ap Aq A₀ B : ℝ} (hAp : 0 ≤ Ap) (hAq : 0 ≤ Aq) (hA₀ : 0 ≤ A₀)
    (hB : 0 ≤ B) : 0 ≤ constC Ap Aq A₀ B := by
  unfold constC
  have : 0 ≤ Real.log (2 + B / A₀) :=
    Real.log_nonneg (by have := div_nonneg hB hA₀; linarith)
  positivity

/-- **Theorem 1.1** (BRS, (mainthm)): for `d ≥ 1`, `1 < p ≤ q < ∞`, `ε > 0` and `0 < γ < 1`,
`|⟨∑_{j=N₁}^{N₂} T_j f₁, f₂⟩| ≤ K 𝒞 Λ*_{γ,p,q'}(f₁, f₂)` with `𝒞 = A(p) + A(q) + A∘ log(2 + B/A∘)`
and `K` depending only on `d, p, q, ε, γ`. -/
theorem mainthm (hd : 0 < d) {p q ε γ : ℝ} (hp : 1 < p) (hpq : p ≤ q) (hε : 0 < ε)
    (hγ0 : 0 < γ) (hγ1 : γ < 1) : MainTheoremStatement d p q ε γ := by
  have hq : 1 < q := lt_of_lt_of_le hp hpq
  set Kb : ℕ := 3 ^ d * nBoost ((3 : ℝ)⁻¹ ^ d * γ) γ with hKb
  have hKb : (0 : ℝ) < Kb := by
    have := nBoost_pos ((3 : ℝ)⁻¹ ^ d * γ) γ
    rw [hKb]; positivity
  refine ⟨Kstep d p q ε γ * Kb, mul_pos (Kstep_pos hp (by linarith) hε hγ1) hKb, ?_⟩
  intro 𝕜 _ B₁ _ _ _ B₂ _ _ _ T Ap Aq A₀ B hAp hAq hA₀ hB hT N₁ N₂ hN f₁ f₂
  let : NormedSpace ℝ B₁ := NormedSpace.restrictScalars ℝ 𝕜 B₁
  have : IsScalarTower ℝ 𝕜 B₁ := ⟨fun r c x => by
    change (r • c) • x = (algebraMap ℝ 𝕜 r) • (c • x)
    rw [Algebra.smul_def, mul_smul]⟩
  have hC := constC_nonneg hAp hAq hA₀ hB
  rw [ofReal_norm]
  change ‖pairing (psumOn T (Finset.Icc N₁ N₂) f₁) f₂‖ₑ ≤ _
  rcases eq_or_lt_of_le hA₀ with h0 | hA₀pos
  · -- `A∘ = 0`: all `T_j` vanish
    have hS : eLpNorm (psumOn T (Finset.Icc N₁ N₂) f₁) (.ofReal q) volume = 0 := by
      refine le_antisymm ((eLpNorm_psumOn_le hT (by linarith) hq.le _ f₁).trans ?_) zero_le
      simp [psumConst, ← h0]
    calc _ ≤ eLpNorm (psumOn T (Finset.Icc N₁ N₂) f₁) (.ofReal q) volume *
          eLpNorm f₂ (.ofReal q.conjExponent) volume :=
          enorm_pairing_le (psumOn_aestronglyMeasurable hT _ f₁)
            (SimpleCpt.aestronglyMeasurable f₂) hq
      _ = 0 := by rw [hS, zero_mul]
      _ ≤ _ := zero_le
  · -- a cube `Q₀` of the prototype lattice of side `2^M`, `M ≥ N₂`, containing `supp f₁`
    have hK : IsCompact (tsupport ⇑f₁) := f₁.2
    obtain ⟨L₀, hL₀⟩ := (protoGrid d).exists_cube_superset_of_isCompact hK
    set M := max L₀ N₂ with hM
    have hsupp : Function.support ⇑f₁ ⊆
        ((protoGrid d).cube M ((protoGrid d).idx M 0) : Set (Rd d)) :=
      (subset_tsupport _).trans (hL₀ M (le_max_left _ _))
    have h := claim_4_3 hd hT hp hpq hε hγ0 hγ1 hAp hAq hA₀pos hB le_rfl (M - N₁).toNat N₁ N₂ M
      hN (le_max_right _ _) le_rfl _ f₁ hsupp f₂
    refine h.trans ?_
    calc ENNReal.ofReal (Kstep d p q ε γ * constC Ap Aq A₀ B) *
          frakG γ p q.conjExponent ((protoGrid d).cube M ((protoGrid d).idx M 0)) f₁ f₂
        ≤ ENNReal.ofReal (Kstep d p q ε γ * constC Ap Aq A₀ B) *
          ((Kb : ℝ≥0∞) * maxSparseForm γ p q.conjExponent f₁ f₂) := by
          gcongr
          exact frakG_le_maxSparseForm hd hγ0 hγ1 hp.le M _ _ _
      _ = _ := by
        rw [show Kstep d p q ε γ * (Kb : ℝ) * constC Ap Aq A₀ B =
            Kstep d p q ε γ * constC Ap Aq A₀ B * Kb by ring,
          ENNReal.ofReal_mul (mul_nonneg (Kstep_pos hp (by linarith) hε hγ1).le hC),
          ENNReal.ofReal_natCast]
        ring

end MainTheorem

